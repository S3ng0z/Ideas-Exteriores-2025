{{ 'ie-warranty-delivery-page.css' | asset_url | stylesheet_tag }}

<section class="ie-wdp ie-wdp--hero" aria-labelledby="ie-wdp-title-{{ section.id }}">
  <div class="ie-wdp__inner">
    {% render 'ie-breadcrumb',
      breadcrumb_object: page,
      current_title: page.title,
      class_name: 'ie-wdp__breadcrumb',
      fallback_1_label: 'Servicios',
      fallback_1_link: '/pages/services'
    %}

    <div class="ie-wdp__hero-grid">
      <div class="ie-wdp__hero-copy">
        {% if section.settings.eyebrow != blank %}
          <p class="ie-wdp__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h1 id="ie-wdp-title-{{ section.id }}">{{ section.settings.heading }}</h1>
        {% if section.settings.lead != blank %}
          <div class="ie-wdp__lead rte">{{ section.settings.lead }}</div>
        {% endif %}

        <div class="ie-wdp__actions">
          {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}
            <a class="ie-wdp__button ie-wdp__button--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
          {% endif %}
          {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
            <a class="ie-wdp__button ie-wdp__button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
          {% endif %}
        </div>
      </div>

      <aside class="ie-wdp__hero-summary" aria-label="{{ section.settings.summary_title | escape }}">
        {% if section.settings.summary_title != blank %}
          <p class="ie-wdp__summary-title">{{ section.settings.summary_title }}</p>
        {% endif %}
        <ul class="ie-wdp__summary-list" role="list">
          {% for block in section.blocks %}
            <li {{ block.shopify_attributes }}>
              <span>{{ block.settings.number }}</span>
              <div>
                <strong>{{ block.settings.heading }}</strong>
                {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
              </div>
            </li>
          {% endfor %}
        </ul>
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Garantía · Hero",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"Servicio y garantías"},
    {"type":"text","id":"heading","label":"Título","default":"Garantía, entrega y pagos con condiciones claras desde el presupuesto"},
    {"type":"richtext","id":"lead","label":"Introducción","default":"<p>Centralizamos las condiciones que conviene conocer antes de contratar: cobertura y mantenimiento, alcance logístico, protocolo de recepción y calendario de pagos. Las condiciones concretas dependen del producto, la configuración y los servicios incluidos, y deben quedar reflejadas en la documentación comercial o contractual de cada proyecto.</p>"},
    {"type":"text","id":"primary_label","label":"CTA principal","default":"Consultar condiciones de mi proyecto"},
    {"type":"url","id":"primary_link","label":"Enlace CTA principal"},
    {"type":"text","id":"secondary_label","label":"CTA secundario","default":"Ver logística de entrega"},
    {"type":"url","id":"secondary_link","label":"Enlace CTA secundario"},
    {"type":"text","id":"summary_title","label":"Título resumen","default":"Antes de confirmar"}
  ],
  "blocks":[
    {
      "type":"summary",
      "name":"Punto clave",
      "settings":[
        {"type":"text","id":"number","label":"Número","default":"01"},
        {"type":"text","id":"heading","label":"Título","default":"Garantía documentada"},
        {"type":"textarea","id":"text","label":"Texto","default":"Cobertura, condiciones y exclusiones vinculadas al producto y al alcance contratado."}
      ]
    }
  ],
  "max_blocks":4,
  "presets":[{"name":"Garantía · Hero"}]
}
{% endschema %}