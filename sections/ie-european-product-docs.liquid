{% comment %}
  IE · Sistema Europeo · documentación descargable.
  IE-SE-01 ficha del modelo: custom.eu_datasheet (file_reference) en cada producto.
  IE-SE-02 memoria de calidades e IE-SE-03 guía de compra: comunes, URL en ajustes (Contenido › Archivos).
  Solo se muestra un documento si tiene archivo publicado.
{% endcomment %}
{% liquid
  assign sheet = product.metafields.custom.eu_datasheet.value
  assign sheet_url = sheet.url
  assign doc_count = 0
  if sheet_url != blank
    assign doc_count = doc_count | plus: 1
  endif
  if section.settings.quality_url != blank
    assign doc_count = doc_count | plus: 1
  endif
  if section.settings.guide_url != blank
    assign doc_count = doc_count | plus: 1
  endif
%}
{% if doc_count > 0 %}
{{ 'ie-eu-model.css' | asset_url | stylesheet_tag }}
<section class="ie-eu ie-eu__section" id="documentacion" aria-labelledby="ie-eu-docs-{{ section.id }}">
  <div class="ie-eu__wrap">
    <header class="ie-eu__head">
      <div>
        <p class="ie-eu__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 id="ie-eu-docs-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.intro != blank %}<p class="ie-eu__lead">{{ section.settings.intro }}</p>{% endif %}
    </header>
    {%- capture eu_dl_icon -%}<svg class="ie-eu__icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v10M6 9l4 4 4-4M4 16h12"/></svg>{%- endcapture -%}
    <div class="ie-eu-docs">
      {% if sheet_url != blank %}
        <a class="ie-eu-doc" href="{{ sheet_url }}" target="_blank" rel="noopener" data-doc-code="IE-SE-01">
          <span class="ie-eu-doc__code">IE-SE-01 · PDF</span>
          <strong>Ficha técnico-comercial · {{ product.title | escape }}</strong>
          <span class="ie-eu-doc__text">{{ section.settings.sheet_text }}</span>
          <span class="ie-eu-doc__action">{{ eu_dl_icon }}Descargar ficha</span>
        </a>
      {% endif %}
      {% if section.settings.quality_url != blank %}
        <a class="ie-eu-doc" href="{{ section.settings.quality_url }}" target="_blank" rel="noopener" data-doc-code="IE-SE-02">
          <span class="ie-eu-doc__code">IE-SE-02 · PDF</span>
          <strong>Memoria de calidades · Sistema Europeo</strong>
          <span class="ie-eu-doc__text">{{ section.settings.quality_text }}</span>
          <span class="ie-eu-doc__action">{{ eu_dl_icon }}Descargar memoria</span>
        </a>
      {% endif %}
      {% if section.settings.guide_url != blank %}
        <a class="ie-eu-doc" href="{{ section.settings.guide_url }}" target="_blank" rel="noopener" data-doc-code="IE-SE-03">
          <span class="ie-eu-doc__code">IE-SE-03 · PDF</span>
          <strong>Guía de compra, suministro e instalación</strong>
          <span class="ie-eu-doc__text">{{ section.settings.guide_text }}</span>
          <span class="ie-eu-doc__action">{{ eu_dl_icon }}Descargar guía</span>
        </a>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Europeo · documentos",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Documentación" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Documentación para decidir con información" },
    { "type": "textarea", "id": "intro", "label": "Introducción", "default": "Consulta la ficha de este modelo y los documentos comunes del Sistema Europeo. Te ayudarán a conocer sus características, comprobar el alcance del suministro y preparar tu solicitud de presupuesto." },
    { "type": "textarea", "id": "sheet_text", "label": "IE-SE-01 · descripción", "default": "Medidas, distribución, composición y datos propios del modelo." },
    { "type": "url", "id": "quality_url", "label": "IE-SE-02 · URL del PDF" },
    { "type": "textarea", "id": "quality_text", "label": "IE-SE-02 · descripción", "default": "Materiales, componentes y criterios comunes del sistema." },
    { "type": "url", "id": "guide_url", "label": "IE-SE-03 · URL del PDF" },
    { "type": "textarea", "id": "guide_text", "label": "IE-SE-03 · descripción", "default": "Alcance, opciones, preparación, entrega, montaje y responsabilidades." }
  ],
  "presets": [{ "name": "Europeo · documentos" }]
}
{% endschema %}
