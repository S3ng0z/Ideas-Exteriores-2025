<section id="ie-sip-packages" class="ie-sip-pdp ie-sip-pdp--packages" aria-labelledby="ie-sip-packages-title-{{ section.id }}">
  <div class="ie-sip-pdp__inner">
    <div class="ie-sip-pdp__section-head">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="ie-sip-pdp__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 id="ie-sip-packages-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.intro != blank %}
        <div class="ie-sip-pdp__section-intro rte">{{ section.settings.intro }}</div>
      {% endif %}
    </div>

    <div class="ie-sip-pdp__tier-grid">
      {% for block in section.blocks %}
        {% liquid
          assign tier_price = blank
          case block.settings.price_source
            when 'basic'
              assign tier_price = product.metafields.custom.price_basic.value
            when 'standard'
              assign tier_price = product.metafields.custom.price_standard.value
            when 'passive'
              assign tier_price = product.metafields.custom.price_passive.value
          endcase
        %}
        <article class="ie-sip-pdp__tier-card ie-sip-pdp__tier-card--{{ block.settings.tone }}" {{ block.shopify_attributes }}>
          <p class="ie-sip-pdp__tier-label">{{ block.settings.label }}</p>
          {% if tier_price != blank %}
            <p class="ie-sip-pdp__tier-price">{{ tier_price | money }}</p>
          {% endif %}
          {% if block.settings.tax_note != blank %}
            <p class="ie-sip-pdp__tier-tax">{{ block.settings.tax_note }}</p>
          {% endif %}
          {% if block.settings.summary != blank %}
            <p class="ie-sip-pdp__tier-summary">{{ block.settings.summary }}</p>
          {% endif %}
          <a href="#ie-sip-tier-{{ block.id }}">{{ section.settings.details_label }} <span aria-hidden="true">↓</span></a>
        </article>
      {% endfor %}
    </div>

    {% if section.settings.note != blank %}
      <div class="ie-sip-pdp__technical-note rte">{{ section.settings.note }}</div>
    {% endif %}

    <div class="ie-sip-pdp__tier-details">
      {% for block in section.blocks %}
        {% liquid
          assign tier_price = blank
          case block.settings.price_source
            when 'basic'
              assign tier_price = product.metafields.custom.price_basic.value
            when 'standard'
              assign tier_price = product.metafields.custom.price_standard.value
            when 'passive'
              assign tier_price = product.metafields.custom.price_passive.value
          endcase
        %}
        <details id="ie-sip-tier-{{ block.id }}" class="ie-sip-pdp__disclosure" {% if forloop.first %}open{% endif %}>
          <summary>
            <span>
              <strong>{{ block.settings.label }}</strong>
              {% if block.settings.summary != blank %}
                <small>{{ block.settings.summary }}</small>
              {% endif %}
            </span>
            <span class="ie-sip-pdp__disclosure-price">
              {% if tier_price != blank %}{{ tier_price | money }}{% endif %}
              <span aria-hidden="true">+</span>
            </span>
          </summary>
          <div class="ie-sip-pdp__disclosure-body rte">
            {{ block.settings.details }}
          </div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "IE · Casa SIP · Paquetes",
  "enabled_on": {"templates": ["product"]},
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Configuraciones"},
    {"type": "text", "id": "heading", "label": "Título", "default": "Compara precio y alcance antes de decidir"},
    {"type": "richtext", "id": "intro", "label": "Introducción", "default": "<p>Los tres niveles no representan solo un precio distinto: cambian el alcance del suministro, la envolvente, el montaje y los trabajos que deben coordinarse fuera del paquete.</p>"},
    {"type": "text", "id": "details_label", "label": "Texto enlace detalle", "default": "Ver alcance completo"},
    {"type": "richtext", "id": "note", "label": "Nota técnica", "default": "<p><strong>Importante:</strong> el nombre de una configuración no equivale por sí solo a una certificación energética o Passivhaus. Las prestaciones y la justificación normativa dependen de la composición validada, el emplazamiento y el proyecto.</p>"}
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Configuración",
      "settings": [
        {"type": "text", "id": "label", "label": "Nombre", "default": "BASIC"},
        {"type": "select", "id": "price_source", "label": "Precio", "options": [
          {"value": "basic", "label": "Precio BASIC"},
          {"value": "standard", "label": "Precio STANDARD"},
          {"value": "passive", "label": "Precio PASSIVE"}
        ], "default": "basic"},
        {"type": "select", "id": "tone", "label": "Tono", "options": [
          {"value": "light", "label": "Claro"},
          {"value": "mid", "label": "Medio"},
          {"value": "deep", "label": "Profundo"}
        ], "default": "light"},
        {"type": "text", "id": "tax_note", "label": "Nota de precio", "default": "IVA incluido · precio de referencia"},
        {"type": "textarea", "id": "summary", "label": "Resumen", "default": "Revisa incluidos, excluidos y trabajos que requieren validación antes de presupuestar."},
        {"type": "richtext", "id": "details", "label": "Detalle completo"}
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{"name": "IE · Casa SIP · Paquetes"}]
}
{% endschema %}
