{% liquid
  assign ie_technical_status = product.metafields.custom.technical_status.value | default: ''
  assign ie_packages_on_hold = false
  if ie_technical_status == 'review_required' or ie_technical_status == 'draft' or ie_technical_status == 'withdrawn'
    assign ie_packages_on_hold = true
  endif
%}

<section id="ie-sip-packages" class="ie-sip-pdp ie-sip-pdp--packages" aria-labelledby="ie-sip-packages-title-{{ section.id }}">
  <div class="ie-sip-pdp__inner">
    <div class="ie-sip-pdp__section-head">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="ie-sip-pdp__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 id="ie-sip-packages-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>

      {% if ie_packages_on_hold %}
        <div class="ie-sip-pdp__technical-note rte" role="status">
          <p><strong>Datos técnicos y comerciales en revisión.</strong> Los importes publicados son referencias, no presupuestos cerrados. Para comparar BASIC, STANDARD y PASSIVE es necesario verificar la composición técnica, las superficies, los trabajos incluidos, el transporte y el montaje de este modelo.</p>
          <p><a href="{{ pages['contact-ideas-exteriores'].url | default: '/pages/contact-ideas-exteriores' }}">Solicitar estudio de este modelo</a></p>
        </div>
      {% endif %}
      {% if section.settings.intro != blank %}
        <div class="ie-sip-pdp__section-intro rte">{{ section.settings.intro }}</div>
      {% endif %}
    </div>

    {% if section.settings.note != blank %}
        <div class="ie-sip-pdp__technical-note rte">{{ section.settings.note }}</div>
      {% endif %}
      <div class="ie-sip-pdp__package-columns">
      {% for block in section.blocks %}
        {% liquid
          assign tier_price = blank
          case block.settings.price_source
            when 'basic'
              assign tier_price = product.metafields.custom.price_basic.value
            when 'standard'
              assign tier_price = product.metafields.custom.price_standard.value
            when 'passive'
              assign tier_price = product.metafields.custom.price_passive.value
          endcase
        %}

        <article class="ie-sip-pdp__package-card ie-sip-pdp__package-card--{{ block.settings.tone }}" {{ block.shopify_attributes }}>
          <header class="ie-sip-pdp__package-head">
            <p class="ie-sip-pdp__package-label">{{ block.settings.label }}</p>

            {% if tier_price != blank %}
              <p class="ie-sip-pdp__package-price">{{ tier_price | money }}</p>
            {% endif %}

            {% if block.settings.tax_note != blank %}
              <p class="ie-sip-pdp__package-tax">{% if ie_packages_on_hold %}Precio orientativo · IVA y alcance por confirmar{% else %}{{ block.settings.tax_note }}{% endif %}</p>
            {% endif %}

            {% if block.settings.summary != blank %}
              <p class="ie-sip-pdp__package-summary">{{ block.settings.summary }}</p>
            {% endif %}
          </header>

          {% if ie_packages_on_hold %}
            <p class="ie-sip-pdp__package-review">La composición, los componentes suministrados, el montaje y las prestaciones de esta configuración están pendientes de validación documental y presupuesto desglosado.</p>
          {% elsif block.settings.details != blank %}
            <section class="ie-sip-pdp__package-description" aria-label="Descripción completa de {{ block.settings.label | escape }}">
              <h3 class="ie-sip-pdp__package-description-title">Descripción completa de {{ block.settings.label }}</h3>
              <div class="ie-sip-pdp__package-body rte">
                {{ block.settings.details }}
              </div>
            </section>
          {% endif %}
        </article>
      {% endfor %}
      </div>
  </div>
</section>

{% schema %}
{
  "name": "IE · Casa SIP · Paquetes",
  "enabled_on": {"templates": ["product"]},
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Configuraciones"},
    {"type": "text", "id": "heading", "label": "Título", "default": "Compara precio y alcance antes de decidir"},
    {"type": "richtext", "id": "intro", "label": "Introducción", "default": "<p>Los tres niveles no representan solo un precio distinto: cambian el alcance del suministro, la envolvente, el montaje y los trabajos que deben coordinarse fuera del paquete.</p>"},
    {"type": "richtext", "id": "note", "label": "Nota técnica", "default": "<p><strong>Importante:</strong> el nombre de una configuración no equivale por sí solo a una certificación energética o Passivhaus. Las prestaciones y la justificación normativa dependen de la composición validada, el emplazamiento y el proyecto.</p>"}
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Configuración",
      "settings": [
        {"type": "text", "id": "label", "label": "Nombre", "default": "BASIC"},
        {"type": "select", "id": "price_source", "label": "Precio", "options": [
          {"value": "basic", "label": "Precio BASIC"},
          {"value": "standard", "label": "Precio STANDARD"},
          {"value": "passive", "label": "Precio PASSIVE"}
        ], "default": "basic"},
        {"type": "select", "id": "tone", "label": "Tono", "options": [
          {"value": "light", "label": "Claro"},
          {"value": "mid", "label": "Medio"},
          {"value": "deep", "label": "Profundo"}
        ], "default": "light"},
        {"type": "text", "id": "tax_note", "label": "Nota de precio", "default": "IVA incluido · precio de referencia"},
        {"type": "textarea", "id": "summary", "label": "Resumen", "default": "Revisa incluidos, excluidos y trabajos que requieren validación antes de presupuestar."},
        {"type": "richtext", "id": "details", "label": "Descripción completa"}
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{"name": "IE · Casa SIP · Paquetes"}]
}
{% endschema %}
