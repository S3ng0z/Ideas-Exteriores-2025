<section class="ie-project ie-project--process" aria-labelledby="ie-project-process-title-{{ section.id }}"><div class="ie-project__inner"><div class="ie-project__process">
  <div>{% if section.settings.eyebrow != blank %}<p class="ie-project__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}<h2 id="ie-project-process-title-{{ section.id }}">{{ section.settings.heading }}</h2>{% if section.settings.intro != blank %}<div class="ie-project__process-intro rte">{{ section.settings.intro }}</div>{% endif %}</div>
  <ol class="ie-project__process-list">{% for block in section.blocks %}<li class="ie-project__process-step" {{ block.shopify_attributes }}><span class="ie-project__process-number">{{ block.settings.number }}</span><div><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></div></li>{% endfor %}</ol>
</div></div></section>
{% schema %}
{"name":"Proyectos y licencias · Proceso","settings":[{"type":"text","id":"eyebrow","label":"Antetítulo","default":"Proceso por fases"},{"type":"text","id":"heading","label":"Título","default":"Cinco pasos, con entregables y decisiones claras"},{"type":"richtext","id":"intro","label":"Introducción","default":"<p>Podemos incorporarnos desde el inicio o desde una fase avanzada si ya dispones de diseño o proyecto. El objetivo es que cada paso deje preparado el siguiente y reduzca retrabajos.</p>"}],"blocks":[{"type":"step","name":"Paso","settings":[{"type":"text","id":"number","label":"Número","default":"01"},{"type":"text","id":"heading","label":"Título","default":"Viabilidad"},{"type":"textarea","id":"text","label":"Texto","default":"Revisión urbanística y encaje del uso, con un resumen de condicionantes."}]}],"max_blocks":6,"presets":[{"name":"Proyectos y licencias · Proceso"}]}
{% endschema %}