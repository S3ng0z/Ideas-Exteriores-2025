{{ 'ie-wood-3d-page.css' | asset_url | stylesheet_tag }}

<section class="ie-wood3d ie-wood3d--hero" aria-labelledby="ie-wood3d-title-{{ section.id }}">
  <div class="ie-wood3d__inner">
    {% render 'ie-breadcrumb',
      breadcrumb_object: page,
      current_title: page.title,
      class_name: 'ie-wood3d__breadcrumb',
      fallback_1_label: 'Servicios',
      fallback_1_link: '/pages/services'
    %}

    <div class="ie-wood3d__hero-grid">
      <div class="ie-wood3d__hero-copy">
        {% if section.settings.eyebrow != blank %}
          <p class="ie-wood3d__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h1 id="ie-wood3d-title-{{ section.id }}">{{ section.settings.heading }}</h1>
        {% if section.settings.lead != blank %}
          <div class="ie-wood3d__lead rte">{{ section.settings.lead }}</div>
        {% endif %}

        <div class="ie-wood3d__actions">
          {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}
            <a class="ie-wood3d__button ie-wood3d__button--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
          {% endif %}
          {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
            <a class="ie-wood3d__button ie-wood3d__button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
          {% endif %}
        </div>
      </div>

      <aside class="ie-wood3d__hero-summary" aria-label="{{ section.settings.summary_title | escape }}">
        {% if section.settings.summary_title != blank %}
          <p class="ie-wood3d__summary-title">{{ section.settings.summary_title }}</p>
        {% endif %}
        <ul class="ie-wood3d__summary-list" role="list">
          {% for block in section.blocks %}
            <li {{ block.shopify_attributes }}>
              <span>{{ block.settings.number }}</span>
              <div>
                <strong>{{ block.settings.heading }}</strong>
                {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
              </div>
            </li>
          {% endfor %}
        </ul>
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Diseño 3D · Hero",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"Diseño 3D y asesoría técnica"},
    {"type":"text","id":"heading","label":"Título","default":"Define tu proyecto en madera antes de fabricar"},
    {"type":"richtext","id":"lead","label":"Introducción","default":"<p>Convertimos una necesidad, unas medidas o una idea inicial en una propuesta visual y técnica que permite decidir con más claridad antes de presupuestar, fabricar o iniciar trámites. El objetivo no es decorar un render: es ordenar el proyecto y reducir decisiones abiertas.</p>"},
    {"type":"text","id":"primary_label","label":"CTA principal","default":"Solicitar orientación técnica"},
    {"type":"url","id":"primary_link","label":"Enlace CTA principal"},
    {"type":"text","id":"secondary_label","label":"CTA secundario","default":"Ver cómo trabajamos"},
    {"type":"url","id":"secondary_link","label":"Enlace CTA secundario"},
    {"type":"text","id":"summary_title","label":"Título resumen","default":"Qué obtienes"}
  ],
  "blocks":[
    {
      "type":"outcome",
      "name":"Resultado",
      "settings":[
        {"type":"text","id":"number","label":"Número","default":"01"},
        {"type":"text","id":"heading","label":"Título","default":"Una solución definida"},
        {"type":"textarea","id":"text","label":"Texto","default":"Uso, dimensiones y condicionantes principales ordenados antes de avanzar."}
      ]
    }
  ],
  "max_blocks":4,
  "presets":[{"name":"Diseño 3D · Hero"}]
}
{% endschema %}
