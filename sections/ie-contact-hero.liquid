{{ 'ie-contact-page.css' | asset_url | stylesheet_tag }}

<section class="ie-contact ie-contact--hero" aria-labelledby="ie-contact-title-{{ section.id }}">
  <div class="ie-contact__inner">
    <nav class="ie-contact__breadcrumb" aria-label="Migas de pan">
      <a href="{{ routes.root_url }}">Inicio</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ page.title }}</span>
    </nav>

    <div class="ie-contact__hero">
      <div class="ie-contact__hero-copy">
        {% if section.settings.eyebrow != blank %}
          <p class="ie-contact__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        <h1 id="ie-contact-title-{{ section.id }}">{{ section.settings.heading }}</h1>

        {% if section.settings.lead != blank %}
          <div class="ie-contact__lead rte">{{ section.settings.lead }}</div>
        {% endif %}

        <div class="ie-contact__actions">
          {% if section.settings.primary_label != blank %}
            <a class="ie-contact__button ie-contact__button--primary" href="{{ section.settings.primary_link | default: '#contact-form' }}">
              {{ section.settings.primary_label }}
            </a>
          {% endif %}

          {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
            <a class="ie-contact__button ie-contact__button--secondary" href="{{ section.settings.secondary_link }}">
              {{ section.settings.secondary_label }}
            </a>
          {% endif %}
        </div>
      </div>

      {% if section.blocks.size > 0 %}
        <aside class="ie-contact__hero-summary" aria-label="{{ section.settings.summary_title | escape }}">
          {% if section.settings.summary_title != blank %}
            <p class="ie-contact__summary-title">{{ section.settings.summary_title }}</p>
          {% endif %}

          <ol class="ie-contact__summary-list">
            {% for block in section.blocks %}
              <li {{ block.shopify_attributes }}>
                <span>{{ block.settings.number }}</span>
                <strong>{{ block.settings.label }}</strong>
              </li>
            {% endfor %}
          </ol>
        </aside>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contacto · Hero",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"Contacto y presupuesto"},
    {"type":"text","id":"heading","label":"Título","default":"Cuéntanos qué necesitas y partimos del punto correcto"},
    {"type":"richtext","id":"lead","label":"Introducción","default":"<p>Si ya tienes un modelo o servicio elegido, indícalo en tu consulta. Si todavía estás comparando opciones, cuéntanos el uso, la ubicación y el estado del proyecto para poder orientarte con criterio.</p>"},
    {"type":"text","id":"primary_label","label":"CTA principal","default":"Iniciar consulta"},
    {"type":"url","id":"primary_link","label":"Enlace CTA principal"},
    {"type":"text","id":"secondary_label","label":"CTA secundario","default":"Ver servicios"},
    {"type":"url","id":"secondary_link","label":"Enlace CTA secundario"},
    {"type":"text","id":"summary_title","label":"Título resumen","default":"Para orientarte mejor"}
  ],
  "blocks": [
    {
      "type":"summary",
      "name":"Paso resumen",
      "settings":[
        {"type":"text","id":"number","label":"Número","default":"01"},
        {"type":"text","id":"label","label":"Texto","default":"Selecciona el motivo de contacto"}
      ]
    }
  ],
  "max_blocks": 4,
  "presets":[{"name":"Contacto · Hero"}]
}
{% endschema %}
