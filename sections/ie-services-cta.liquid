<section class="ie-services ie-services--cta" aria-labelledby="ie-services-cta-title-{{ section.id }}">
  <div class="ie-services__inner">
    <div class="ie-services__closing">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="ie-services__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 id="ie-services-cta-title-{{ section.id }}">{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}
          <div class="rte">{{ section.settings.text }}</div>
        {% endif %}
      </div>

      {% if section.settings.label != blank and section.settings.link != blank %}
        <a class="ie-services__button ie-services__button--primary" href="{{ section.settings.link }}">
          {{ section.settings.label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Servicios · CTA",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"Siguiente paso"},
    {"type":"text","id":"heading","label":"Título","default":"Cuéntanos en qué fase está tu proyecto"},
    {"type":"richtext","id":"text","label":"Texto","default":"<p>Si ya tienes medidas, planos, una parcela o simplemente una necesidad concreta, dinos desde dónde partes. Te orientaremos hacia el servicio y el siguiente paso más adecuados.</p>"},
    {"type":"text","id":"label","label":"CTA","default":"Hablar con el equipo"},
    {"type":"url","id":"link","label":"Enlace CTA"}
  ],
  "presets":[{"name":"Servicios · CTA"}]
}
{% endschema %}
