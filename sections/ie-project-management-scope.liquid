<section class="ie-project ie-project--scope" aria-labelledby="ie-project-scope-title-{{ section.id }}">
  <div class="ie-project__inner">
    <div class="ie-project__section-head">
      <div>{% if section.settings.eyebrow != blank %}<p class="ie-project__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}<h2 id="ie-project-scope-title-{{ section.id }}">{{ section.settings.heading }}</h2></div>
      {% if section.settings.intro != blank %}<div class="ie-project__section-intro rte">{{ section.settings.intro }}</div>{% endif %}
    </div>
    <div class="ie-project__cards">{% for block in section.blocks %}
      <article class="ie-project__card" {{ block.shopify_attributes }}><div class="ie-project__card-body"><p class="ie-project__card-index">{{ block.settings.index }}</p><h3>{{ block.settings.heading }}</h3><div class="ie-project__card-text rte">{{ block.settings.text }}</div>{% if block.settings.link_label != blank and block.settings.link != blank %}<a class="ie-project__card-link" href="{{ block.settings.link }}">{{ block.settings.link_label }} →</a>{% endif %}</div></article>
    {% endfor %}</div>
  </div>
</section>
{% schema %}
{"name":"Licencias · Alcance","settings":[{"type":"text","id":"eyebrow","label":"Antetítulo","default":"Antes de diseñar y construir"},{"type":"text","id":"heading","label":"Título","default":"Tres frentes que conviene resolver en el orden correcto"},{"type":"richtext","id":"intro","label":"Introducción","default":"<p>La licencia no es un trámite aislado al final del proyecto. El encaje urbanístico condiciona el diseño; el diseño condiciona la documentación; y la documentación debe corresponder con lo que realmente se ejecutará.</p>"}],"blocks":[{"type":"item","name":"Bloque de alcance","settings":[{"type":"text","id":"index","label":"Índice","default":"01 · Viabilidad"},{"type":"text","id":"heading","label":"Título","default":"Saber qué se puede hacer"},{"type":"richtext","id":"text","label":"Texto","default":"<p>Revisamos ocupación, edificabilidad, altura, retranqueos, alineaciones, uso y clasificación del suelo antes de cerrar una solución.</p>"},{"type":"text","id":"link_label","label":"Enlace · texto"},{"type":"url","id":"link","label":"Enlace · URL"}]}],"max_blocks":6,"presets":[{"name":"Licencias · Alcance"}]}
{% endschema %}