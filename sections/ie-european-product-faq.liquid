{% comment %}IE · Sistema Europeo · preguntas frecuentes + cierre con presupuesto. Contenido común (guía IE-SE-03).{% endcomment %}
{%- liquid
  assign eu_name = product.title | default: 'este modelo'
  assign eu_model_param = eu_name | url_encode
  assign eu_quote = section.settings.quote_link | append: '?modelo=' | append: eu_model_param
-%}
{{ 'ie-eu-model.css' | asset_url | stylesheet_tag }}
<section class="ie-eu ie-eu__section" id="preguntas" aria-labelledby="ie-eu-faq-{{ section.id }}">
  <div class="ie-eu__wrap">
    {% if section.blocks.size > 0 %}
      <div class="ie-eu-faq__grid">
        <div>
          <p class="ie-eu__eyebrow">{{ section.settings.eyebrow }}</p>
          <h2 id="ie-eu-faq-{{ section.id }}">{{ section.settings.heading }}</h2>
        </div>
        <div>
          {% for block in section.blocks %}
            <details class="ie-eu-faq__item" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }}</summary>
              <div class="ie-eu-faq__answer">{{ block.settings.answer }}</div>
            </details>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <div class="ie-eu__cta-band">
      <div>
        <p class="ie-eu__eyebrow">{{ section.settings.cta_eyebrow }}</p>
        <h2>{{ section.settings.cta_heading | replace: '[modelo]', eu_name }}</h2>
        <p>{{ section.settings.cta_text }}</p>
      </div>
      <div class="ie-eu__cta-actions">
        <a class="ie-eu__btn ie-eu__btn--light" href="{{ eu_quote }}">{{ section.settings.cta_label | replace: '[modelo]', eu_name }} <span aria-hidden="true">→</span></a>
        {% if section.settings.secondary_link != blank and section.settings.secondary_label != blank %}
          <a class="ie-eu__btn ie-eu__btn--ghost-light" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
        {% endif %}
        <div class="ie-eu__cta-contact">
          {% if section.settings.phone != blank %}<a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>{% endif %}
          {% if section.settings.email != blank %}<a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>{% endif %}
        </div>
      </div>
    </div>
    {% if section.settings.disclaimer != blank %}<p class="ie-eu__disclaimer">{{ section.settings.disclaimer }}</p>{% endif %}
  </div>
</section>

{% if section.blocks.size > 0 %}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
{% endif %}

{% schema %}
{
  "name": "Europeo · preguntas",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Preguntas frecuentes" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Antes de pedir presupuesto" },
    { "type": "header", "content": "Cierre" },
    { "type": "text", "id": "cta_eyebrow", "label": "Antetítulo", "default": "Siguiente paso" },
    { "type": "text", "id": "cta_heading", "label": "Título", "info": "[modelo] se sustituye por el nombre del producto.", "default": "¿Encaja [modelo] con tu proyecto?" },
    { "type": "textarea", "id": "cta_text", "label": "Texto", "default": "Indícanos la ubicación, el uso previsto, la configuración que estás valorando y los servicios que necesitas. Revisaremos el modelo, los condicionantes del emplazamiento y el alcance necesario para preparar una propuesta comparable." },
    { "type": "text", "id": "cta_label", "label": "Botón", "info": "[modelo] se sustituye por el nombre del producto.", "default": "Solicitar estudio de [modelo]" },
    { "type": "text", "id": "secondary_label", "label": "Botón secundario", "default": "Consultar el Sistema Europeo" },
    { "type": "url", "id": "secondary_link", "label": "Enlace del botón secundario" },
    { "type": "url", "id": "quote_link", "label": "Enlace de presupuesto" },
    { "type": "text", "id": "phone", "label": "Teléfono", "default": "+34 916 99 60 93" },
    { "type": "text", "id": "email", "label": "Correo electrónico", "default": "info@ideas-exteriores.com" },
    { "type": "textarea", "id": "disclaimer", "label": "Aviso final", "default": "Imágenes ilustrativas. Esta página describe un modelo de catálogo: no sustituye al presupuesto, al proyecto técnico ni a la licencia, y no acredita la adecuación a una parcela concreta." }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pregunta" },
        { "type": "richtext", "id": "answer", "label": "Respuesta" }
      ]
    }
  ],
  "presets": [{ "name": "Europeo · preguntas" }]
}
{% endschema %}
