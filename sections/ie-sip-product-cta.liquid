{% liquid
  assign ie_contact_url = pages['contact-ideas-exteriores'].url | default: '/pages/contact-ideas-exteriores'
  assign ie_services_url = pages['services'].url | default: '/pages/services'
%}

<section class="ie-sip-pdp ie-sip-pdp--cta" aria-labelledby="ie-sip-cta-title-{{ section.id }}">
  <div class="ie-sip-pdp__inner">
    <div class="ie-sip-pdp__closing">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="ie-sip-pdp__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 id="ie-sip-cta-title-{{ section.id }}">{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}
          <div class="ie-sip-pdp__closing-text rte">{{ section.settings.text }}</div>
        {% endif %}
      </div>
      <div class="ie-sip-pdp__actions">
        <a class="ie-sip-pdp__button ie-sip-pdp__button--primary" href="{{ ie_contact_url }}">
          {{ section.settings.primary_label }}
        </a>
        <a class="ie-sip-pdp__button ie-sip-pdp__button--secondary" href="{{ ie_services_url }}">
          {{ section.settings.secondary_label }}
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "IE · Casa SIP · CTA",
  "enabled_on": {"templates": ["product"]},
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Siguiente paso"},
    {"type": "text", "id": "heading", "label": "Título", "default": "¿Quieres validar este modelo para tu proyecto?"},
    {"type": "richtext", "id": "text", "label": "Texto", "default": "<p>Indícanos el modelo que estás revisando, la ubicación y el punto en el que se encuentra tu proyecto. Con esa base podremos orientar el alcance y el siguiente paso con más precisión.</p>"},
    {"type": "text", "id": "primary_label", "label": "CTA principal", "default": "Hablar con el equipo"},
    {"type": "text", "id": "secondary_label", "label": "CTA secundario", "default": "Cómo trabajamos"}
  ],
  "presets": [{"name": "IE · Casa SIP · CTA"}]
}
{% endschema %}
