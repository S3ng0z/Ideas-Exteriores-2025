{{ 'ie-habitable-product.css' | asset_url | stylesheet_tag }}
{% comment %}IE breadcrumb renderer synced{% endcomment %}

{% liquid
  assign ie_breadcrumb_1_label = product.metafields.custom.n1.value | default: section.settings.breadcrumb_1_label
  assign ie_breadcrumb_2_label = product.metafields.custom.n2.value | default: section.settings.breadcrumb_2_label
  assign ie_breadcrumb_3_label = product.metafields.custom.n3.value | default: section.settings.breadcrumb_3_label

  assign ie_breadcrumb_1_link = section.settings.breadcrumb_1_link
  assign ie_breadcrumb_2_link = section.settings.breadcrumb_2_link
  assign ie_breadcrumb_3_link = section.settings.breadcrumb_3_link

  if ie_breadcrumb_1_link == blank
    assign ie_breadcrumb_1_link = product.metafields.custom.n1_url.value
  endif
  if ie_breadcrumb_2_link == blank
    assign ie_breadcrumb_2_link = product.metafields.custom.n2_url.value
  endif
  if ie_breadcrumb_3_link == blank
    assign ie_breadcrumb_3_link = product.metafields.custom.n3_url.value
  endif
%}

<section class="ie-hab-pdp ie-hab-pdp--hero" aria-labelledby="ie-hab-product-title-{{ section.id }}">
  <div class="ie-hab-pdp__inner">
    {% render 'ie-breadcrumb',
  breadcrumb_object: product,
  current_title: product.title,
  class_name: 'ie-hab-pdp__breadcrumb',
  aria_label: section.settings.breadcrumb_label,
  home_label: section.settings.home_label,
  fallback_1_label: section.settings.breadcrumb_1_label,
  fallback_1_link: section.settings.breadcrumb_1_link,
  fallback_2_label: section.settings.breadcrumb_2_label,
  fallback_2_link: section.settings.breadcrumb_2_link,
  fallback_3_label: section.settings.breadcrumb_3_label,
  fallback_3_link: section.settings.breadcrumb_3_link
%}

    <div class="ie-hab-pdp__hero-grid">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="ie-hab-pdp__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h1 id="ie-hab-product-title-{{ section.id }}">{{ product.title }}</h1>
        {% if section.settings.lead != blank %}
          <div class="ie-hab-pdp__lead rte">{{ section.settings.lead }}</div>
        {% endif %}
        <div class="ie-hab-pdp__actions">
          <a class="ie-hab-pdp__button ie-hab-pdp__button--primary" href="#ie-habitable-packages">{{ section.settings.primary_label }}</a>
          {% if section.settings.secondary_link != blank and section.settings.secondary_label != blank %}
            <a class="ie-hab-pdp__button ie-hab-pdp__button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
          {% endif %}
        </div>
      </div>

      {% if section.blocks.size > 0 %}
        <aside class="ie-hab-pdp__summary" aria-label="{{ section.settings.summary_aria_label | escape }}">
          <p class="ie-hab-pdp__summary-title">{{ section.settings.summary_title }}</p>
          <ol>
            {% for block in section.blocks %}
              <li {{ block.shopify_attributes }}>
                <span>{{ block.settings.number }}</span>
                <strong>{{ block.settings.label }}</strong>
              </li>
            {% endfor %}
          </ol>
        </aside>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "IE · Habitable · Hero",
  "enabled_on": {"templates": ["product"]},
  "settings": [
    {"type":"text","id":"breadcrumb_label","label":"Etiqueta breadcrumb","default":"Migas de pan"},
    {"type":"text","id":"home_label","label":"Inicio","default":"Inicio"},
    {"type":"text","id":"breadcrumb_1_label","label":"Nivel 1 · texto","default":"Productos"},
    {"type":"url","id":"breadcrumb_1_link","label":"Nivel 1 · enlace"},
    {"type":"text","id":"breadcrumb_2_label","label":"Nivel 2 · texto","default":"Viviendas en madera"},
    {"type":"url","id":"breadcrumb_2_link","label":"Nivel 2 · enlace"},
    {"type":"text","id":"breadcrumb_3_label","label":"Nivel 3 · texto","default":"Casas de entramado ligero"},
    {"type":"url","id":"breadcrumb_3_link","label":"Nivel 3 · enlace"},
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"Modelo de vivienda"},
    {"type":"richtext","id":"lead","label":"Introducción","default":"<p>Revisa el modelo, compara el alcance de sus configuraciones y valida las condiciones del proyecto antes de solicitar presupuesto.</p>"},
    {"type":"text","id":"primary_label","label":"CTA principal","default":"Comparar configuraciones"},
    {"type":"text","id":"secondary_label","label":"CTA secundario","default":"Entender el sistema constructivo"},
    {"type":"url","id":"secondary_link","label":"Enlace CTA secundario"},
    {"type":"text","id":"summary_title","label":"Título resumen","default":"Antes de pedir presupuesto"},
    {"type":"text","id":"summary_aria_label","label":"Etiqueta accesible resumen","default":"Pasos antes de pedir presupuesto"}
  ],
  "blocks":[{"type":"step","name":"Paso","settings":[
    {"type":"text","id":"number","label":"Número","default":"01"},
    {"type":"text","id":"label","label":"Texto","default":"Revisa el modelo y su distribución"}
  ]}],
  "max_blocks":4,
  "presets":[{"name":"IE · Habitable · Hero"}]
}
{% endschema %}
