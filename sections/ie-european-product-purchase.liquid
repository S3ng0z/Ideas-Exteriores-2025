{% comment %}IE · Sistema Europeo · modalidades de compra, alcance del precio y proceso. Contenido común (guía IE-SE-03).{% endcomment %}
{{ 'ie-eu-model.css' | asset_url | stylesheet_tag }}
<section class="ie-eu ie-eu--stone ie-eu__section" id="compra" aria-labelledby="ie-eu-buy-{{ section.id }}">
  <div class="ie-eu__wrap">
    <header class="ie-eu__head">
      <div>
        <p class="ie-eu__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 id="ie-eu-buy-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.intro != blank %}<p class="ie-eu__lead">{{ section.settings.intro }}</p>{% endif %}
    </header>

    <div class="ie-eu-modes">
      <article class="ie-eu-card">
        <p class="ie-eu-card__kicker">{{ section.settings.mode_a_kicker }}</p>
        <h3>{{ section.settings.mode_a_title }}</h3>
        <p>{{ section.settings.mode_a_text }}</p>
      </article>
      <article class="ie-eu-card">
        <p class="ie-eu-card__kicker">{{ section.settings.mode_b_kicker }}</p>
        <h3>{{ section.settings.mode_b_title }}</h3>
        <p>{{ section.settings.mode_b_text }}</p>
      </article>
    </div>

    <div class="ie-eu-pricecard">
      <div>
        <h3>{{ section.settings.price_title }}</h3>
        <p class="ie-eu__note">{{ section.settings.price_text }}</p>
      </div>
      <div>
        <p class="ie-eu-pricecard__label">{{ section.settings.cost_label }}</p>
        <ul>
          {% assign cost_items = section.settings.cost_items | newline_to_br | split: '<br />' %}
          {% for item in cost_items %}
            {%- assign clean = item | strip -%}
            {% if clean != blank %}<li>{{ clean }}</li>{% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>

    {% if section.blocks.size > 0 %}
      <ol class="ie-eu-steps" aria-label="{{ section.settings.steps_label | escape }}">
        {% for block in section.blocks %}
          <li {{ block.shopify_attributes }}><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></li>
        {% endfor %}
      </ol>
    {% endif %}
    {% if section.settings.steps_note != blank %}<p class="ie-eu__note">{{ section.settings.steps_note }}</p>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Europeo · compra",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Compra e instalación" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Del modelo al suministro" },
    { "type": "textarea", "id": "intro", "label": "Introducción", "default": "Antes de confirmar el pedido, concretamos la configuración, la ubicación, los accesos y los servicios. El presupuesto identifica el suministro y, si procede, los trabajos de montaje y sus responsables." },
    { "type": "header", "content": "Modalidades" },
    { "type": "text", "id": "mode_a_kicker", "label": "Modalidad A · antetítulo", "default": "Modalidad A" },
    { "type": "text", "id": "mode_a_title", "label": "Modalidad A · título", "default": "Suministro de kit" },
    { "type": "textarea", "id": "mode_a_text", "label": "Modalidad A · texto", "default": "Los componentes de madera y las carpinterías de la configuración presupuestada, mecanizados e identificados, con planos e instrucciones. El montaje lo organiza el comprador, por sus medios o con terceros." },
    { "type": "text", "id": "mode_b_kicker", "label": "Modalidad B · antetítulo", "default": "Modalidad B" },
    { "type": "text", "id": "mode_b_title", "label": "Modalidad B · título", "default": "Kit con montaje contratado" },
    { "type": "textarea", "id": "mode_b_text", "label": "Modalidad B · texto", "default": "El kit más los trabajos de montaje descritos en el presupuesto, habitualmente la estructura de madera: suelo, paredes, cubierta, puertas y ventanas. Se ofrece según modelo, ubicación, accesos y disponibilidad, y se confirma por escrito antes del pedido." },
    { "type": "header", "content": "Precio" },
    { "type": "text", "id": "price_title", "label": "Título", "default": "Qué representa el precio publicado" },
    { "type": "textarea", "id": "price_text", "label": "Texto", "default": "Corresponde a la configuración de referencia del modelo en suministro de kit. Las opciones y los servicios se valoran en el presupuesto, cuando se conocen la configuración, la ubicación y los accesos." },
    { "type": "text", "id": "cost_label", "label": "Título de la lista", "default": "Otras partidas del coste total" },
    { "type": "textarea", "id": "cost_items", "label": "Partidas (una por línea)", "default": "Transporte, descarga y medios auxiliares\nBase o cimentación\nMontaje y colocación de cubierta, aislamiento y canalones\nProtección o pintura de la madera\nInstalaciones y acometidas\nProyecto técnico, licencias y tasas\nImpuestos aplicables" },
    { "type": "header", "content": "Proceso" },
    { "type": "text", "id": "steps_label", "label": "Nombre accesible del proceso", "default": "Proceso de compra" },
    { "type": "textarea", "id": "steps_note", "label": "Nota", "default": "Para un presupuesto ajustado, indícanos el modelo, el uso previsto, el código postal y el municipio, las condiciones de acceso y, si es posible, fotografías del acceso y de la parcela." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        { "type": "text", "id": "title", "label": "Paso" },
        { "type": "text", "id": "text", "label": "Descripción" }
      ]
    }
  ],
  "presets": [{ "name": "Europeo · compra" }]
}
{% endschema %}
