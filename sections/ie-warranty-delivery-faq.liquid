<section class="ie-wdp ie-wdp--faq" aria-labelledby="ie-wdp-faq-title-{{ section.id }}">
  <div class="ie-wdp__inner">
    <div class="ie-wdp__section-head ie-wdp__section-head--faq">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="ie-wdp__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2 id="ie-wdp-faq-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.intro != blank %}<div class="ie-wdp__section-intro rte">{{ section.settings.intro }}</div>{% endif %}
    </div>

    <div class="ie-wdp__faq-list">
      {% for block in section.blocks %}
        <details class="ie-wdp__faq-item" {{ block.shopify_attributes }}>
          <summary>
            <span>{{ block.settings.question }}</span>
            <span class="ie-wdp__faq-icon" aria-hidden="true"></span>
          </summary>
          <div class="ie-wdp__faq-answer rte">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Garantía · Preguntas",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"Preguntas frecuentes"},
    {"type":"text","id":"heading","label":"Título","default":"Qué conviene revisar antes de aceptar el pedido"},
    {"type":"richtext","id":"intro","label":"Introducción","default":"<p>Estas respuestas sirven como guía operativa. Las condiciones específicas de cada compra se concretan en el presupuesto, pedido y documentación que corresponda.</p>"}
  ],
  "blocks":[
    {
      "type":"question",
      "name":"Pregunta",
      "settings":[
        {"type":"text","id":"question","label":"Pregunta","default":"¿La garantía es igual para todos los productos y servicios?"},
        {"type":"richtext","id":"answer","label":"Respuesta","default":"<p>No necesariamente. El alcance depende del producto, sus componentes, el servicio contratado y las condiciones específicas de instalación, uso y mantenimiento. Debe quedar identificado en la documentación aplicable a tu proyecto.</p>"}
      ]
    }
  ],
  "max_blocks":8,
  "presets":[{"name":"Garantía · Preguntas"}]
}
{% endschema %}