<section class="ie-hc ie-hc--cta" aria-labelledby="ie-hc-cta-title-{{ section.id }}">
  <div class="ie-hc__inner">
    <div class="ie-hc__cta">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="ie-hc__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 id="ie-hc-cta-title-{{ section.id }}">{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}
          <div class="ie-hc__cta-text rte">{{ section.settings.text }}</div>
        {% endif %}
      </div>

      <div class="ie-hc__actions">
        {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}
          <a class="ie-hc__button ie-hc__button--primary" href="{{ section.settings.primary_link }}">
            {{ section.settings.primary_label }}
          </a>
        {% endif %}
        {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
          <a class="ie-hc__button ie-hc__button--secondary" href="{{ section.settings.secondary_link }}">
            {{ section.settings.secondary_label }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "IE · Habitable · CTA",
  "enabled_on": {"templates": ["collection"]},
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Siguiente paso"},
    {"type": "text", "id": "heading", "label": "Título", "default": "¿Ya tienes un modelo en mente?"},
    {"type": "richtext", "id": "text", "label": "Texto", "default": "<p>Revisa la ficha del modelo y, cuando tengas clara la ubicación, podremos validar el alcance y las condiciones del proyecto.</p>"},
    {"type": "text", "id": "primary_label", "label": "CTA principal", "default": "Cómo trabajamos"},
    {"type": "url", "id": "primary_link", "label": "Enlace CTA principal"},
    {"type": "text", "id": "secondary_label", "label": "CTA secundario", "default": "Hablar con el equipo"},
    {"type": "url", "id": "secondary_link", "label": "Enlace CTA secundario"}
  ],
  "presets": [{"name": "IE · Habitable · CTA"}]
}
{% endschema %}
