<section class="ie-wood3d ie-wood3d--fit" aria-labelledby="ie-wood3d-fit-title-{{ section.id }}">
  <div class="ie-wood3d__inner">
    <div class="ie-wood3d__section-head">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="ie-wood3d__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2 id="ie-wood3d-fit-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.intro != blank %}<div class="ie-wood3d__section-intro rte">{{ section.settings.intro }}</div>{% endif %}
    </div>
    <div class="ie-wood3d__fit-grid">
      {% for block in section.blocks %}
        <article {{ block.shopify_attributes }}>
          <p class="ie-wood3d__fit-label">{{ block.settings.label }}</p>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Diseño 3D · Cuándo encaja",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"Cuándo aporta más valor"},
    {"type":"text","id":"heading","label":"Título","default":"Un servicio útil cuando hay decisiones que cerrar"},
    {"type":"richtext","id":"intro","label":"Introducción","default":"<p>No todos los proyectos necesitan el mismo nivel de definición. Estas son situaciones habituales en las que una revisión 3D y técnica evita avanzar con supuestos poco claros.</p>"}
  ],
  "blocks":[
    {
      "type":"fit",
      "name":"Caso",
      "settings":[
        {"type":"text","id":"label","label":"Etiqueta","default":"Antes de presupuestar"},
        {"type":"text","id":"heading","label":"Título","default":"Tienes una idea, pero faltan decisiones"},
        {"type":"textarea","id":"text","label":"Texto","default":"Necesitas ordenar dimensiones, distribución, sistema o nivel de acabado antes de pedir una valoración comparable."}
      ]
    }
  ],
  "max_blocks":6,
  "presets":[{"name":"Diseño 3D · Cuándo encaja"}]
}
{% endschema %}
