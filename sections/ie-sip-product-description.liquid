<section class="ie-sip-pdp ie-sip-pdp--description" aria-labelledby="ie-sip-description-title-{{ section.id }}">
  <div class="ie-sip-pdp__inner">
    <div class="ie-sip-pdp__section-head">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="ie-sip-pdp__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 id="ie-sip-description-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.intro != blank %}
        <div class="ie-sip-pdp__section-intro rte">{{ section.settings.intro }}</div>
      {% endif %}
    </div>

    {% if product.description != blank %}
      <div class="ie-sip-pdp__description-body rte">
        {{ product.description }}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "IE · Casa SIP · Modelo",
  "enabled_on": {"templates": ["product"]},
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "El modelo"},
    {"type": "text", "id": "heading", "label": "Título", "default": "Características y planteamiento"},
    {"type": "richtext", "id": "intro", "label": "Introducción", "default": "<p>La ficha del modelo describe su superficie, distribución y elementos propios. El alcance constructivo se compara por configuración en el siguiente bloque.</p>"}
  ],
  "presets": [{"name": "IE · Casa SIP · Modelo"}]
}
{% endschema %}
