<section class="ie-faq ie-faq--cta" aria-labelledby="ie-faq-cta-title-{{ section.id }}">
  <div class="ie-faq__inner">
    <div class="ie-faq__closing">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="ie-faq__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 id="ie-faq-cta-title-{{ section.id }}">{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}
          <div class="rte">{{ section.settings.text }}</div>
        {% endif %}
      </div>

      <div class="ie-faq__actions">
        {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}
          <a class="ie-faq__button ie-faq__button--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
        {% endif %}
        {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
          <a class="ie-faq__button ie-faq__button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name":"FAQ · Cierre",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"¿No encuentras tu caso?"},
    {"type":"text","id":"heading","label":"Título","default":"Cuéntanos en qué punto está tu proyecto"},
    {"type":"richtext","id":"text","label":"Texto","default":"<p>Con el uso previsto, la ubicación y unas medidas aproximadas podemos orientarte hacia la solución, el servicio y el siguiente paso adecuados.</p>"},
    {"type":"text","id":"primary_label","label":"CTA principal","default":"Hacer una consulta"},
    {"type":"url","id":"primary_link","label":"Enlace CTA principal"},
    {"type":"text","id":"secondary_label","label":"CTA secundario","default":"Ver servicios"},
    {"type":"url","id":"secondary_link","label":"Enlace CTA secundario"}
  ],
  "presets":[{"name":"FAQ · Cierre"}]
}
{% endschema %}
