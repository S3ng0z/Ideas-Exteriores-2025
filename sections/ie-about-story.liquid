<section class="ie-about ie-about--story" aria-labelledby="ie-about-story-title-{{ section.id }}">
  <div class="ie-about__inner">
    <div class="ie-about__story">
      {% if section.settings.image != blank %}
        <div class="ie-about__story-media">
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              widths: '640, 960, 1280, 1600',
              sizes: '(min-width: 750px) 50vw, 100vw',
              loading: 'lazy',
              alt: section.settings.image_alt
          }}
        </div>
      {% endif %}

      <div class="ie-about__story-content">
        {% if section.settings.eyebrow != blank %}
          <p class="ie-about__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 id="ie-about-story-title-{{ section.id }}">{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}
          <div class="ie-about__story-copy rte">{{ section.settings.text }}</div>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="ie-about__story-points">
            {% for block in section.blocks %}
              <div class="ie-about__story-point" {{ block.shopify_attributes }}>
                <strong>{{ block.settings.heading }}</strong>
                <span>{{ block.settings.text }}</span>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Nosotros · Identidad",
  "settings":[
    {"type":"image_picker","id":"image","label":"Imagen"},
    {"type":"text","id":"image_alt","label":"Texto alternativo"},
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"Quiénes somos"},
    {"type":"text","id":"heading","label":"Título","default":"Una forma más clara de construir con madera"},
    {"type":"richtext","id":"text","label":"Texto","default":"<p>La madera es el material que articula nuestra propuesta. La combinamos con soluciones técnicas y otros materiales cuando mejoran el resultado del conjunto.</p><p>Trabajamos con un catálogo curado de soluciones y opciones compatibles, porque definir bien desde el principio permite controlar mejor fabricación, transporte, montaje, prestaciones y presupuesto.</p>"}
  ],
  "blocks":[
    {
      "type":"point",
      "name":"Punto",
      "settings":[
        {"type":"text","id":"heading","label":"Título","default":"Madera"},
        {"type":"textarea","id":"text","label":"Texto","default":"Material protagonista y criterio de identidad."}
      ]
    }
  ],
  "max_blocks":3,
  "presets":[{"name":"Nosotros · Identidad"}]
}
{% endschema %}
