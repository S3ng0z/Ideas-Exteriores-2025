{{ 'ie-contact-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ie-contact-form.js' | asset_url }}" defer></script>

<section class="ie-contact ie-contact--form" id="contact-form" aria-labelledby="ie-contact-title-{{ section.id }}">
  <div class="ie-contact__inner">
    {% render 'ie-breadcrumb', breadcrumb_object: page, current_title: page.title, class_name: 'ie-contact__breadcrumb' %}

    <div class="ie-contact__form-layout">
      <aside class="ie-contact__side" aria-label="Información de contacto">
        {% if section.settings.eyebrow != blank %}
          <p class="ie-contact__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        <h1 id="ie-contact-title-{{ section.id }}">{{ section.settings.heading }}</h1>

        {% if section.settings.intro != blank %}
          <div class="ie-contact__side-intro rte">{{ section.settings.intro }}</div>
        {% endif %}

        <dl class="ie-contact__details">
          {% if section.settings.phone != blank %}
            <div class="ie-contact__detail">
              <dt>Teléfono</dt>
              <dd><a href="tel:{{ section.settings.phone | replace: ' ', '' }}">{{ section.settings.phone }}</a></dd>
            </div>
          {% endif %}

          {% if section.settings.email != blank %}
            <div class="ie-contact__detail">
              <dt>Email</dt>
              <dd><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></dd>
            </div>
          {% endif %}

          {% if section.settings.location != blank %}
            <div class="ie-contact__detail">
              <dt>Ubicación</dt>
              <dd>{{ section.settings.location | newline_to_br }}</dd>
            </div>
          {% endif %}

          {% if section.settings.hours != blank %}
            <div class="ie-contact__detail">
              <dt>Horario</dt>
              <dd>{{ section.settings.hours }}</dd>
            </div>
          {% endif %}
        </dl>

        {% if section.settings.appointment_note != blank %}
          <div class="ie-contact__appointment">
            {{ section.settings.appointment_note }}
          </div>
        {% endif %}
      </aside>

      <div class="ie-contact__form-panel">
        <div class="ie-contact__form-panel-head">
          {% if section.settings.form_eyebrow != blank %}
            <p class="ie-contact__eyebrow">{{ section.settings.form_eyebrow }}</p>
          {% endif %}

          <h2>{{ section.settings.form_heading }}</h2>

          {% if section.settings.form_intro != blank %}
            <div class="ie-contact__form-intro rte">{{ section.settings.form_intro }}</div>
          {% endif %}
        </div>

        {% render 'ie-contact-native-form', section: section %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contacto · Formulario nativo",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Antetítulo lateral","default":"Contacto directo"},
    {"type":"text","id":"heading","label":"Título principal","default":"Cuéntanos en qué podemos ayudarte."},
    {"type":"richtext","id":"intro","label":"Introducción lateral","default":"<p>Indica el motivo y los datos necesarios para que podamos dirigir tu consulta correctamente.</p>"},
    {"type":"text","id":"form_eyebrow","label":"Antetítulo formulario","default":"Consulta"},
    {"type":"text","id":"form_heading","label":"Título formulario","default":"Escríbenos."},
    {"type":"richtext","id":"form_intro","label":"Introducción formulario","default":"<p>Cuéntanos el motivo, tus datos y el contexto esencial. Si tienes una referencia previa, añádela.</p>"},
    {"type":"text","id":"submit_label","label":"Texto del botón","default":"Enviar consulta"},
    {"type":"url","id":"privacy_link","label":"Política de privacidad"},
    {"type":"text","id":"phone","label":"Teléfono","default":"+34 916 99 60 93"},
    {"type":"text","id":"email","label":"Email","default":"info@ideas-exteriores.com"},
    {"type":"textarea","id":"location","label":"Ubicación","default":"Ctra. de Yuncos a Cedillo, km. 1.3\n45210 Yuncos, Toledo\nAl lado de Mármoles Yuncos"},
    {"type":"text","id":"hours","label":"Horario","default":"L-V · 9:00–18:00"},
    {"type":"richtext","id":"appointment_note","label":"Nota cita previa","default":"<p>La atención presencial se realiza <strong>solo con cita previa</strong>.</p>"}
  ],
  "presets": [
    {"name":"Contacto · Formulario nativo"}
  ]
}
{% endschema %}
