<section class="ie-contact ie-contact--form" id="contact-form" aria-labelledby="ie-contact-form-title-{{ section.id }}">
  <div class="ie-contact__inner">
    <div class="ie-contact__section-head">
      {% if section.settings.eyebrow != blank %}
        <p class="ie-contact__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 id="ie-contact-form-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      {% if section.settings.intro != blank %}
        <div class="ie-contact__section-intro rte">{{ section.settings.intro }}</div>
      {% endif %}
    </div>

    <div class="ie-contact__form-layout">
      <div class="ie-contact__form-panel">
        {% if section.blocks.size > 0 %}
          {% content_for 'blocks' %}
        {% else %}
          {% render 'ie-contact-native-form', section: section %}
        {% endif %}
      </div>

      <aside class="ie-contact__side" aria-label="Datos de contacto">
        <h3 class="ie-contact__side-title">{{ section.settings.side_heading }}</h3>

        <dl class="ie-contact__details">
          {% if section.settings.phone != blank %}
            <div class="ie-contact__detail">
              <dt>Teléfono</dt>
              <dd><a href="tel:{{ section.settings.phone | replace: ' ', '' }}">{{ section.settings.phone }}</a></dd>
            </div>
          {% endif %}

          {% if section.settings.email != blank %}
            <div class="ie-contact__detail">
              <dt>Email</dt>
              <dd><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></dd>
            </div>
          {% endif %}

          {% if section.settings.location != blank %}
            <div class="ie-contact__detail">
              <dt>Ubicación</dt>
              <dd>{{ section.settings.location | newline_to_br }}</dd>
            </div>
          {% endif %}

          {% if section.settings.hours != blank %}
            <div class="ie-contact__detail">
              <dt>Horario</dt>
              <dd>{{ section.settings.hours }}</dd>
            </div>
          {% endif %}
        </dl>

        {% if section.settings.appointment_note != blank %}
          <div class="ie-contact__appointment">
            {{ section.settings.appointment_note }}
          </div>
        {% endif %}
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Contacto · Formulario",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"Cuéntanos tu caso"},
    {"type":"text","id":"heading","label":"Título","default":"La información justa para poder orientarte"},
    {"type":"richtext","id":"intro","label":"Introducción","default":"<p>No hace falta tenerlo todo resuelto. Indica el motivo, el tipo de solución y los datos que ya conozcas. Cuanto más claro sea el punto de partida, más útil será nuestra respuesta.</p>"},
    {"type":"text","id":"submit_label","label":"Texto botón formulario nativo","default":"Enviar consulta"},
    {"type":"url","id":"privacy_link","label":"Política de privacidad"},
    {"type":"text","id":"side_heading","label":"Título datos de contacto","default":"Contacto directo"},
    {"type":"text","id":"phone","label":"Teléfono","default":"+34 916 99 60 93"},
    {"type":"text","id":"email","label":"Email","default":"info@ideas-exteriores.com"},
    {"type":"textarea","id":"location","label":"Ubicación","default":"Ctra. de Yuncos a Cedillo, km. 1.3\n45210 Yuncos, Toledo\nAl lado de Mármoles Yuncos"},
    {"type":"text","id":"hours","label":"Horario","default":"L-V · 9:00–18:00"},
    {"type":"richtext","id":"appointment_note","label":"Nota cita previa","default":"<p>La atención presencial se realiza <strong>solo con cita previa</strong>.</p>"}
  ],
  "blocks":[
    {"type":"@app"}
  ],
  "presets":[{"name":"Contacto · Formulario"}]
}
{% endschema %}
