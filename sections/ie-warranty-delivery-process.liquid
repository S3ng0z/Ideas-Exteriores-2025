<section class="ie-wdp ie-wdp--process" id="proceso-entrega" aria-labelledby="ie-wdp-process-title-{{ section.id }}">
  <div class="ie-wdp__inner">
    <div class="ie-wdp__process">
      <div class="ie-wdp__process-intro">
        {% if section.settings.eyebrow != blank %}<p class="ie-wdp__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2 id="ie-wdp-process-title-{{ section.id }}">{{ section.settings.heading }}</h2>
        {% if section.settings.intro != blank %}<div class="rte">{{ section.settings.intro }}</div>{% endif %}
      </div>
      <ol class="ie-wdp__process-list">
        {% for block in section.blocks %}
          <li class="ie-wdp__process-step" {{ block.shopify_attributes }}>
            <span>{{ block.settings.number }}</span>
            <div>
              <h3>{{ block.settings.heading }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </li>
        {% endfor %}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Garantía · Proceso",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"De la confirmación a la posventa"},
    {"type":"text","id":"heading","label":"Título","default":"Un proceso verificable en cada hito"},
    {"type":"richtext","id":"intro","label":"Introducción","default":"<p>Ordenamos la documentación y la comunicación para que cada fase tenga un responsable, una condición de avance y una evidencia clara: pedido confirmado, producción, expedición, recepción y seguimiento posterior.</p>"}
  ],
  "blocks":[
    {
      "type":"step",
      "name":"Paso",
      "settings":[
        {"type":"text","id":"number","label":"Número","default":"01"},
        {"type":"text","id":"heading","label":"Título","default":"Confirmar alcance y condiciones"},
        {"type":"textarea","id":"text","label":"Texto","default":"Revisamos producto, configuración, servicios, ubicación, logística, pagos y documentos aplicables antes de activar el pedido."}
      ]
    }
  ],
  "max_blocks":6,
  "presets":[{"name":"Garantía · Proceso"}]
}
{% endschema %}