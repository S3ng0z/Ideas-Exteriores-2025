{% comment %}
  IE · Sistema Europeo · galería, datos clave, precio y navegación interna del modelo.
  El encabezado (migas, H1, introducción) lo pinta ie-european-product-header.
  Datos del modelo: Product (título, imágenes, precio) + metafields custom.eu_*.
  Rótulos opcionales: custom.eu_dimensions_label (por defecto «Dimensiones máximas») y custom.eu_height_label («Altura de pared»).
  Contenido común del sistema: ajustes de la sección. Sin datos de modelo hard-coded.
{% endcomment %}
{% liquid
  assign eu_name = product.title
  assign eu_dimensions = product.metafields.custom.eu_dimensions.value
  assign eu_interior = product.metafields.custom.eu_interior_area.value
  assign eu_terrace = product.metafields.custom.eu_terrace_area.value
  assign eu_terrace_label = product.metafields.custom.eu_terrace_label.value | default: 'Terraza cubierta'
  assign eu_layout = product.metafields.custom.eu_layout.value
  assign eu_wall_height = product.metafields.custom.eu_wall_height.value
  assign eu_dimensions_label = product.metafields.custom.eu_dimensions_label.value | default: 'Dimensiones máximas'
  assign eu_height_label = product.metafields.custom.eu_height_label.value | default: 'Altura de pared'
  assign eu_cover = product.featured_media.preview_image | default: product.featured_image
  assign eu_model_param = eu_name | url_encode
  assign eu_quote = section.settings.quote_link | append: '?modelo=' | append: eu_model_param
  assign eu_has_price = false
  if product.price > 0
    assign eu_has_price = true
  endif
%}

{{ 'ie-eu-model.css' | asset_url | stylesheet_tag }}

<div class="ie-eu ie-eu-hero" data-eu-hero>
  <div class="ie-eu__wrap">
    <div class="ie-eu-hero__grid">
      <div class="ie-eu-hero__gallery">
        {%- assign first_alt = eu_cover.alt | default: eu_name | downcase -%}
        <div class="ie-eu-hero__stage{% if first_alt contains 'plano' or first_alt contains 'distribuci' %} is-contain{% endif %}" data-eu-stage>
          {% if eu_cover != blank %}
            {{ eu_cover | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1500, 1800', sizes: '(min-width: 990px) 56vw, 100vw', alt: eu_cover.alt, data-eu-main: '' }}
            {% if section.settings.render_badge != blank %}
              <span class="ie-eu-hero__badge" data-eu-badge>{{ section.settings.render_badge }}</span>
            {% endif %}
          {% else %}
            <div class="ie-eu-hero__missing">Imágenes del modelo en preparación.</div>
          {% endif %}
        </div>

        {% if product.images.size > 1 %}
          <div class="ie-eu-hero__thumbs" role="group" aria-label="Imágenes de {{ eu_name | escape }}">
            {% for image in product.images limit: 4 %}
              {%- assign img_alt = image.alt | default: eu_name | downcase -%}
              {%- assign is_drawing = false -%}
              {%- if img_alt contains 'plano' or img_alt contains 'distribuci' -%}{%- assign is_drawing = true -%}{%- endif -%}
              <button
                class="ie-eu-hero__thumb{% if forloop.first %} is-selected{% endif %}"
                type="button"
                data-eu-src="{{ image | image_url: width: 1800 }}"
                data-eu-alt="{{ image.alt | default: eu_name | escape }}"
                data-eu-drawing="{{ is_drawing }}"
                aria-label="Ver imagen {{ forloop.index }}: {{ image.alt | default: eu_name | escape }}"
                aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                {{ image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 300, 400', sizes: '(min-width: 990px) 13vw, 23vw', alt: '' }}
              </button>
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.image_note != blank %}
          <p class="ie-eu-hero__caption">{{ section.settings.image_note }}</p>
        {% endif %}
      </div>

      <div class="ie-eu-hero__summary">
        <p class="ie-eu__eyebrow">{{ section.settings.data_label }}</p>

        <dl class="ie-eu-hero__metrics">
          {% if eu_interior != blank %}
            <div class="ie-eu-hero__metric">
              <svg class="ie-eu__icon" viewBox="0 0 28 28" aria-hidden="true"><path d="M3.5 13 14 4l10.5 9M6 11v13h16V11M11.5 24v-7h5v7"/></svg>
              <div><dt>Recintos interiores</dt><dd>{{ eu_interior | escape }}</dd></div>
            </div>
          {% endif %}
          {% if eu_terrace != blank %}
            <div class="ie-eu-hero__metric">
              <svg class="ie-eu__icon" viewBox="0 0 28 28" aria-hidden="true"><path d="M3 10h22M6 10v14M22 10v14M3 24h22M5 7l4-3h10l4 3M10 17h8"/></svg>
              <div><dt>{{ eu_terrace_label | escape }}</dt><dd>{{ eu_terrace | escape }}</dd></div>
            </div>
          {% endif %}
          {% if eu_layout != blank %}
            <div class="ie-eu-hero__metric">
              <svg class="ie-eu__icon" viewBox="0 0 28 28" aria-hidden="true"><path d="M4 21h20v3H4zM5 21v-7h18v7M8 14v-3h5v3M15 14v-3h5v3M4 24v1.5M24 24v1.5"/></svg>
              <div><dt>Distribución</dt><dd>{{ eu_layout | escape }}</dd></div>
            </div>
          {% endif %}
          {% if eu_dimensions != blank %}
            <div class="ie-eu-hero__metric">
              <svg class="ie-eu__icon" viewBox="0 0 28 28" aria-hidden="true"><path d="M4 10V4h6M18 4h6v6M24 18v6h-6M10 24H4v-6M5 5l6 6M23 5l-6 6M23 23l-6-6M5 23l6-6"/></svg>
              <div><dt>{{ eu_dimensions_label | escape }}</dt><dd>{{ eu_dimensions | escape }}</dd></div>
            </div>
          {% endif %}
          {% if eu_wall_height != blank %}
            <div class="ie-eu-hero__metric">
              <svg class="ie-eu__icon" viewBox="0 0 28 28" aria-hidden="true"><path d="M8 4v20M5 7l3-3 3 3M5 21l3 3 3-3M15 6h9M15 11h9M15 16h9M15 21h9"/></svg>
              <div><dt>{{ eu_height_label | escape }}</dt><dd>{{ eu_wall_height | escape }}</dd></div>
            </div>
          {% endif %}
        </dl>

        <div class="ie-eu-hero__price">
          <svg class="ie-eu__icon" viewBox="0 0 28 28" aria-hidden="true"><path d="M4 13.5 13.5 4H23l1 1v9.5L14.5 24z"/><circle cx="19" cy="9" r="1.4"/></svg>
          <div>
            {% if eu_has_price %}
              <strong>Desde {{ product.price | money }}</strong>
              <p>{{ section.settings.price_note }}</p>
            {% else %}
              <strong>{{ section.settings.price_on_request }}</strong>
              <p>{{ section.settings.price_on_request_note }}</p>
            {% endif %}
          </div>
        </div>

        <div class="ie-eu-hero__actions">
          <a class="ie-eu__btn ie-eu__btn--primary" href="{{ eu_quote }}">{{ section.settings.primary_label }} <span aria-hidden="true">→</span></a>
          <a class="ie-eu__btn ie-eu__btn--secondary" href="#especificaciones">{{ section.settings.secondary_label }}</a>
        </div>
        {% if section.settings.phone != blank %}
          <p class="ie-eu-hero__contact">¿Prefieres hablarlo? <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a></p>
        {% endif %}
      </div>
    </div>
  </div>

  <nav class="ie-eu-nav" aria-label="Contenido de {{ eu_name | escape }}">
    <div class="ie-eu__wrap">
      <ul class="ie-eu-nav__list">
        <li><a href="#planta">Planta</a></li>
        <li><a href="#especificaciones">Especificaciones</a></li>
        <li><a href="#opciones">Opciones</a></li>
        <li><a href="#alcance">Qué incluye</a></li>
        <li><a href="#compra">Compra e instalación</a></li>
        <li><a href="#documentacion">Documentación</a></li>
        <li><a href="#preguntas">Preguntas</a></li>
      </ul>
    </div>
  </nav>

  <div class="ie-eu-sticky" data-eu-sticky aria-hidden="true">
    <div>
      <span class="ie-eu-sticky__name">{{ eu_name | escape }}</span>
      <span class="ie-eu-sticky__price">{% if eu_has_price %}Desde {{ product.price | money }}{% else %}{{ section.settings.price_on_request }}{% endif %}</span>
    </div>
    <a class="ie-eu__btn ie-eu__btn--primary" href="{{ eu_quote }}" tabindex="-1">Presupuesto</a>
  </div>
</div>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

<script>
  (() => {
    const init = () => {
    const root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    const stage = root.querySelector('[data-eu-stage]');
    const main = root.querySelector('[data-eu-main]');
    const badge = root.querySelector('[data-eu-badge]');
    const thumbs = root.querySelectorAll('.ie-eu-hero__thumb');
    const setDrawing = (on) => {
      stage && stage.classList.toggle('is-contain', on);
      if (badge) badge.hidden = on;
    };
    if (stage) setDrawing(stage.classList.contains('is-contain'));
    thumbs.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!main) return;
        main.removeAttribute('srcset');
        main.src = btn.dataset.euSrc;
        main.alt = btn.dataset.euAlt;
        setDrawing(btn.dataset.euDrawing === 'true');
        thumbs.forEach((t) => {
          const on = t === btn;
          t.classList.toggle('is-selected', on);
          t.setAttribute('aria-pressed', String(on));
        });
      });
    });

    const links = [...root.querySelectorAll('.ie-eu-nav__list a')];
    const sticky = root.querySelector('[data-eu-sticky]');
    const actions = root.querySelector('.ie-eu-hero__actions');
    if (!('IntersectionObserver' in window)) return;
    if (sticky && actions) {
      new IntersectionObserver(([entry]) => {
        const show = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        sticky.classList.toggle('is-visible', show);
        sticky.setAttribute('aria-hidden', String(!show));
        sticky.querySelector('a').tabIndex = show ? 0 : -1;
      }).observe(actions);
    }
    const targets = links.map((a) => document.querySelector(a.getAttribute('href'))).filter(Boolean);
    links.forEach((a) => { if (!document.querySelector(a.getAttribute('href'))) a.parentElement.hidden = true; });
    const spy = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        links.forEach((a) => a.classList.toggle('is-active', a.getAttribute('href') === '#' + entry.target.id));
      });
    }, { rootMargin: '-45% 0px -50% 0px' });
    targets.forEach((t) => spy.observe(t));
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>

{% schema %}
{
  "name": "Europeo · galería y datos",
  "class": "ie-eu-section",
  "settings": [
    { "type": "header", "content": "Enlaces" },
    { "type": "url", "id": "quote_link", "label": "Enlace de presupuesto" },
    { "type": "text", "id": "phone", "label": "Teléfono de contacto", "default": "+34 916 99 60 93" },
    { "type": "header", "content": "Textos comunes" },
    { "type": "text", "id": "data_label", "label": "Título del bloque de datos", "default": "Datos del modelo" },
    { "type": "text", "id": "render_badge", "label": "Etiqueta sobre imágenes render", "info": "Vacío para ocultar. No se muestra sobre planos.", "default": "Render" },
    { "type": "textarea", "id": "image_note", "label": "Nota de imágenes", "default": "Imágenes ilustrativas. El entorno, el mobiliario, la iluminación y el equipamiento no forman parte del modelo." },
    { "type": "header", "content": "Precio" },
    { "type": "textarea", "id": "price_note", "label": "Alcance del precio publicado", "default": "Kit de madera en su configuración de referencia. Transporte, descarga y montaje se presupuestan aparte." },
    { "type": "text", "id": "price_on_request", "label": "Texto sin precio publicado", "default": "Presupuesto según configuración" },
    { "type": "textarea", "id": "price_on_request_note", "label": "Nota sin precio publicado", "default": "La propuesta se prepara según la configuración elegida, la ubicación y los servicios necesarios. Transporte, descarga y montaje se valoran por separado." },
    { "type": "header", "content": "Botones" },
    { "type": "text", "id": "primary_label", "label": "Botón principal", "default": "Solicitar presupuesto" },
    { "type": "text", "id": "secondary_label", "label": "Botón secundario", "default": "Consultar detalles técnicos" }
  ],
  "presets": [{ "name": "Europeo · galería y datos" }]
}
{% endschema %}
