{{ 'ie-services-page.css' | asset_url | stylesheet_tag }}
{% if section.settings.style_variant == 'pergola' %}{{ 'ie-pergola-page.css' | asset_url | stylesheet_tag }}{% endif %}
{% comment %}IE breadcrumb renderer synced{% endcomment %}

<section class="ie-services ie-services--hero{% if section.settings.style_variant == 'pergola' %} ie-services--pergola{% endif %}" aria-labelledby="ie-services-title-{{ section.id }}">
  <div class="ie-services__inner">
    {% render 'ie-breadcrumb', breadcrumb_object: page, current_title: page.title, class_name: 'ie-services__breadcrumb' %}

    <div class="ie-services__hero">
      <div class="ie-services__hero-copy">
        {% if section.settings.eyebrow != blank %}
          <p class="ie-services__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        <h1 id="ie-services-title-{{ section.id }}">{{ section.settings.heading }}</h1>

        {% if section.settings.lead != blank %}
          <div class="ie-services__lead rte">{{ section.settings.lead }}</div>
        {% endif %}

        <div class="ie-services__actions">
          {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}
            <a class="ie-services__button ie-services__button--primary" href="{{ section.settings.primary_link }}">
              {{ section.settings.primary_label }}
            </a>
          {% endif %}

          {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
            <a class="ie-services__button ie-services__button--secondary" href="{{ section.settings.secondary_link }}">
              {{ section.settings.secondary_label }}
            </a>
          {% endif %}
        </div>
      </div>

      {% if section.blocks.size > 0 %}
        <aside class="ie-services__hero-summary" aria-label="{{ section.settings.summary_title | escape }}">
          {% if section.settings.summary_title != blank %}
            <p class="ie-services__summary-title">{{ section.settings.summary_title }}</p>
          {% endif %}
          <ol class="ie-services__summary-list">
            {% for block in section.blocks %}
              <li {{ block.shopify_attributes }}>
                <span>{{ block.settings.number }}</span>
                <strong>{{ block.settings.label }}</strong>
              </li>
            {% endfor %}
          </ol>
        </aside>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Servicios · Hero",
  "settings": [
    {"type":"select","id":"style_variant","label":"Estilo","options":[{"value":"default","label":"Servicios"},{"value":"pergola","label":"Pérgola premium"}],"default":"default"},
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"Servicios para proyectos en madera"},
    {"type":"text","id":"heading","label":"Título","default":"Diseño, montaje y acompañamiento técnico para construir con claridad"},
    {"type":"richtext","id":"lead","label":"Introducción","default":"<p>Te acompañamos desde la definición inicial hasta la entrega y el mantenimiento, coordinando las decisiones técnicas que realmente condicionan el resultado: diseño, documentación, preparación de la base, montaje, protección y soporte posterior.</p>"},
    {"type":"text","id":"primary_label","label":"CTA principal","default":"Solicitar presupuesto"},
    {"type":"url","id":"primary_link","label":"Enlace CTA principal"},
    {"type":"text","id":"secondary_label","label":"CTA secundario","default":"Ver trabajos realizados"},
    {"type":"url","id":"secondary_link","label":"Enlace CTA secundario"},
    {"type":"text","id":"summary_title","label":"Título resumen","default":"Un proceso coordinado"}
  ],
  "blocks": [
    {
      "type":"summary",
      "name":"Paso resumen",
      "settings":[
        {"type":"text","id":"number","label":"Número","default":"01"},
        {"type":"text","id":"label","label":"Texto","default":"Definir el proyecto y su alcance"}
      ]
    }
  ],
  "max_blocks": 4,
  "presets":[{"name":"Servicios · Hero"}]
}
{% endschema %}
