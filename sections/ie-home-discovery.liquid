{{ 'ie-home-discovery.css' | asset_url | stylesheet_tag }}

{%- assign ie_cards = section.blocks | where: 'type', 'solution' -%}
{%- assign ie_quick_links = section.blocks | where: 'type', 'quick_link' -%}

<section
  class="ie-home-discovery"
  aria-labelledby="ie-home-discovery-title-{{ section.id }}"
  style="
    --ie-discovery-bg: {{ section.settings.background }};
    --ie-discovery-card-bg: {{ section.settings.card_background }};
    --ie-discovery-color: {{ section.settings.text_color }};
    --ie-discovery-accent: {{ section.settings.accent_color }};
    --ie-discovery-width: {{ section.settings.content_width }}px;
    --ie-discovery-gutter: {{ section.settings.side_margin }}px;
    --ie-discovery-mobile-gutter: {{ section.settings.mobile_margin }}px;
    --ie-discovery-spacing: {{ section.settings.section_spacing }}px;
    --ie-discovery-gap: {{ section.settings.card_gap }}px;
    --ie-discovery-radius: {{ section.settings.card_radius }}px;
    --ie-discovery-columns: {{ section.settings.columns }};
    --ie-discovery-image-ratio: {{ section.settings.media_ratio }};
  "
>
  <div class="page-width">
    <div class="ie-home-discovery__intro">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="ie-home-discovery__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="ie-home-discovery-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.intro != blank -%}
        <p>{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </div>

    {%- if ie_cards.size > 0 -%}
      <div class="ie-home-discovery__grid">
        {%- for block in ie_cards -%}
          {%- liquid
            assign card_image = block.settings.image
            if card_image == blank and block.settings.collection != blank
              assign card_image = block.settings.collection.featured_image
            endif
            assign card_alt = block.settings.image_alt | default: card_image.alt | default: block.settings.title
          -%}
          <article class="ie-home-discovery__card" {{ block.shopify_attributes }}>
            <div class="ie-home-discovery__media{% if card_image == blank and block.settings.show_illustration %} ie-home-discovery__media--structure{% endif %}">
              {%- if card_image != blank -%}
                {{ card_image | image_url: width: 1200 | image_tag: class: 'ie-home-discovery__image', loading: 'lazy', widths: '360, 540, 720, 960, 1200', sizes: '(min-width: 990px) 31vw, (min-width: 750px) 47vw, 92vw', alt: card_alt }}
              {%- elsif block.settings.show_illustration -%}
                <svg class="ie-home-discovery__drawing" viewBox="0 0 440 240" fill="none" aria-hidden="true" focusable="false">
                  <path d="M60 101 200 30 378 98 236 170 60 101Z" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
                  <path d="M60 101V192L236 229V170M378 98V184L236 229" stroke="currentColor" stroke-width="3"/>
                  <path d="M90 118V195M164 144V211M308 135V205M124 74 306 145M162 55 342 116M200 30V121M236 170 236 229" stroke="currentColor" stroke-width="2" opacity=".63"/>
                  <path d="M60 101 200 30 378 98M84 188 236 220 358 181" stroke="currentColor" stroke-width="7" opacity=".22"/>
                </svg>
              {%- else -%}
                <div class="ie-home-discovery__image-fallback" aria-hidden="true"></div>
              {%- endif -%}
              {%- if section.settings.show_numbers and block.settings.number != blank -%}
                <span class="ie-home-discovery__number">{{ block.settings.number | escape }}</span>
              {%- endif -%}
            </div>
            <div class="ie-home-discovery__card-body">
              {%- if block.settings.category != blank -%}
                <p class="ie-home-discovery__category">{{ block.settings.category | escape }}</p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3>{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p>{{ block.settings.description | escape | newline_to_br }}</p>
              {%- endif -%}
              {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                <a class="ie-home-discovery__card-link" href="{{ block.settings.button_link }}">
                  {{ block.settings.button_label | escape }} <span aria-hidden="true">↗</span>
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_shortcuts and ie_quick_links.size > 0 -%}
      <nav class="ie-home-discovery__quick" aria-label="Explorar por tipo de producto">
        {%- if section.settings.quick_label != blank -%}
          <p>{{ section.settings.quick_label | escape }}</p>
        {%- endif -%}
        <div class="ie-home-discovery__quick-links">
          {%- for block in ie_quick_links -%}
            {%- if block.settings.label != blank and block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </nav>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Inicio · Soluciones",
  "settings": [
    {
      "type": "header",
      "content": "Contenido de la sección"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Encuentra tu solución"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título principal",
      "default": "Madera para cada espacio"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Texto introductorio",
      "default": "Explora las familias de producto, compara modelos y elige las configuraciones disponibles antes de solicitar presupuesto."
    },
    {
      "type": "text",
      "id": "quick_label",
      "label": "Título de accesos rápidos",
      "default": "Ir directamente a"
    },
    {
      "type": "checkbox",
      "id": "show_shortcuts",
      "label": "Mostrar accesos rápidos",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Mostrar numeración de tarjetas",
      "default": true
    },
    {
      "type": "header",
      "content": "Estilo y colores"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fondo de la sección",
      "default": "#f6f6f2"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Fondo de las tarjetas",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del título",
      "default": "#243129"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color de enlaces y detalles",
      "default": "#566236"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columnas en escritorio",
      "options": [
        {
          "value": "2",
          "label": "Dos"
        },
        {
          "value": "3",
          "label": "Tres"
        }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Proporción de las imágenes",
      "options": [
        {
          "value": "8 / 5",
          "label": "Panorámica 8:5"
        },
        {
          "value": "16 / 9",
          "label": "Horizontal 16:9"
        },
        {
          "value": "4 / 3",
          "label": "Clásica 4:3"
        }
      ],
      "default": "8 / 5"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Anchura máxima (px)",
      "min": 1000,
      "max": 1680,
      "step": 20,
      "default": 1480
    },
    {
      "type": "range",
      "id": "side_margin",
      "label": "Margen lateral escritorio (px)",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "mobile_margin",
      "label": "Margen lateral móvil (px)",
      "min": 12,
      "max": 32,
      "step": 2,
      "default": 18
    },
    {
      "type": "range",
      "id": "section_spacing",
      "label": "Espaciado vertical (px)",
      "min": 36,
      "max": 108,
      "step": 4,
      "default": 68
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Separación entre tarjetas (px)",
      "min": 12,
      "max": 40,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Redondeo de tarjetas (px)",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "solution",
      "name": "Tarjeta de solución",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Número de la tarjeta",
          "default": "01"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Categoría",
          "default": "Jardín y terraza"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Exterior"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Descripción",
          "default": "Pérgolas, porches, cenadores y tarimas para disfrutar y proteger el espacio al aire libre."
        },
        {
          "type": "header",
          "content": "Imagen"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen propia",
          "info": "Tiene prioridad sobre la imagen automática de la colección."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección para imagen automática",
          "info": "Se utiliza su imagen destacada cuando no hay imagen propia."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Texto alternativo (SEO)",
          "info": "Describe la imagen sin repetir palabras clave."
        },
        {
          "type": "checkbox",
          "id": "show_illustration",
          "label": "Mostrar esquema si no hay imagen",
          "default": false
        },
        {
          "type": "header",
          "content": "Acción comercial"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del enlace",
          "default": "Ver soluciones"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Enlace de destino"
        }
      ]
    },
    {
      "type": "quick_link",
      "name": "Acceso rápido",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Texto del enlace",
          "default": "Ver productos"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Destino"
        }
      ]
    }
  ],
  "max_blocks": 18,
  "presets": [
    {
      "name": "Inicio · Soluciones",
      "blocks": [
        {
          "type": "solution",
          "settings": {
            "number": "01",
            "category": "Jardín y terraza",
            "title": "Exterior",
            "description": "Pérgolas, porches, cenadores y tarimas para disfrutar y proteger el espacio al aire libre.",
            "collection": "wooden-gazebos",
            "image_alt": "Cenador de madera para jardín",
            "button_label": "Ver soluciones de exterior",
            "button_link": "/collections/wooden-gazebos"
          }
        },
        {
          "type": "solution",
          "settings": {
            "number": "02",
            "category": "Vivienda y espacio adicional",
            "title": "Habitables",
            "description": "Casas, casetas, estudios y oficinas de jardín con soluciones y acabados definidos por modelo.",
            "collection": "sip-panel-houses",
            "image_alt": "Vivienda de madera con paneles SIP",
            "button_label": "Comparar casas y modelos",
            "button_link": "/collections/sip-panel-houses"
          }
        },
        {
          "type": "solution",
          "settings": {
            "number": "03",
            "category": "Construcción en madera",
            "title": "Estructuras",
            "description": "Estructuras, cubiertas y soluciones técnicas para proyectos que requieren definir apoyos, cargas y montaje.",
            "show_illustration": true,
            "button_label": "Conocer nuestros servicios",
            "button_link": "/pages/services"
          }
        },
        {
          "type": "quick_link",
          "settings": {
            "label": "Pérgolas",
            "link": "/pages/bespoke-wooden-pergolas"
          }
        },
        {
          "type": "quick_link",
          "settings": {
            "label": "Porches",
            "link": "/pages/bespoke-wooden-porches"
          }
        },
        {
          "type": "quick_link",
          "settings": {
            "label": "Cenadores",
            "link": "/collections/wooden-gazebos"
          }
        },
        {
          "type": "quick_link",
          "settings": {
            "label": "Casas SIP",
            "link": "/collections/sip-panel-houses"
          }
        },
        {
          "type": "quick_link",
          "settings": {
            "label": "Entramado ligero",
            "link": "/collections/light-frame-houses"
          }
        },
        {
          "type": "quick_link",
          "settings": {
            "label": "Todos los productos",
            "link": "/pages/timber-products"
          }
        }
      ]
    }
  ]
}
{% endschema %}
