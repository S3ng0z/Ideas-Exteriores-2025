<section class="ie-about ie-about--cta" aria-labelledby="ie-about-cta-title-{{ section.id }}">
  <div class="ie-about__inner">
    <div class="ie-about__closing">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="ie-about__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 id="ie-about-cta-title-{{ section.id }}">{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}
          <div class="rte">{{ section.settings.text }}</div>
        {% endif %}
      </div>

      <div class="ie-about__actions">
        {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}
          <a class="ie-about__button ie-about__button--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
        {% endif %}
        {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
          <a class="ie-about__button ie-about__button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Nosotros · Cierre",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"Siguiente paso"},
    {"type":"text","id":"heading","label":"Título","default":"Elige una solución y avancemos con un alcance claro"},
    {"type":"richtext","id":"text","label":"Texto","default":"<p>Explora nuestros productos y servicios o cuéntanos qué espacio necesitas. Te orientaremos hacia la opción y el nivel de intervención más adecuados.</p>"},
    {"type":"text","id":"primary_label","label":"CTA principal","default":"Ver productos"},
    {"type":"url","id":"primary_link","label":"Enlace CTA principal"},
    {"type":"text","id":"secondary_label","label":"CTA secundario","default":"Hablar con el equipo"},
    {"type":"url","id":"secondary_link","label":"Enlace CTA secundario"}
  ],
  "presets":[{"name":"Nosotros · Cierre"}]
}
{% endschema %}
