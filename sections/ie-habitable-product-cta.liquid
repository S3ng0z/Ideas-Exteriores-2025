<section class="ie-hab-pdp ie-hab-pdp--cta" aria-labelledby="ie-hab-cta-title-{{ section.id }}">
  <div class="ie-hab-pdp__inner">
    <div class="ie-hab-pdp__closing">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="ie-hab-pdp__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2 id="ie-hab-cta-title-{{ section.id }}">{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}<div class="ie-hab-pdp__closing-text rte">{{ section.settings.text }}</div>{% endif %}
      </div>
      <div class="ie-hab-pdp__actions">
        {% if section.settings.primary_link != blank %}<a class="ie-hab-pdp__button ie-hab-pdp__button--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>{% endif %}
        {% if section.settings.secondary_link != blank %}<a class="ie-hab-pdp__button ie-hab-pdp__button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>{% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name":"IE · Habitable · CTA",
  "enabled_on":{"templates":["product"]},
  "settings":[
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"Siguiente paso"},
    {"type":"text","id":"heading","label":"Título","default":"¿Quieres validar este modelo para tu proyecto?"},
    {"type":"richtext","id":"text","label":"Texto","default":"<p>Indícanos el modelo, la ubicación y el punto en el que se encuentra tu proyecto. Con esa base podremos orientar el siguiente paso con más precisión.</p>"},
    {"type":"text","id":"primary_label","label":"CTA principal","default":"Hablar con el equipo"},
    {"type":"url","id":"primary_link","label":"Enlace CTA principal"},
    {"type":"text","id":"secondary_label","label":"CTA secundario","default":"Cómo trabajamos"},
    {"type":"url","id":"secondary_link","label":"Enlace CTA secundario"}
  ],
  "presets":[{"name":"IE · Habitable · CTA"}]
}
{% endschema %}
