<section class="ie-project ie-project--cta" aria-labelledby="ie-project-cta-title-{{ section.id }}"><div class="ie-project__inner"><div class="ie-project__closing">
  <div>{% if section.settings.eyebrow != blank %}<p class="ie-project__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}<h2 id="ie-project-cta-title-{{ section.id }}">{{ section.settings.heading }}</h2>{% if section.settings.text != blank %}<div class="ie-project__closing-text rte">{{ section.settings.text }}</div>{% endif %}</div>
  {% if section.settings.label != blank and section.settings.link != blank %}<a class="ie-project__button ie-project__button--primary" href="{{ section.settings.link }}">{{ section.settings.label }}</a>{% endif %}
</div></div></section>
{% schema %}
{"name":"Proyectos y licencias · CTA","settings":[{"type":"text","id":"eyebrow","label":"Antetítulo","default":"Siguiente paso"},{"type":"text","id":"heading","label":"Título","default":"Antes de invertir en planos, confirma el encaje de tu proyecto"},{"type":"richtext","id":"text","label":"Texto","default":"<p>Indícanos municipio, parcela, uso previsto, dimensiones aproximadas y la información que ya tengas. Te ayudaremos a identificar qué revisar y qué documentación necesitará el siguiente paso.</p>"},{"type":"text","id":"label","label":"CTA","default":"Solicitar revisión de viabilidad"},{"type":"url","id":"link","label":"Enlace CTA"}],"presets":[{"name":"Proyectos y licencias · CTA"}]}
{% endschema %}