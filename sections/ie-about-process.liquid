<section class="ie-about ie-about--process" aria-labelledby="ie-about-process-title-{{ section.id }}">
  <div class="ie-about__inner">
    <div class="ie-about__process">
      <div class="ie-about__process-intro">
        {% if section.settings.eyebrow != blank %}
          <p class="ie-about__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 id="ie-about-process-title-{{ section.id }}">{{ section.settings.heading }}</h2>
        {% if section.settings.intro != blank %}
          <div class="rte">{{ section.settings.intro }}</div>
        {% endif %}
      </div>

      <ol class="ie-about__process-list">
        {% for block in section.blocks %}
          <li class="ie-about__process-step" {{ block.shopify_attributes }}>
            <span class="ie-about__process-number">{{ block.settings.number }}</span>
            <div>
              <h3>{{ block.settings.heading }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </li>
        {% endfor %}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Nosotros · Método",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"Cómo trabajamos"},
    {"type":"text","id":"heading","label":"Título","default":"De la necesidad a una solución ejecutable"},
    {"type":"richtext","id":"intro","label":"Introducción","default":"<p>Ordenamos las decisiones para reducir incertidumbre y convertir una necesidad en un proyecto con alcance, sistema y siguiente paso definidos.</p>"}
  ],
  "blocks":[
    {
      "type":"step",
      "name":"Paso",
      "settings":[
        {"type":"text","id":"number","label":"Número","default":"01"},
        {"type":"text","id":"heading","label":"Título","default":"Entender"},
        {"type":"textarea","id":"text","label":"Texto","default":"Partimos del uso, la ubicación, las medidas y las condiciones reales del proyecto."}
      ]
    }
  ],
  "max_blocks":6,
  "presets":[{"name":"Nosotros · Método"}]
}
{% endschema %}
