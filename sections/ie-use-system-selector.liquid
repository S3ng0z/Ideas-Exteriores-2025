{{ 'ie-use-system-selector.css' | asset_url | stylesheet_tag }}
<section class="ie-use" id="selector-por-uso" aria-labelledby="ie-use-title-{{ section.id }}">
  <div class="ie-use__inner">
    <header class="ie-use__intro">
      <div>
        <p class="ie-use__eyebrow">{{ section.settings.use_kicker | escape }}</p>
        <h2 id="ie-use-title-{{ section.id }}">{{ section.settings.use_title | escape }}</h2>
      </div>
      <div class="ie-use__lead rte">{{ section.settings.use_intro }}</div>
    </header>

    <div class="ie-use__options">
      {% for block in section.blocks %}
        {% if block.type == 'use' %}
          <details class="ie-use__option" {% if block.settings.use_key == 'residential' %}open{% endif %} {{ block.shopify_attributes }}>
            <summary>
              <span class="ie-use__number">{{ block.settings.number | escape }}</span>
              <span class="ie-use__option-copy">
                <strong>{{ block.settings.title | escape }}</strong>
                <small>{{ block.settings.subtitle | escape }}</small>
              </span>
              <span class="ie-use__plus" aria-hidden="true"></span>
            </summary>
            <div class="ie-use__option-body">
              <p>{{ block.settings.description | escape }}</p>
              <div class="ie-use__option-details">
                <div>
                  <h3>{{ section.settings.systems_label | escape }}</h3>
                  <p>{{ block.settings.systems | escape }}</p>
                </div>
                <div>
                  <h3>{{ section.settings.checks_label | escape }}</h3>
                  <p>{{ block.settings.checks | escape }}</p>
                </div>
              </div>
              {% if block.settings.link != blank %}
                <a class="ie-use__text-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">↗</span></a>
              {% endif %}
            </div>
          </details>
        {% endif %}
      {% endfor %}
    </div>

    <section class="ie-use__section" id="usos-y-sistemas" aria-labelledby="ie-use-table-title-{{ section.id }}">
      <header class="ie-use__section-head">
        <div>
          <p class="ie-use__eyebrow">{{ section.settings.table_kicker | escape }}</p>
          <h2 id="ie-use-table-title-{{ section.id }}">{{ section.settings.table_title | escape }}</h2>
        </div>
        <div class="ie-use__lead rte">{{ section.settings.table_intro }}</div>
      </header>
      <div class="ie-use__table-wrap" role="region" tabindex="0" aria-label="{{ section.settings.table_accessibility | escape }}">
        <table class="ie-use__table">
          <caption>{{ section.settings.table_caption | escape }}</caption>
          <thead><tr>
            <th scope="col">{{ section.settings.table_use | escape }}</th>
            <th scope="col">{{ section.settings.table_systems | escape }}</th>
            <th scope="col">{{ section.settings.table_conditions | escape }}</th>
          </tr></thead>
          <tbody>
            {% for block in section.blocks %}
              {% if block.type == 'use' %}
                <tr>
                  <th scope="row">{{ block.settings.title | escape }}</th>
                  <td>{{ block.settings.table_systems | escape }}</td>
                  <td>{{ block.settings.table_checks | escape }}</td>
                </tr>
              {% endif %}
            {% endfor %}
          </tbody>
        </table>
      </div>
      <p class="ie-use__note">{{ section.settings.table_note | escape }}</p>
    </section>

    <section class="ie-use__section" id="nivel-de-confort" aria-labelledby="ie-use-comfort-title-{{ section.id }}">
      <header class="ie-use__section-head">
        <div>
          <p class="ie-use__eyebrow">{{ section.settings.comfort_kicker | escape }}</p>
          <h2 id="ie-use-comfort-title-{{ section.id }}">{{ section.settings.comfort_title | escape }}</h2>
        </div>
        <div class="ie-use__lead rte">{{ section.settings.comfort_intro }}</div>
      </header>
      <div class="ie-use__comfort">
        {% for block in section.blocks %}
          {% if block.type == 'comfort' %}
            <article {{ block.shopify_attributes }}>
              <h3>{{ block.settings.title | escape }}</h3>
              <p>{{ block.settings.text | escape }}</p>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </section>

    <section class="ie-use__section" id="parcela-y-ubicacion" aria-labelledby="ie-use-site-title-{{ section.id }}">
      <header class="ie-use__section-head">
        <div>
          <p class="ie-use__eyebrow">{{ section.settings.site_kicker | escape }}</p>
          <h2 id="ie-use-site-title-{{ section.id }}">{{ section.settings.site_title | escape }}</h2>
        </div>
        <div class="ie-use__lead rte">{{ section.settings.site_intro }}</div>
      </header>
      <ul class="ie-use__checklist">
        {% for block in section.blocks %}
          {% if block.type == 'site_check' %}
            <li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
          {% endif %}
        {% endfor %}
      </ul>
      <p class="ie-use__note">{{ section.settings.site_note | escape }}</p>
    </section>

    <section class="ie-use__section" id="modelos-de-referencia" aria-labelledby="ie-use-models-title-{{ section.id }}">
      <header class="ie-use__section-head">
        <div>
          <p class="ie-use__eyebrow">{{ section.settings.models_kicker | escape }}</p>
          <h2 id="ie-use-models-title-{{ section.id }}">{{ section.settings.models_title | escape }}</h2>
        </div>
        <div class="ie-use__lead rte">{{ section.settings.models_intro }}</div>
      </header>
      {% assign ie_groups = 'home,office,shed' | split: ',' %}
      {% for ie_group in ie_groups %}
        {% case ie_group %}
          {% when 'home' %}{% assign group_title = section.settings.group_home %}
          {% when 'office' %}{% assign group_title = section.settings.group_office %}
          {% when 'shed' %}{% assign group_title = section.settings.group_shed %}
        {% endcase %}
        <div class="ie-use__model-group">
          <h3>{{ group_title | escape }}</h3>
          <div class="ie-use__models">
            {% assign ie_any_model = false %}
            {% for block in section.blocks %}
              {% if block.type == 'model' and block.settings.group == ie_group %}
                {% assign ie_product = block.settings.product %}
                {% if ie_product != blank %}
                  {% assign ie_any_model = true %}
                  <article class="ie-use__model" {{ block.shopify_attributes }}>
                    <a class="ie-use__model-image" href="{{ ie_product.url }}" aria-label="{{ ie_product.title | escape }}">
                      {% if ie_product.featured_image != blank %}
                        {{ ie_product.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '320, 500, 720', sizes: '(min-width: 990px) 24vw, (min-width: 750px) 46vw, 100vw', alt: ie_product.title }}
                      {% else %}
                        <span>{{ section.settings.no_image | escape }}</span>
                      {% endif %}
                    </a>
                    <div class="ie-use__model-content">
                      <p class="ie-use__model-type">{{ block.settings.label | escape }}</p>
                      <h4>{{ ie_product.title | escape }}</h4>
                      <p>{{ section.settings.model_caution | escape }}</p>
                      <a class="ie-use__text-link" href="{{ ie_product.url }}">{{ section.settings.model_link_label | escape }} <span aria-hidden="true">↗</span></a>
                    </div>
                  </article>
                {% endif %}
              {% endif %}
            {% endfor %}
            {% unless ie_any_model %}
              <p class="ie-use__note">{{ section.settings.models_empty | escape }}</p>
            {% endunless %}
          </div>
        </div>
      {% endfor %}
      <p class="ie-use__note">{{ section.settings.models_note | escape }}</p>
      {% if section.settings.compare_link != blank %}
        <a class="ie-use__text-link ie-use__compare-link" href="{{ section.settings.compare_link }}">{{ section.settings.compare_label | escape }} <span aria-hidden="true">↗</span></a>
      {% endif %}
    </section>

    <section class="ie-use__section" id="pasos-presupuesto" aria-labelledby="ie-use-process-title-{{ section.id }}">
      <header class="ie-use__section-head">
        <div>
          <p class="ie-use__eyebrow">{{ section.settings.process_kicker | escape }}</p>
          <h2 id="ie-use-process-title-{{ section.id }}">{{ section.settings.process_title | escape }}</h2>
        </div>
        <div class="ie-use__lead rte">{{ section.settings.process_intro }}</div>
      </header>
      <ol class="ie-use__steps">
        {% for block in section.blocks %}
          {% if block.type == 'step' %}
            <li {{ block.shopify_attributes }}>
              <span class="ie-use__number" aria-hidden="true">{{ block.settings.number | escape }}</span>
              <h3>{{ block.settings.title | escape }}</h3>
              <p>{{ block.settings.description | escape }}</p>
            </li>
          {% endif %}
        {% endfor %}
      </ol>
    </section>

    <section class="ie-use__section" id="preguntas-sobre-uso" aria-labelledby="ie-use-faq-title-{{ section.id }}">
      <header class="ie-use__section-head">
        <div>
          <p class="ie-use__eyebrow">{{ section.settings.faq_kicker | escape }}</p>
          <h2 id="ie-use-faq-title-{{ section.id }}">{{ section.settings.faq_title | escape }}</h2>
        </div>
        <div class="ie-use__lead rte">{{ section.settings.faq_intro }}</div>
      </header>
      <div class="ie-use__faq">
        {% for block in section.blocks %}
          {% if block.type == 'faq' %}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question | escape }} <span class="ie-use__plus" aria-hidden="true"></span></summary>
              <p>{{ block.settings.answer | escape }}</p>
            </details>
          {% endif %}
        {% endfor %}
      </div>
    </section>

    <nav class="ie-use__resources" aria-label="{{ section.settings.resources_label | escape }}">
      <h2>{{ section.settings.resources_title | escape }}</h2>
      {% if section.settings.link_european != blank %}<a href="{{ section.settings.link_european }}">{{ section.settings.label_european | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
      {% if section.settings.link_frame != blank %}<a href="{{ section.settings.link_frame }}">{{ section.settings.label_frame | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
      {% if section.settings.link_sip != blank %}<a href="{{ section.settings.link_sip }}">{{ section.settings.label_sip | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
    </nav>
    <p class="ie-use__disclaimer">{{ section.settings.legal_note | escape }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Elegir por uso · Guía",
  "settings": [
    {"type":"text","id":"use_kicker","label":"Antetítulo · Usos","default":"01 · Tipo de proyecto"},
    {"type":"text","id":"use_title","label":"Título · Usos","default":"¿Qué quieres construir?"},
    {"type":"richtext","id":"use_intro","label":"Introducción · Usos","default":"<p>Selecciona un uso para conocer alternativas y comprobaciones relevantes. Son orientaciones iniciales, no aprobaciones de modelos o parcelas.</p>"},
    {"type":"text","id":"systems_label","label":"Título alternativas","default":"Sistemas que conviene estudiar"},
    {"type":"text","id":"checks_label","label":"Título comprobaciones","default":"Qué debemos comprobar"},
    {"type":"text","id":"table_kicker","label":"Antetítulo · Tabla","default":"02 · Comparación por uso"},
    {"type":"text","id":"table_title","label":"Título · Tabla","default":"Una orientación para iniciar el estudio"},
    {"type":"richtext","id":"table_intro","label":"Introducción · Tabla","default":"<p>La tabla resume alternativas iniciales. No determina compatibilidad legal, técnica o comercial de un producto concreto.</p>"},
    {"type":"text","id":"table_accessibility","label":"Accesibilidad tabla","default":"Tabla comparativa desplazable horizontalmente"},
    {"type":"text","id":"table_caption","label":"Descripción tabla","default":"Alternativas iniciales y criterios según el uso previsto"},
    {"type":"text","id":"table_use","label":"Columna uso","default":"Uso previsto"},
    {"type":"text","id":"table_systems","label":"Columna alternativas","default":"Alternativas iniciales"},
    {"type":"text","id":"table_conditions","label":"Columna criterios","default":"Qué determina la elección"},
    {"type":"textarea","id":"table_note","label":"Nota tabla","default":"El uso previsto y el destino urbanístico se comprueban antes de atribuir aptitud residencial o profesional a un producto."},
    {"type":"text","id":"comfort_kicker","label":"Antetítulo · Confort","default":"03 · Necesidades de confort"},
    {"type":"text","id":"comfort_title","label":"Título · Confort","default":"El uso determina qué conviene evaluar"},
    {"type":"richtext","id":"comfort_intro","label":"Introducción · Confort","default":"<p>La frecuencia de ocupación influye en las necesidades prácticas, pero no determina por sí sola la normativa aplicable.</p>"},
    {"type":"text","id":"site_kicker","label":"Antetítulo · Parcela","default":"04 · Emplazamiento"},
    {"type":"text","id":"site_title","label":"Título · Parcela","default":"La parcela también condiciona la elección"},
    {"type":"richtext","id":"site_intro","label":"Introducción · Parcela","default":"<p>El terreno, los accesos y las condiciones urbanísticas pueden modificar el diseño, el montaje y el presupuesto.</p>"},
    {"type":"textarea","id":"site_note","label":"Nota parcela","default":"La prefabricación, el tamaño reducido o un uso auxiliar no suponen automáticamente exención de permisos o de las comprobaciones aplicables."},
    {"type":"text","id":"models_kicker","label":"Antetítulo · Modelos","default":"05 · Referencias del catálogo"},
    {"type":"text","id":"models_title","label":"Título · Modelos","default":"De tu necesidad a un modelo real"},
    {"type":"richtext","id":"models_intro","label":"Introducción · Modelos","default":"<p>Estos productos activos son ejemplos de partida. Su disponibilidad, configuración y adecuación al uso deben confirmarse antes de proponerlos para una parcela.</p>"},
    {"type":"text","id":"group_home","label":"Grupo viviendas","default":"Modelos de vivienda"},
    {"type":"text","id":"group_office","label":"Grupo oficinas","default":"Estudios y oficinas"},
    {"type":"text","id":"group_shed","label":"Grupo casetas","default":"Casetas y usos auxiliares"},
    {"type":"text","id":"no_image","label":"Texto sin imagen","default":"Consultar modelo"},
    {"type":"text","id":"model_link_label","label":"Enlace a ficha","default":"Ver modelo y alcance"},
    {"type":"textarea","id":"model_caution","label":"Aviso por modelo","default":"Referencia comercial. El uso, las prestaciones y el alcance requieren confirmación."},
    {"type":"textarea","id":"models_empty","label":"Sin modelos","default":"No hay referencias seleccionadas para esta categoría. Consulta las opciones con el equipo."},
    {"type":"textarea","id":"models_note","label":"Nota modelos","default":"Las dimensiones, superficies, materiales, precios y opciones deberán contrastarse con la ficha vigente y la documentación técnica del producto. Un precio publicado no equivale por sí solo al coste final."},
    {"type":"text","id":"compare_label","label":"Texto comparar","default":"Conocer las diferencias entre sistemas"},
    {"type":"url","id":"compare_link","label":"Enlace comparar"},
    {"type":"text","id":"process_kicker","label":"Antetítulo · Proceso","default":"06 · Solicitud de propuesta"},
    {"type":"text","id":"process_title","label":"Título · Proceso","default":"Del uso previsto a un presupuesto claro"},
    {"type":"richtext","id":"process_intro","label":"Introducción · Proceso","default":"<p>Separamos la orientación inicial de las verificaciones necesarias para cerrar una oferta.</p>"},
    {"type":"text","id":"faq_kicker","label":"Antetítulo · FAQ","default":"07 · Preguntas habituales"},
    {"type":"text","id":"faq_title","label":"Título · FAQ","default":"Preguntas frecuentes"},
    {"type":"richtext","id":"faq_intro","label":"Introducción · FAQ","default":"<p>Respuestas sencillas a las dudas más habituales sobre uso, modelos y presupuesto.</p>"},
    {"type":"text","id":"resources_label","label":"Accesibilidad recursos","default":"Guías técnicas de los sistemas constructivos"},
    {"type":"text","id":"resources_title","label":"Título recursos","default":"Conoce los sistemas constructivos"},
    {"type":"text","id":"label_european","label":"Texto europeo","default":"Sistema Europeo"},
    {"type":"url","id":"link_european","label":"Enlace europeo"},
    {"type":"text","id":"label_frame","label":"Texto entramado","default":"Entramado Ligero"},
    {"type":"url","id":"link_frame","label":"Enlace entramado"},
    {"type":"text","id":"label_sip","label":"Texto SIP","default":"Paneles SIP"},
    {"type":"url","id":"link_sip","label":"Enlace SIP"},
    {"type":"textarea","id":"legal_note","label":"Nota final","default":"Esta guía es orientativa. Las recomendaciones no sustituyen la verificación urbanística, estructural o de prestaciones. La disponibilidad y las configuraciones de cada modelo se confirman antes de emitir una oferta."}
  ],
  "blocks": [
    {"type":"use","name":"Uso del proyecto","settings":[
      {"type":"select","id":"use_key","label":"Identificador","options":[{"value":"residential","label":"Vivienda habitual"},{"value":"second","label":"Segunda residencia"},{"value":"office","label":"Oficina o estudio"},{"value":"shed","label":"Caseta"},{"value":"extension","label":"Ampliación"},{"value":"other","label":"Otro"}],"default":"residential"},
      {"type":"text","id":"number","label":"Número","default":"01"},
      {"type":"text","id":"title","label":"Nombre del uso","default":"Vivienda habitual"},
      {"type":"text","id":"subtitle","label":"Descripción corta","default":"Construcción para uso residencial permanente"},
      {"type":"textarea","id":"description","label":"Descripción principal","default":"El uso residencial exige justificar la solución real y cumplir la normativa aplicable."},
      {"type":"textarea","id":"systems","label":"Sistemas iniciales","default":"Entramado, SIP y modelos europeos documentados según proyecto."},
      {"type":"textarea","id":"checks","label":"Qué comprobar","default":"Parcela, estructura, envolvente, instalaciones y presupuesto."},
      {"type":"textarea","id":"table_systems","label":"Alternativas en tabla","default":"Entramado, SIP y europeo documentado"},
      {"type":"textarea","id":"table_checks","label":"Criterios en tabla","default":"Uso, prestaciones, proyecto y coste"},
      {"type":"text","id":"link_label","label":"Texto del enlace","default":"Explorar opciones"},
      {"type":"url","id":"link","label":"Destino del enlace"}]},
    {"type":"comfort","name":"Nivel de confort","settings":[
      {"type":"text","id":"title","label":"Tipo de uso","default":"Uso frecuente"},
      {"type":"textarea","id":"text","label":"Detalle","default":"Comprobar aislamiento, ventilación y acondicionamiento según actividad."}]},
    {"type":"site_check","name":"Requisito de parcela","settings":[
      {"type":"text","id":"text","label":"Comprobación","default":"Municipio y planeamiento urbanístico"}]},
    {"type":"model","name":"Producto de referencia","settings":[
      {"type":"product","id":"product","label":"Producto del catálogo"},
      {"type":"select","id":"group","label":"Grupo del modelo","options":[{"value":"home","label":"Viviendas"},{"value":"office","label":"Estudios y oficinas"},{"value":"shed","label":"Casetas auxiliares"}],"default":"home"},
      {"type":"text","id":"label","label":"Tipo comercial","default":"Modelo de referencia"}]},
    {"type":"step","name":"Paso para presupuesto","settings":[
      {"type":"text","id":"number","label":"Número","default":"01"},
      {"type":"text","id":"title","label":"Paso","default":"Definir el uso"},
      {"type":"textarea","id":"description","label":"Descripción","default":"Identificamos la finalidad y la frecuencia de utilización."}]},
    {"type":"faq","name":"Pregunta frecuente","settings":[
      {"type":"text","id":"question","label":"Pregunta","default":"¿Qué sistema conviene estudiar?"},
      {"type":"textarea","id":"answer","label":"Respuesta","default":"Depende del modelo, el uso previsto, la parcela y el proyecto."}]}
  ],
  "max_blocks": 50,
  "presets": [{"name":"Elegir por uso · Guía"}]
}
{% endschema %}