{{ 'ie-pergola-page.css' | asset_url | stylesheet_tag }}

<section class="ie-pergola ie-pergola--details" aria-labelledby="ie-pergola-details-title-{{ section.id }}">
  <div class="ie-pergola__inner">
    <div class="ie-pergola__section-head">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="ie-pergola__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 id="ie-pergola-details-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.intro != blank %}
        <div class="ie-pergola__intro rte">{{ section.settings.intro }}</div>
      {% endif %}
    </div>

    <div class="ie-pergola__features">
      {% for block in section.blocks %}
        <article class="ie-pergola__feature ie-pergola__feature--media-{{ block.settings.media_position }}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <div class="ie-pergola__feature-media">
              {{
                block.settings.image
                | image_url: width: 1800
                | image_tag:
                  widths: '640, 900, 1200, 1500, 1800',
                  sizes: '(min-width: 990px) 50vw, 100vw',
                  loading: 'lazy',
                  alt: block.settings.image_alt
              }}
            </div>
          {% endif %}

          <div class="ie-pergola__feature-copy">
            {% if block.settings.index != blank %}
              <p class="ie-pergola__feature-index">{{ block.settings.index }}</p>
            {% endif %}
            <h3>{{ block.settings.heading }}</h3>
            {% if block.settings.text != blank %}
              <div class="ie-pergola__feature-text rte">{{ block.settings.text }}</div>
            {% endif %}

            {% if block.settings.point_1 != blank or block.settings.point_2 != blank or block.settings.point_3 != blank %}
              <ul class="ie-pergola__points" role="list">
                {% if block.settings.point_1 != blank %}<li>{{ block.settings.point_1 }}</li>{% endif %}
                {% if block.settings.point_2 != blank %}<li>{{ block.settings.point_2 }}</li>{% endif %}
                {% if block.settings.point_3 != blank %}<li>{{ block.settings.point_3 }}</li>{% endif %}
              </ul>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Pérgola · Detalles",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"Diseño y construcción"},
    {"type":"text","id":"heading","label":"Título","default":"Las decisiones que hacen que una pérgola funcione de verdad"},
    {"type":"richtext","id":"intro","label":"Introducción","default":"<p>Una solución a medida no empieza por elegir un modelo: empieza por entender el espacio, el soporte, la exposición y el uso previsto. A partir de ahí definimos estructura, cubierta, anclajes, madera y acabados con un alcance comprensible.</p>"}
  ],
  "blocks":[
    {
      "type":"feature",
      "name":"Bloque técnico",
      "settings":[
        {"type":"image_picker","id":"image","label":"Imagen"},
        {"type":"text","id":"image_alt","label":"Texto alternativo"},
        {"type":"select","id":"media_position","label":"Posición imagen","options":[{"value":"left","label":"Izquierda"},{"value":"right","label":"Derecha"}],"default":"left"},
        {"type":"text","id":"index","label":"Índice / antetítulo","default":"01 · Diseño"},
        {"type":"text","id":"heading","label":"Título","default":"Encaje real antes de fabricar"},
        {"type":"richtext","id":"text","label":"Texto","default":"<p>Definimos geometría, altura útil y relación con muros, huecos, bajantes, desniveles y accesos de montaje antes de cerrar la solución.</p>"},
        {"type":"text","id":"point_1","label":"Punto 1"},
        {"type":"text","id":"point_2","label":"Punto 2"},
        {"type":"text","id":"point_3","label":"Punto 3"}
      ]
    }
  ],
  "max_blocks":6,
  "presets":[{"name":"Pérgola · Detalles"}]
}
{% endschema %}
