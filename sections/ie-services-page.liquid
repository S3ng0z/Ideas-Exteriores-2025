{{ 'ie-services-page.css' | asset_url | stylesheet_tag }}

<section class="ie-services" aria-labelledby="ie-services-title">
  <div class="ie-services__inner">
    <nav class="ie-services__breadcrumb" aria-label="Migas de pan">
      <a href="{{ routes.root_url }}">Inicio</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ page.title }}</span>
    </nav>

    <div class="ie-services__hero">
      <div class="ie-services__hero-copy">
        {% if section.settings.eyebrow != blank %}
          <p class="ie-services__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h1 id="ie-services-title">{{ section.settings.heading }}</h1>
        {% if section.settings.lead != blank %}
          <div class="ie-services__lead rte">{{ section.settings.lead }}</div>
        {% endif %}

        <div class="ie-services__actions">
          {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}
            <a class="ie-services__button ie-services__button--primary" href="{{ section.settings.primary_link }}">
              {{ section.settings.primary_label }}
            </a>
          {% endif %}
          {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
            <a class="ie-services__button ie-services__button--secondary" href="{{ section.settings.secondary_link }}">
              {{ section.settings.secondary_label }}
            </a>
          {% endif %}
        </div>
      </div>

      <aside class="ie-services__hero-summary" aria-label="Cómo trabajamos">
        <p class="ie-services__summary-title">{{ section.settings.summary_title }}</p>
        <ol class="ie-services__summary-list">
          <li><span>01</span><strong>{{ section.settings.summary_1 }}</strong></li>
          <li><span>02</span><strong>{{ section.settings.summary_2 }}</strong></li>
          <li><span>03</span><strong>{{ section.settings.summary_3 }}</strong></li>
        </ol>
      </aside>
    </div>

    <div class="ie-services__section-head">
      <p class="ie-services__eyebrow">{{ section.settings.services_eyebrow }}</p>
      <h2>{{ section.settings.services_heading }}</h2>
      <div class="ie-services__section-intro rte">{{ section.settings.services_intro }}</div>
    </div>

    <div class="ie-services__cards">
      {% for block in section.blocks %}
        {% if block.type == 'service' %}
          <article class="ie-services__card" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <div class="ie-services__card-media">
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '480, 720, 960, 1200',
                    sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                    loading: 'lazy',
                    alt: block.settings.image_alt
                }}
              </div>
            {% endif %}
            <div class="ie-services__card-body">
              <p class="ie-services__card-index">{{ block.settings.index }}</p>
              <h3>{{ block.settings.heading }}</h3>
              <div class="ie-services__card-text rte">{{ block.settings.text }}</div>
              <ul class="ie-services__links" role="list">
                {% if block.settings.link_1_label != blank and block.settings.link_1 != blank %}
                  <li><a href="{{ block.settings.link_1 }}">{{ block.settings.link_1_label }} <span aria-hidden="true">→</span></a></li>
                {% endif %}
                {% if block.settings.link_2_label != blank and block.settings.link_2 != blank %}
                  <li><a href="{{ block.settings.link_2 }}">{{ block.settings.link_2_label }} <span aria-hidden="true">→</span></a></li>
                {% endif %}
                {% if block.settings.link_3_label != blank and block.settings.link_3 != blank %}
                  <li><a href="{{ block.settings.link_3 }}">{{ block.settings.link_3_label }} <span aria-hidden="true">→</span></a></li>
                {% endif %}
              </ul>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ie-services__process">
      <div class="ie-services__process-intro">
        <p class="ie-services__eyebrow">{{ section.settings.process_eyebrow }}</p>
        <h2>{{ section.settings.process_heading }}</h2>
        <div class="rte">{{ section.settings.process_intro }}</div>
      </div>

      <ol class="ie-services__process-list">
        {% for block in section.blocks %}
          {% if block.type == 'step' %}
            <li class="ie-services__process-step" {{ block.shopify_attributes }}>
              <span class="ie-services__process-number">{{ block.settings.number }}</span>
              <div>
                <h3>{{ block.settings.heading }}</h3>
                <p>{{ block.settings.text }}</p>
              </div>
            </li>
          {% endif %}
        {% endfor %}
      </ol>
    </div>

    <div class="ie-services__confidence">
      <div>
        <p class="ie-services__eyebrow">{{ section.settings.confidence_eyebrow }}</p>
        <h2>{{ section.settings.confidence_heading }}</h2>
      </div>
      <div class="ie-services__confidence-grid">
        <article>
          <h3>{{ section.settings.confidence_1_title }}</h3>
          <p>{{ section.settings.confidence_1_text }}</p>
        </article>
        <article>
          <h3>{{ section.settings.confidence_2_title }}</h3>
          <p>{{ section.settings.confidence_2_text }}</p>
        </article>
        <article>
          <h3>{{ section.settings.confidence_3_title }}</h3>
          <p>{{ section.settings.confidence_3_text }}</p>
        </article>
      </div>
    </div>

    <div class="ie-services__closing">
      <div>
        <p class="ie-services__eyebrow">{{ section.settings.closing_eyebrow }}</p>
        <h2>{{ section.settings.closing_heading }}</h2>
        <div class="rte">{{ section.settings.closing_text }}</div>
      </div>
      {% if section.settings.closing_label != blank and section.settings.closing_link != blank %}
        <a class="ie-services__button ie-services__button--primary" href="{{ section.settings.closing_link }}">
          {{ section.settings.closing_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Servicios · Ideas Exteriores",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Servicios para proyectos en madera"},
    {"type":"text","id":"heading","label":"Título","default":"Diseño, montaje y acompañamiento técnico para construir con claridad"},
    {"type":"richtext","id":"lead","label":"Introducción","default":"<p>Te acompañamos desde la definición inicial hasta la entrega y el mantenimiento, coordinando las decisiones técnicas que realmente condicionan el resultado: diseño, documentación, preparación de la base, montaje, protección y soporte posterior.</p>"},
    {"type":"text","id":"primary_label","label":"CTA principal","default":"Solicitar presupuesto"},
    {"type":"url","id":"primary_link","label":"Enlace CTA principal"},
    {"type":"text","id":"secondary_label","label":"CTA secundario","default":"Ver trabajos realizados"},
    {"type":"url","id":"secondary_link","label":"Enlace CTA secundario"},
    {"type":"text","id":"summary_title","label":"Título resumen","default":"Un proceso coordinado"},
    {"type":"text","id":"summary_1","label":"Resumen 1","default":"Definir el proyecto y su alcance"},
    {"type":"text","id":"summary_2","label":"Resumen 2","default":"Preparar y ejecutar el montaje"},
    {"type":"text","id":"summary_3","label":"Resumen 3","default":"Entregar, proteger y mantener"},
    {"type":"text","id":"services_eyebrow","label":"Eyebrow servicios","default":"Servicios principales"},
    {"type":"text","id":"services_heading","label":"Título servicios","default":"El soporte adecuado en cada fase"},
    {"type":"richtext","id":"services_intro","label":"Introducción servicios","default":"<p>No todos los proyectos necesitan lo mismo. Puedes contratar servicios concretos o coordinarlos dentro de un mismo alcance, según el punto en el que se encuentre tu proyecto.</p>"},
    {"type":"text","id":"process_eyebrow","label":"Eyebrow proceso","default":"Cómo trabajamos"},
    {"type":"text","id":"process_heading","label":"Título proceso","default":"De la primera decisión al montaje"},
    {"type":"richtext","id":"process_intro","label":"Introducción proceso","default":"<p>Ordenamos el proyecto por fases para reducir improvisaciones y dejar claro qué se decide, qué se prepara y qué se ejecuta en cada momento.</p>"},
    {"type":"text","id":"confidence_eyebrow","label":"Eyebrow confianza","default":"Criterio de servicio"},
    {"type":"text","id":"confidence_heading","label":"Título confianza","default":"Claridad antes, durante y después de la obra"},
    {"type":"text","id":"confidence_1_title","label":"Confianza 1 título","default":"Alcance definido"},
    {"type":"textarea","id":"confidence_1_text","label":"Confianza 1 texto","default":"Qué incluye cada servicio, qué queda fuera y qué información necesitamos para presupuestar con criterio."},
    {"type":"text","id":"confidence_2_title","label":"Confianza 2 título","default":"Coordinación técnica"},
    {"type":"textarea","id":"confidence_2_text","label":"Confianza 2 texto","default":"Diseño, base, montaje y acabados se plantean como partes de un mismo proyecto, no como decisiones aisladas."},
    {"type":"text","id":"confidence_3_title","label":"Confianza 3 título","default":"Seguimiento útil"},
    {"type":"textarea","id":"confidence_3_text","label":"Confianza 3 texto","default":"Acompañamiento para resolver decisiones, organizar la ejecución y mantener la madera en buenas condiciones."},
    {"type":"text","id":"closing_eyebrow","label":"Eyebrow cierre","default":"Siguiente paso"},
    {"type":"text","id":"closing_heading","label":"Título cierre","default":"Cuéntanos en qué fase está tu proyecto"},
    {"type":"richtext","id":"closing_text","label":"Texto cierre","default":"<p>Si ya tienes medidas, planos, una parcela o simplemente una necesidad concreta, dinos desde dónde partes. Te orientaremos hacia el servicio y el siguiente paso más adecuados.</p>"},
    {"type":"text","id":"closing_label","label":"CTA cierre","default":"Hablar con el equipo"},
    {"type":"url","id":"closing_link","label":"Enlace CTA cierre"}
  ],
  "blocks": [
    {
      "type":"service",
      "name":"Servicio",
      "settings":[
        {"type":"image_picker","id":"image","label":"Imagen"},
        {"type":"text","id":"image_alt","label":"Alt imagen"},
        {"type":"text","id":"index","label":"Índice","default":"01"},
        {"type":"text","id":"heading","label":"Título","default":"Diseño y definición"},
        {"type":"richtext","id":"text","label":"Texto","default":"<p>Definimos el proyecto antes de ejecutar: uso, medidas, sistema, viabilidad y documentación necesaria según el alcance.</p>"},
        {"type":"text","id":"link_1_label","label":"Enlace 1 · texto"},
        {"type":"url","id":"link_1","label":"Enlace 1 · URL"},
        {"type":"text","id":"link_2_label","label":"Enlace 2 · texto"},
        {"type":"url","id":"link_2","label":"Enlace 2 · URL"},
        {"type":"text","id":"link_3_label","label":"Enlace 3 · texto"},
        {"type":"url","id":"link_3","label":"Enlace 3 · URL"}
      ]
    },
    {
      "type":"step",
      "name":"Paso",
      "settings":[
        {"type":"text","id":"number","label":"Número","default":"01"},
        {"type":"text","id":"heading","label":"Título","default":"Definir"},
        {"type":"textarea","id":"text","label":"Texto","default":"Entendemos el uso, el punto de partida y el alcance que necesitas."}
      ]
    }
  ],
  "presets":[{"name":"Servicios · Ideas Exteriores"}]
}
{% endschema %}
