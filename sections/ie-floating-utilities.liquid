<div class="ie-floating-utilities" data-ie-floating-utilities>
  <a
    class="ie-floating-utilities__whatsapp"
    href="https://wa.me/34687480356"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contactar por WhatsApp"
  >
    <span aria-hidden="true">WhatsApp</span>
  </a>

  <div class="ie-floating-utilities__right">
    <button
      type="button"
      class="ie-floating-utilities__button ie-floating-utilities__scroll-nav"
      data-ie-scroll-nav
      data-direction="down"
      aria-label="Ir a la siguiente sección"
      title="Ir a la siguiente sección"
    >
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 5v13" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
        <path d="m6.75 12.75 5.25 5.25 5.25-5.25" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <a
      class="ie-floating-utilities__dossier"
      href="https://cdn.shopify.com/s/files/1/0921/0796/4760/files/Conoce_Ideas_Exteriores_-_Especialistas_en_Madera.pdf?v=1773865931"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Descargar dossier corporativo de Ideas Exteriores en PDF"
      title="Descargar dossier corporativo"
      data-ie-dossier-download
    >
      <span class="ie-floating-utilities__dossier-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M7.75 3.75h5.4l3.1 3.1v7.4a2 2 0 0 1-2 2h-6.5a2 2 0 0 1-2-2v-8.5a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round"/>
          <path d="M13 3.95v3.3h3.25" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round"/>
          <path d="M12 11v8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          <path d="m8.9 16 3.1 3.1 3.1-3.1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>

      <span class="ie-floating-utilities__dossier-copy">
        <span class="ie-floating-utilities__dossier-title">Dossier corporativo</span>
        <span class="ie-floating-utilities__dossier-meta">Descargar PDF</span>
      </span>
    </a>
  </div>
</div>

<style>
  .ie-floating-utilities{
    position:fixed;
    inset:auto 0 20px 0;
    z-index:40;
    pointer-events:none;
  }

  .ie-floating-utilities__whatsapp,
  .ie-floating-utilities__right{
    pointer-events:auto;
    position:absolute;
    bottom:0;
  }

  .ie-floating-utilities__whatsapp{
    left:20px;
    display:inline-flex;
    align-items:center;
    min-height:48px;
    padding:0 18px;
    border-radius:999px;
    background:#25d366;
    color:#fff;
    text-decoration:none;
    font-weight:600;
    box-shadow:0 4px 12px rgba(0,0,0,.18);
  }

  .ie-floating-utilities__right{
    right:20px;
    display:grid;
    gap:12px;
    justify-items:end;
  }

  .ie-floating-utilities__button{
    display:grid;
    place-items:center;
    width:52px;
    height:52px;
    padding:0;
    border:1px solid rgba(255,255,255,.22);
    border-radius:8px;
    background:rgba(31,35,30,.94);
    color:#fff;
    cursor:pointer;
    box-shadow:0 8px 24px rgba(20,24,18,.22);
    backdrop-filter:blur(8px);
    -webkit-backdrop-filter:blur(8px);
    transition:
      background-color .18s ease,
      border-color .18s ease,
      box-shadow .18s ease,
      transform .18s ease;
  }

  .ie-floating-utilities__button svg{
    width:23px;
    height:23px;
    transition:transform .22s ease;
  }

  .ie-floating-utilities__scroll-nav[data-direction="up"] svg{
    transform:rotate(180deg);
  }

  .ie-floating-utilities__button:hover{
    background:#566236;
    border-color:rgba(255,255,255,.38);
    box-shadow:0 11px 28px rgba(20,24,18,.28);
    transform:translateY(-2px);
  }

  .ie-floating-utilities__button[hidden]{
    display:none;
  }

  .ie-floating-utilities__dossier{
    display:flex;
    align-items:center;
    gap:10px;
    min-width:176px;
    min-height:58px;
    padding:8px 12px 8px 9px;
    border:1px solid rgba(86,98,54,.24);
    border-radius:14px;
    background:rgba(249,248,246,.97);
    color:#2f3820;
    text-decoration:none;
    box-shadow:0 10px 28px rgba(28,34,22,.22);
    backdrop-filter:blur(8px);
    -webkit-backdrop-filter:blur(8px);
    transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }

  .ie-floating-utilities__dossier-icon{
    flex:0 0 40px;
    display:grid;
    place-items:center;
    width:40px;
    height:40px;
    border-radius:10px;
    background:#566236;
    color:#fff;
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.08);
  }

  .ie-floating-utilities__dossier-icon svg{
    width:23px;
    height:23px;
  }

  .ie-floating-utilities__dossier-copy{
    display:grid;
    gap:2px;
    min-width:0;
    line-height:1.15;
  }

  .ie-floating-utilities__dossier-title{
    font-size:.875rem;
    font-weight:600;
    letter-spacing:0;
    white-space:nowrap;
  }

  .ie-floating-utilities__dossier-meta{
    font-size:.75rem;
    font-weight:500;
    color:rgba(47,56,32,.72);
    white-space:nowrap;
  }

  .ie-floating-utilities__dossier:hover{
    transform:translateY(-2px);
    border-color:rgba(86,98,54,.4);
    box-shadow:0 13px 32px rgba(28,34,22,.27);
  }

  .ie-floating-utilities__dossier:focus-visible,
  .ie-floating-utilities__button:focus-visible,
  .ie-floating-utilities__whatsapp:focus-visible{
    outline:3px solid #f9f8f6;
    outline-offset:3px;
  }

  @media(max-width:640px){
    .ie-floating-utilities{
      bottom:14px;
    }

    .ie-floating-utilities__whatsapp{
      left:14px;
      min-height:44px;
      padding-inline:14px;
      font-size:.875rem;
    }

    .ie-floating-utilities__right{
      right:14px;
      gap:10px;
    }

    .ie-floating-utilities__button{
      width:46px;
      height:46px;
      border-radius:7px;
    }

    .ie-floating-utilities__button svg{
      width:21px;
      height:21px;
    }

    .ie-floating-utilities__dossier{
      min-width:0;
      width:50px;
      height:50px;
      min-height:50px;
      padding:5px;
      border-radius:13px;
    }

    .ie-floating-utilities__dossier-icon{
      flex-basis:38px;
      width:38px;
      height:38px;
      border-radius:9px;
    }

    .ie-floating-utilities__dossier-copy{
      position:absolute;
      width:1px;
      height:1px;
      padding:0;
      margin:-1px;
      overflow:hidden;
      clip:rect(0,0,0,0);
      white-space:nowrap;
      border:0;
    }
  }

  @media(prefers-reduced-motion:reduce){
    .ie-floating-utilities__button,
    .ie-floating-utilities__button svg,
    .ie-floating-utilities__dossier{
      transition:none;
    }

    .ie-floating-utilities__button:hover,
    .ie-floating-utilities__dossier:hover{
      transform:none;
    }
  }
</style>

<script>
  (function () {
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function getScrollBehavior() {
      return reduceMotion ? 'auto' : 'smooth';
    }

    function getMajorSections() {
      var selectors = [
        'main .shopify-section',
        'main > section',
        'main > div[id^="shopify-section-"]'
      ];

      var seen = new Set();
      var sections = [];

      document.querySelectorAll(selectors.join(',')).forEach(function (element) {
        if (seen.has(element)) return;
        seen.add(element);

        var rect = element.getBoundingClientRect();
        var style = window.getComputedStyle(element);

        if (
          rect.height < 120 ||
          style.display === 'none' ||
          style.visibility === 'hidden'
        ) {
          return;
        }

        sections.push(element);
      });

      return sections.sort(function (a, b) {
        return a.getBoundingClientRect().top - b.getBoundingClientRect().top;
      });
    }

    function getDocumentTop(element) {
      return element.getBoundingClientRect().top + window.scrollY;
    }

    function getNextSection() {
      var currentY = window.scrollY;
      var threshold = currentY + Math.min(160, Math.max(88, window.innerHeight * 0.12));
      var sections = getMajorSections();

      for (var index = 0; index < sections.length; index += 1) {
        if (getDocumentTop(sections[index]) > threshold) {
          return sections[index];
        }
      }

      return null;
    }

    function scrollToNextSection() {
      var target = getNextSection();

      if (target) {
        var targetTop = Math.max(0, getDocumentTop(target) - 24);
        window.scrollTo({ top: targetTop, behavior: getScrollBehavior() });
        return;
      }

      window.scrollTo({
        top: document.documentElement.scrollHeight,
        behavior: getScrollBehavior()
      });
    }

    function isFooterApproaching() {
      var footer = document.querySelector(
        '.shopify-section-group-footer-group, footer, [data-footer-group]'
      );

      if (footer) {
        var rect = footer.getBoundingClientRect();
        if (rect.top <= window.innerHeight * 0.88) {
          return true;
        }
      }

      return (
        window.scrollY + window.innerHeight >=
        document.documentElement.scrollHeight - Math.max(220, window.innerHeight * 0.22)
      );
    }

    function initScrollNavigation(button) {
      if (!button || button.dataset.ieInitialized === 'true') return;
      button.dataset.ieInitialized = 'true';

      var ticking = false;

      function updateState() {
        ticking = false;

        var scrollable =
          document.documentElement.scrollHeight > window.innerHeight + 80;

        button.hidden = !scrollable;
        if (!scrollable) return;

        var direction = isFooterApproaching() ? 'up' : 'down';
        var isUp = direction === 'up';

        button.dataset.direction = direction;
        button.setAttribute(
          'aria-label',
          isUp ? 'Volver al inicio' : 'Ir a la siguiente sección'
        );
        button.setAttribute(
          'title',
          isUp ? 'Volver al inicio' : 'Ir a la siguiente sección'
        );
      }

      function requestStateUpdate() {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(updateState);
      }

      button.addEventListener('click', function () {
        var direction = button.dataset.direction || 'down';

        if (direction === 'up') {
          window.scrollTo({ top: 0, behavior: getScrollBehavior() });
        } else {
          scrollToNextSection();
        }

        if (window.dataLayer && Array.isArray(window.dataLayer)) {
          window.dataLayer.push({
            event: 'floating_scroll_navigation',
            direction: direction
          });
        }
      });

      window.addEventListener('scroll', requestStateUpdate, { passive: true });
      window.addEventListener('resize', requestStateUpdate, { passive: true });
      updateState();
    }

    function initDossierTracking(link) {
      if (!link || link.dataset.ieTrackingInitialized === 'true') return;
      link.dataset.ieTrackingInitialized = 'true';

      link.addEventListener('click', function () {
        if (window.dataLayer && Array.isArray(window.dataLayer)) {
          window.dataLayer.push({
            event: 'download_dossier',
            document_name: 'Dossier corporativo Ideas Exteriores',
            document_format: 'pdf'
          });
        }
      });
    }

    function init(root) {
      var scope = root || document;
      initScrollNavigation(scope.querySelector('[data-ie-scroll-nav]'));
      initDossierTracking(scope.querySelector('[data-ie-dossier-download]'));
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        init(document);
      }, { once: true });
    } else {
      init(document);
    }

    document.addEventListener('shopify:section:load', function (event) {
      init(event.target);
    });
  })();
</script>

{% schema %}
{
  "name": "IE Floating Utilities",
  "tag": "section",
  "enabled_on": {"groups": ["footer"]},
  "settings": [],
  "presets": [{"name": "IE Floating Utilities"}]
}
{% endschema %}
