<div class="ie-floating-utilities" data-ie-floating-utilities>
  <a
    class="ie-floating-utilities__whatsapp"
    href="https://wa.me/34687480356"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contactar por WhatsApp"
  >
    <span aria-hidden="true">WhatsApp</span>
  </a>

  <div class="ie-floating-utilities__right">
    <a
      class="ie-floating-utilities__dossier"
      href="https://cdn.shopify.com/s/files/1/0921/0796/4760/files/Conoce_Ideas_Exteriores_-_Especialistas_en_Madera.pdf?v=1773865931"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Descargar dossier corporativo de Ideas Exteriores en PDF"
      title="Descargar dossier corporativo"
      data-ie-dossier-download
    >
      <span class="ie-floating-utilities__dossier-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M7.75 3.75h5.4l3.1 3.1v7.4a2 2 0 0 1-2 2h-6.5a2 2 0 0 1-2-2v-8.5a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round"/>
          <path d="M13 3.95v3.3h3.25" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round"/>
          <path d="M12 11v8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          <path d="m8.9 16 3.1 3.1 3.1-3.1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>

      <span class="ie-floating-utilities__dossier-copy">
        <span class="ie-floating-utilities__dossier-title">Dossier corporativo</span>
        <span class="ie-floating-utilities__dossier-meta">Descargar PDF</span>
      </span>
    </a>

    <div class="ie-floating-utilities__nav" aria-label="Navegación por secciones">
      <button
        type="button"
        class="ie-floating-utilities__button"
        data-ie-scroll-prev
        aria-label="Ir a la sección anterior"
        title="Ir a la sección anterior"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 19V6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
          <path d="M6.75 11.25 12 6l5.25 5.25" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <button
        type="button"
        class="ie-floating-utilities__button"
        data-ie-scroll-next
        aria-label="Ir a la siguiente sección"
        title="Ir a la siguiente sección"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 5v13" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
          <path d="m6.75 12.75 5.25 5.25 5.25-5.25" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  .ie-floating-utilities{
    position:fixed;
    inset:auto 0 20px 0;
    z-index:40;
    pointer-events:none;
  }

  .ie-floating-utilities__whatsapp,
  .ie-floating-utilities__right{
    pointer-events:auto;
    position:absolute;
    bottom:0;
  }

  .ie-floating-utilities__whatsapp{
    left:20px;
    display:inline-flex;
    align-items:center;
    min-height:48px;
    padding:0 18px;
    border-radius:999px;
    background:#25d366;
    color:#fff;
    text-decoration:none;
    font-weight:600;
    box-shadow:0 4px 12px rgba(0,0,0,.18);
  }

  .ie-floating-utilities__right{
    right:20px;
    display:flex;
    align-items:center;
    gap:10px;
  }

  .ie-floating-utilities__nav{
    display:flex;
    align-items:center;
    gap:8px;
  }

  .ie-floating-utilities__button{
    display:grid;
    place-items:center;
    width:52px;
    height:52px;
    padding:0;
    border:1px solid rgba(255,255,255,.22);
    border-radius:8px;
    background:rgba(31,35,30,.94);
    color:#fff;
    cursor:pointer;
    box-shadow:0 8px 24px rgba(20,24,18,.22);
    backdrop-filter:blur(8px);
    -webkit-backdrop-filter:blur(8px);
    transition:
      background-color .18s ease,
      border-color .18s ease,
      box-shadow .18s ease,
      transform .18s ease,
      opacity .18s ease;
  }

  .ie-floating-utilities__button svg{
    width:23px;
    height:23px;
  }

  .ie-floating-utilities__button:hover:not(:disabled){
    background:#566236;
    border-color:rgba(255,255,255,.38);
    box-shadow:0 11px 28px rgba(20,24,18,.28);
    transform:translateY(-2px);
  }

  .ie-floating-utilities__button:disabled{
    opacity:.38;
    cursor:default;
    box-shadow:0 5px 15px rgba(20,24,18,.12);
  }

  .ie-floating-utilities__dossier{
    display:flex;
    align-items:center;
    gap:10px;
    min-width:176px;
    min-height:58px;
    padding:8px 12px 8px 9px;
    border:1px solid rgba(86,98,54,.24);
    border-radius:14px;
    background:rgba(249,248,246,.97);
    color:#2f3820;
    text-decoration:none;
    box-shadow:0 10px 28px rgba(28,34,22,.22);
    backdrop-filter:blur(8px);
    -webkit-backdrop-filter:blur(8px);
    transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }

  .ie-floating-utilities__dossier-icon{
    flex:0 0 40px;
    display:grid;
    place-items:center;
    width:40px;
    height:40px;
    border-radius:10px;
    background:#566236;
    color:#fff;
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.08);
  }

  .ie-floating-utilities__dossier-icon svg{
    width:23px;
    height:23px;
  }

  .ie-floating-utilities__dossier-copy{
    display:grid;
    gap:2px;
    min-width:0;
    line-height:1.15;
  }

  .ie-floating-utilities__dossier-title{
    font-size:.875rem;
    font-weight:600;
    letter-spacing:0;
    white-space:nowrap;
  }

  .ie-floating-utilities__dossier-meta{
    font-size:.75rem;
    font-weight:500;
    color:rgba(47,56,32,.72);
    white-space:nowrap;
  }

  .ie-floating-utilities__dossier:hover{
    transform:translateY(-2px);
    border-color:rgba(86,98,54,.4);
    box-shadow:0 13px 32px rgba(28,34,22,.27);
  }

  .ie-floating-utilities__dossier:focus-visible,
  .ie-floating-utilities__button:focus-visible,
  .ie-floating-utilities__whatsapp:focus-visible{
    outline:3px solid #f9f8f6;
    outline-offset:3px;
  }

  @media(max-width:640px){
    .ie-floating-utilities{
      bottom:14px;
    }

    .ie-floating-utilities__whatsapp{
      left:14px;
      min-height:44px;
      padding-inline:14px;
      font-size:.875rem;
    }

    .ie-floating-utilities__right{
      right:14px;
      gap:8px;
    }

    .ie-floating-utilities__nav{
      gap:6px;
    }

    .ie-floating-utilities__button{
      width:44px;
      height:44px;
      border-radius:7px;
    }

    .ie-floating-utilities__button svg{
      width:20px;
      height:20px;
    }

    .ie-floating-utilities__dossier{
      min-width:0;
      width:48px;
      height:48px;
      min-height:48px;
      padding:5px;
      border-radius:12px;
    }

    .ie-floating-utilities__dossier-icon{
      flex-basis:36px;
      width:36px;
      height:36px;
      border-radius:9px;
    }

    .ie-floating-utilities__dossier-copy{
      position:absolute;
      width:1px;
      height:1px;
      padding:0;
      margin:-1px;
      overflow:hidden;
      clip:rect(0,0,0,0);
      white-space:nowrap;
      border:0;
    }
  }

  @media(prefers-reduced-motion:reduce){
    .ie-floating-utilities__button,
    .ie-floating-utilities__dossier{
      transition:none;
    }

    .ie-floating-utilities__button:hover:not(:disabled),
    .ie-floating-utilities__dossier:hover{
      transform:none;
    }
  }
</style>

<script>
  (function () {
    var reduceMotion =
      window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function getScrollBehavior() {
      return reduceMotion ? 'auto' : 'smooth';
    }

    function getMajorSections() {
      var selectors = [
        'main .shopify-section',
        'main > section',
        'main > div[id^="shopify-section-"]'
      ];

      var seen = new Set();
      var sections = [];

      document.querySelectorAll(selectors.join(',')).forEach(function (element) {
        if (seen.has(element)) return;
        seen.add(element);

        var rect = element.getBoundingClientRect();
        var style = window.getComputedStyle(element);

        if (
          rect.height < 120 ||
          style.display === 'none' ||
          style.visibility === 'hidden'
        ) {
          return;
        }

        sections.push(element);
      });

      return sections.sort(function (a, b) {
        return (a.getBoundingClientRect().top + window.scrollY) -
          (b.getBoundingClientRect().top + window.scrollY);
      });
    }

    function getDocumentTop(element) {
      return element.getBoundingClientRect().top + window.scrollY;
    }

    function getCurrentReferenceY() {
      return window.scrollY + Math.min(160, Math.max(88, window.innerHeight * 0.12));
    }

    function getNextSection() {
      var referenceY = getCurrentReferenceY();
      var sections = getMajorSections();

      for (var index = 0; index < sections.length; index += 1) {
        if (getDocumentTop(sections[index]) > referenceY) {
          return sections[index];
        }
      }

      return null;
    }

    function getPreviousSection() {
      var referenceY = getCurrentReferenceY();
      var sections = getMajorSections();
      var previous = null;

      for (var index = 0; index < sections.length; index += 1) {
        var top = getDocumentTop(sections[index]);

        if (top < referenceY - 40) {
          previous = sections[index];
        } else {
          break;
        }
      }

      return previous;
    }

    function scrollToSection(target) {
      if (!target) return;

      var targetTop = Math.max(0, getDocumentTop(target) - 24);
      window.scrollTo({
        top: targetTop,
        behavior: getScrollBehavior()
      });
    }

    function initSectionNavigation(previousButton, nextButton) {
      if (
        !previousButton ||
        !nextButton ||
        previousButton.dataset.ieInitialized === 'true'
      ) {
        return;
      }

      previousButton.dataset.ieInitialized = 'true';
      nextButton.dataset.ieInitialized = 'true';

      var ticking = false;

      function updateState() {
        ticking = false;

        var scrollable =
          document.documentElement.scrollHeight > window.innerHeight + 80;

        previousButton.disabled = !scrollable || window.scrollY <= 24;
        nextButton.disabled =
          !scrollable ||
          window.scrollY + window.innerHeight >=
            document.documentElement.scrollHeight - 24;
      }

      function requestStateUpdate() {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(updateState);
      }

      previousButton.addEventListener('click', function () {
        var target = getPreviousSection();

        if (target) {
          scrollToSection(target);
        } else {
          window.scrollTo({ top: 0, behavior: getScrollBehavior() });
        }

        if (window.dataLayer && Array.isArray(window.dataLayer)) {
          window.dataLayer.push({
            event: 'floating_scroll_navigation',
            direction: 'up'
          });
        }
      });

      nextButton.addEventListener('click', function () {
        var target = getNextSection();

        if (target) {
          scrollToSection(target);
        } else {
          window.scrollTo({
            top: document.documentElement.scrollHeight,
            behavior: getScrollBehavior()
          });
        }

        if (window.dataLayer && Array.isArray(window.dataLayer)) {
          window.dataLayer.push({
            event: 'floating_scroll_navigation',
            direction: 'down'
          });
        }
      });

      window.addEventListener('scroll', requestStateUpdate, { passive: true });
      window.addEventListener('resize', requestStateUpdate, { passive: true });
      updateState();
    }

    function initDossierTracking(link) {
      if (!link || link.dataset.ieTrackingInitialized === 'true') return;

      link.dataset.ieTrackingInitialized = 'true';

      link.addEventListener('click', function () {
        if (window.dataLayer && Array.isArray(window.dataLayer)) {
          window.dataLayer.push({
            event: 'download_dossier',
            document_name: 'Dossier corporativo Ideas Exteriores',
            document_format: 'pdf'
          });
        }
      });
    }

    function init(root) {
      var scope = root || document;

      initSectionNavigation(
        scope.querySelector('[data-ie-scroll-prev]'),
        scope.querySelector('[data-ie-scroll-next]')
      );

      initDossierTracking(
        scope.querySelector('[data-ie-dossier-download]')
      );
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        init(document);
      }, { once: true });
    } else {
      init(document);
    }

    document.addEventListener('shopify:section:load', function (event) {
      init(event.target);
    });
  })();
</script>

