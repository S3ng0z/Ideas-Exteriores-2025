{{ 'ie-installation-page.css' | asset_url | stylesheet_tag }}

<section class="ie-installation ie-installation--scope" aria-labelledby="ie-installation-scope-title-{{ section.id }}">
  <div class="ie-installation__inner">
    <div class="ie-installation__section-head">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="ie-installation__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 id="ie-installation-scope-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.intro != blank %}
        <div class="ie-installation__intro rte">{{ section.settings.intro }}</div>
      {% endif %}
    </div>

    <div class="ie-installation__scope-grid">
      {% for block in section.blocks %}
        <article class="ie-installation__scope-item" {{ block.shopify_attributes }}>
          <span class="ie-installation__scope-number">{{ block.settings.number }}</span>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {% endfor %}
    </div>

    {% if section.settings.note != blank %}
      <div class="ie-installation__scope-note rte">{{ section.settings.note }}</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name":"Montaje · Condiciones",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"Antes del presupuesto"},
    {"type":"text","id":"heading","label":"Título","default":"Qué necesitamos definir para valorar el montaje"},
    {"type":"richtext","id":"intro","label":"Introducción","default":"<p>La misma estructura puede requerir una logística y unos medios distintos según ubicación, accesos, base y alcance. Estas variables se revisan antes de confirmar precio y fecha.</p>"},
    {"type":"richtext","id":"note","label":"Nota","default":"<p>Transporte, descarga, medios auxiliares, base, tratamientos, acabados, licencias y otros trabajos solo se consideran incluidos cuando figuran expresamente en la propuesta.</p>"}
  ],
  "blocks":[
    {
      "type":"item",
      "name":"Condición",
      "settings":[
        {"type":"text","id":"number","label":"Número","default":"01"},
        {"type":"text","id":"heading","label":"Título","default":"Ubicación y accesos"},
        {"type":"textarea","id":"text","label":"Texto","default":"Dirección, acceso de vehículos, espacio de descarga, recorrido hasta la zona de montaje y restricciones de parcela."}
      ]
    }
  ],
  "max_blocks":8,
  "presets":[{"name":"Montaje · Condiciones"}]
}
{% endschema %}