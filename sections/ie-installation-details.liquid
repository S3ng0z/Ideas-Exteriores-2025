{{ 'ie-installation-page.css' | asset_url | stylesheet_tag }}

<section class="ie-installation ie-installation--details" aria-labelledby="ie-installation-details-title-{{ section.id }}">
  <div class="ie-installation__inner">
    <div class="ie-installation__section-head">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="ie-installation__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 id="ie-installation-details-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.intro != blank %}
        <div class="ie-installation__intro rte">{{ section.settings.intro }}</div>
      {% endif %}
    </div>

    <div class="ie-installation__features">
      {% for block in section.blocks %}
        <article class="ie-installation__feature ie-installation__feature--media-{{ block.settings.media_position }}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <div class="ie-installation__feature-media">
              {{
                block.settings.image
                | image_url: width: 1800
                | image_tag:
                  widths: '640, 900, 1200, 1500, 1800',
                  sizes: '(min-width: 990px) 50vw, 100vw',
                  loading: 'lazy',
                  alt: block.settings.image_alt
              }}
            </div>
          {% endif %}

          <div class="ie-installation__feature-copy">
            {% if block.settings.index != blank %}
              <p class="ie-installation__feature-index">{{ block.settings.index }}</p>
            {% endif %}
            <h3>{{ block.settings.heading }}</h3>
            {% if block.settings.text != blank %}
              <div class="ie-installation__feature-text rte">{{ block.settings.text }}</div>
            {% endif %}

            {% if block.settings.point_1 != blank or block.settings.point_2 != blank or block.settings.point_3 != blank %}
              <ul class="ie-installation__points" role="list">
                {% if block.settings.point_1 != blank %}<li>{{ block.settings.point_1 }}</li>{% endif %}
                {% if block.settings.point_2 != blank %}<li>{{ block.settings.point_2 }}</li>{% endif %}
                {% if block.settings.point_3 != blank %}<li>{{ block.settings.point_3 }}</li>{% endif %}
              </ul>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Montaje · Alcance visual",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"Montaje profesional"},
    {"type":"text","id":"heading","label":"Título","default":"Un servicio definido por alcance, condiciones de obra y secuencia de ejecución"},
    {"type":"richtext","id":"intro","label":"Introducción","default":"<p>El montaje no se presupuesta como una partida genérica. Revisamos qué estructura se instala, qué debe estar preparado antes de llegar a obra y qué hito debe quedar terminado al finalizar.</p>"}
  ],
  "blocks":[
    {
      "type":"feature",
      "name":"Bloque de alcance",
      "settings":[
        {"type":"image_picker","id":"image","label":"Imagen"},
        {"type":"text","id":"image_alt","label":"Texto alternativo"},
        {"type":"select","id":"media_position","label":"Posición imagen","options":[{"value":"left","label":"Izquierda"},{"value":"right","label":"Derecha"}],"default":"left"},
        {"type":"text","id":"index","label":"Índice / antetítulo","default":"01 · Preparación"},
        {"type":"text","id":"heading","label":"Título","default":"Comprobamos el punto de partida antes de movilizar el montaje"},
        {"type":"richtext","id":"text","label":"Texto","default":"<p>Base, accesos, replanteo y estado del suministro condicionan la ejecución. La revisión previa reduce esperas y partidas no previstas.</p>"},
        {"type":"text","id":"point_1","label":"Punto 1"},
        {"type":"text","id":"point_2","label":"Punto 2"},
        {"type":"text","id":"point_3","label":"Punto 3"}
      ]
    }
  ],
  "max_blocks":6,
  "presets":[{"name":"Montaje · Alcance visual"}]
}
{% endschema %}