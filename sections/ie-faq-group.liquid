<section class="ie-faq ie-faq--group" id="{{ section.settings.anchor | handleize }}" aria-labelledby="ie-faq-group-title-{{ section.id }}">
  <div class="ie-faq__inner">
    <div class="ie-faq__group">
      <div class="ie-faq__group-meta">
        {% if section.settings.index != blank %}
          <p class="ie-faq__group-index">{{ section.settings.index }}</p>
        {% endif %}
        <h2 id="ie-faq-group-title-{{ section.id }}">{{ section.settings.heading }}</h2>
        {% if section.settings.intro != blank %}
          <div class="ie-faq__group-intro rte">{{ section.settings.intro }}</div>
        {% endif %}
      </div>

      <div>
        <div class="ie-faq__list">
          {% for block in section.blocks %}
            <details class="ie-faq__item" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
              <summary>
                <span>{{ block.settings.question }}</span>
              </summary>
              <div class="ie-faq__answer rte">
                {{ block.settings.answer }}
                {% if block.settings.link_label != blank and block.settings.link != blank %}
                  <a class="ie-faq__more" href="{{ block.settings.link }}">
                    {{ block.settings.link_label }} <span aria-hidden="true">→</span>
                  </a>
                {% endif %}
              </div>
            </details>
          {% endfor %}
        </div>

        {% if section.settings.note != blank %}
          <div class="ie-faq__note rte">{{ section.settings.note }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ · Grupo",
  "settings": [
    {"type":"text","id":"anchor","label":"Ancla","default":"grupo-faq"},
    {"type":"text","id":"index","label":"Índice","default":"01 · Tema"},
    {"type":"text","id":"heading","label":"Título","default":"Título del grupo"},
    {"type":"richtext","id":"intro","label":"Introducción","default":"<p>Una introducción breve para situar las preguntas de este bloque.</p>"},
    {"type":"richtext","id":"note","label":"Nota final"}
  ],
  "blocks": [
    {
      "type":"faq",
      "name":"Pregunta",
      "settings":[
        {"type":"text","id":"question","label":"Pregunta","default":"¿Pregunta frecuente?"},
        {"type":"richtext","id":"answer","label":"Respuesta","default":"<p>Respuesta clara, concreta y útil para la decisión.</p>"},
        {"type":"checkbox","id":"open_by_default","label":"Abrir por defecto","default":false},
        {"type":"text","id":"link_label","label":"Enlace · texto"},
        {"type":"url","id":"link","label":"Enlace · URL"}
      ]
    }
  ],
  "max_blocks": 10,
  "presets":[{"name":"FAQ · Grupo"}]
}
{% endschema %}
