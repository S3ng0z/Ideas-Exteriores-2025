{{ 'ie-habitable-system-collection.css' | asset_url | stylesheet_tag }}
{% comment %}IE breadcrumb renderer synced{% endcomment %}

{% liquid
  assign ie_heading = section.settings.heading
  if ie_heading == blank
    assign ie_heading = collection.title
  endif
%}

<section class="ie-hc ie-hc--hero" aria-labelledby="ie-hc-title-{{ section.id }}">
  <div class="ie-hc__inner">
    {% render 'ie-breadcrumb', breadcrumb_object: collection, current_title: ie_heading, class_name: 'ie-hc__breadcrumb', aria_label: section.settings.breadcrumb_label, home_label: section.settings.home_label, fallback_1_label: section.settings.parent_label, fallback_1_link: section.settings.parent_link %}

    <div class="ie-hc__hero-grid">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="ie-hc__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        <h1 id="ie-hc-title-{{ section.id }}">{{ ie_heading }}</h1>

        {% if section.settings.lead != blank %}
          <div class="ie-hc__lead rte">{{ section.settings.lead }}</div>
        {% endif %}

        <div class="ie-hc__actions">
          <a class="ie-hc__button ie-hc__button--primary" href="#ResultsList">
            {{ section.settings.models_prefix }} {{ collection.products_count }} {{ section.settings.models_suffix }}
          </a>
          {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
            <a class="ie-hc__button ie-hc__button--secondary" href="{{ section.settings.secondary_link }}">
              {{ section.settings.secondary_label }}
            </a>
          {% endif %}
        </div>
      </div>

      {% if section.blocks.size > 0 %}
        <aside class="ie-hc__summary" aria-label="{{ section.settings.summary_aria_label | escape }}">
          {% if section.settings.summary_title != blank %}
            <p class="ie-hc__summary-title">{{ section.settings.summary_title }}</p>
          {% endif %}
          <ol>
            {% for block in section.blocks %}
              <li {{ block.shopify_attributes }}>
                <span>{{ block.settings.number }}</span>
                <strong>{{ block.settings.label }}</strong>
              </li>
            {% endfor %}
          </ol>
        </aside>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "IE · Habitable · Hero",
  "enabled_on": {"templates": ["collection"]},
  "settings": [
    {"type": "text", "id": "breadcrumb_label", "label": "Etiqueta accesible breadcrumb", "default": "Migas de pan"},
    {"type": "text", "id": "home_label", "label": "Texto inicio", "default": "Inicio"},
    {"type": "text", "id": "parent_label", "label": "Texto nivel superior", "default": "Productos"},
    {"type": "url", "id": "parent_link", "label": "Enlace nivel superior"},
    {"type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Viviendas en madera"},
    {"type": "text", "id": "heading", "label": "Título H1"},
    {"type": "richtext", "id": "lead", "label": "Introducción", "default": "<p>Compara modelos por superficie, distribución y precio de partida antes de solicitar estudio y presupuesto.</p>"},
    {"type": "text", "id": "models_prefix", "label": "CTA modelos · prefijo", "default": "Ver"},
    {"type": "text", "id": "models_suffix", "label": "CTA modelos · sufijo", "default": "modelos"},
    {"type": "text", "id": "secondary_label", "label": "CTA secundario", "default": "Cómo trabajamos"},
    {"type": "url", "id": "secondary_link", "label": "Enlace CTA secundario"},
    {"type": "text", "id": "summary_title", "label": "Título del resumen", "default": "Antes de pedir presupuesto"},
    {"type": "text", "id": "summary_aria_label", "label": "Etiqueta accesible del resumen", "default": "Pasos antes de pedir presupuesto"}
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        {"type": "text", "id": "number", "label": "Número", "default": "01"},
        {"type": "text", "id": "label", "label": "Texto", "default": "Selecciona un modelo base"}
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{"name": "IE · Habitable · Hero"}]
}
{% endschema %}
