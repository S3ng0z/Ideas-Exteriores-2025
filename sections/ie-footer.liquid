{{ 'ie-footer.css' | asset_url | stylesheet_tag }}
<!-- IE footer layout: logo left; presentation above separator; contact below -->

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section color-{{ section.settings.color_scheme }} ie-footer"
  style="--ie-footer-padding-top: {{ section.settings.padding_top }}px; --ie-footer-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="ie-footer__inner">
    <div class="ie-footer__masthead">
      <div class="ie-footer__brand">
        {%- if section.settings.logo != blank -%}
          <a class="ie-footer__logo-link" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
            {{
              section.settings.logo
              | image_url: width: 800
              | image_tag:
                widths: '260, 320, 480, 640, 800',
                sizes: '(max-width: 640px) 260px, (max-width: 1100px) 285px, 310px',
                class: 'ie-footer__logo',
                loading: 'lazy',
                alt: shop.name
            }}
          </a>
        {%- else -%}
          <a class="ie-footer__brand-name" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>
        {%- endif -%}
      </div>

      <div class="ie-footer__content-column">
        {%- if section.settings.brand_copy != blank -%}
          {%- assign ie_brand_copy_plain = section.settings.brand_copy | strip_html | strip -%}
          <div class="ie-footer__intro rte">
            {%- if ie_brand_copy_plain contains 'En Ideas Exteriores diseñamos, fabricamos e instalamos soluciones en madera' -%}
              <p>En Ideas Exteriores creamos espacios habitables y exteriores en madera: casas y casetas prefabricadas, estudios, oficinas, pérgolas, cenadores y tarimas. Trabajamos con sistema europeo, entramado ligero y panel SIP, combinando diseño configurable, asesoramiento técnico y montaje profesional.</p>
            {%- else -%}
              {{ section.settings.brand_copy }}
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="ie-footer__contact-separator" aria-hidden="true"></div>

        <div class="ie-footer__contact" aria-label="Información de contacto">
          <div class="ie-footer__contact-block">
            <p class="ie-footer__eyebrow">{{ section.settings.location_heading | escape }}</p>
            {%- if section.settings.address != blank -%}
              <address class="ie-footer__location rte">{{ section.settings.address }}</address>
            {%- endif -%}
          </div>

          <div class="ie-footer__contact-block">
            <p class="ie-footer__eyebrow">{{ section.settings.contact_heading | escape }}</p>

            {%- if section.settings.phone != blank or section.settings.email != blank -%}
              <ul class="ie-footer__contact-links" role="list">
                {%- if section.settings.phone != blank -%}
                  {%- assign phone_href = section.settings.phone | replace: ' ', '' | replace: '-', '' | replace: '.', '' -%}
                  <li>
                    <a class="ie-footer__contact-link" href="tel:{{ phone_href | escape }}">
                      {{ section.settings.phone | escape }}
                    </a>
                  </li>
                {%- endif -%}

                {%- if section.settings.email != blank -%}
                  <li>
                    <a class="ie-footer__contact-link" href="mailto:{{ section.settings.email | escape }}">
                      {{ section.settings.email | escape }}
                    </a>
                  </li>
                {%- endif -%}
              </ul>
            {%- endif -%}

            {%- if section.settings.hours != blank -%}
              {%- assign ie_hours_safe = section.settings.hours | escape -%}
              {%- capture ie_appointment_bold -%}<strong class="ie-footer__appointment">Solo con cita previa</strong>{%- endcapture -%}
              {%- assign ie_hours_markup = ie_hours_safe | replace: 'Solo con cita previa', ie_appointment_bold | replace: 'solo con cita previa', ie_appointment_bold -%}
              <p class="ie-footer__hours">{{ ie_hours_markup }}</p>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>

    <div class="ie-footer__nav">
      <div class="ie-footer__nav-grid">
        {% render 'ie-footer-menu',
          menu: section.settings.solutions_menu,
          heading: section.settings.solutions_heading,
          key: 'solutions',
          section_id: section.id
        %}
        {% render 'ie-footer-menu',
          menu: section.settings.technical_menu,
          heading: section.settings.technical_heading,
          key: 'technical',
          section_id: section.id
        %}
        {% render 'ie-footer-menu',
          menu: section.settings.company_menu,
          heading: section.settings.company_heading,
          key: 'company',
          section_id: section.id
        %}

        {%- if section.settings.legal_menu != blank and section.settings.legal_menu.links.size > 0 -%}
          {% render 'ie-footer-menu',
            menu: section.settings.legal_menu,
            heading: section.settings.legal_heading,
            key: 'legal',
            section_id: section.id
          %}
        {%- else -%}
          <nav class="ie-footer__menu ie-footer__menu--legal" aria-labelledby="ie-footer-legal-{{ section.id }}">
            <h2 class="ie-footer__nav-heading" id="ie-footer-legal-{{ section.id }}">
              {{ section.settings.legal_heading | escape }}
            </h2>
            <ul class="ie-footer__nav-list" role="list">
              {%- if shop.privacy_policy != blank -%}
                <li><a class="ie-footer__nav-link" href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title | escape }}</a></li>
              {%- endif -%}
              {%- if shop.terms_of_service != blank -%}
                <li><a class="ie-footer__nav-link" href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title | escape }}</a></li>
              {%- endif -%}
              {%- if shop.refund_policy != blank -%}
                <li><a class="ie-footer__nav-link" href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title | escape }}</a></li>
              {%- endif -%}
              {%- if shop.shipping_policy != blank -%}
                <li><a class="ie-footer__nav-link" href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title | escape }}</a></li>
              {%- endif -%}
            </ul>
          </nav>
        {%- endif -%}
      </div>
    </div>

    <div class="ie-footer__bottom">
      <p class="ie-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}
      </p>

      <ul class="ie-footer__utility-links" role="list">
        {%- if section.settings.show_search -%}
          <li><a class="ie-footer__utility-link" href="{{ routes.search_url }}">Buscar</a></li>
        {%- endif -%}
        {%- if section.settings.budget_link != blank -%}
          <li><a class="ie-footer__utility-link" href="{{ section.settings.budget_link }}">{{ section.settings.budget_label | escape }}</a></li>
        {%- endif -%}
        {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
          <li><a class="ie-footer__utility-link" href="{{ routes.account_url }}">Cuenta</a></li>
        {%- endif -%}
        {%- if section.settings.show_cart -%}
          <li><a class="ie-footer__utility-link" href="{{ routes.cart_url }}">Carrito</a></li>
        {%- endif -%}
      </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "IE Footer optimizado",
  "class": "ie-footer-section",
  "tag": "footer",
  "enabled_on": {"groups": ["footer"]},
  "settings": [
    {"type":"color_scheme","id":"color_scheme","label":"Esquema de color","default":"scheme-4"},
    {"type":"header","content":"Marca"},
    {"type":"image_picker","id":"logo","label":"Logotipo"},
    {"type":"richtext","id":"brand_copy","label":"Texto breve de marca","default":"<p>En Ideas Exteriores creamos espacios habitables y exteriores en madera: casas y casetas prefabricadas, estudios, oficinas, pérgolas, cenadores y tarimas. Trabajamos con sistema europeo, entramado ligero y panel SIP, combinando diseño configurable, asesoramiento técnico y montaje profesional.</p>"},
    {"type":"header","content":"Contacto"},
    {"type":"text","id":"location_heading","label":"Título de ubicación","default":"Ubicación"},
    {"type":"text","id":"contact_heading","label":"Título de contacto","default":"Contacto"},
    {"type":"richtext","id":"address","label":"Dirección"},
    {"type":"text","id":"phone","label":"Teléfono"},
    {"type":"text","id":"email","label":"Email"},
    {"type":"text","id":"hours","label":"Horario / nota de atención"},
    {"type":"header","content":"Navegación"},
    {"type":"text","id":"solutions_heading","label":"Título Soluciones","default":"Soluciones"},
    {"type":"link_list","id":"solutions_menu","label":"Menú Soluciones"},
    {"type":"text","id":"technical_heading","label":"Título Técnico","default":"Técnico"},
    {"type":"link_list","id":"technical_menu","label":"Menú Técnico"},
    {"type":"text","id":"company_heading","label":"Título Empresa","default":"Empresa"},
    {"type":"link_list","id":"company_menu","label":"Menú Empresa"},
    {"type":"text","id":"legal_heading","label":"Título Legal","default":"Legal y ayuda"},
    {"type":"link_list","id":"legal_menu","label":"Menú Legal"},
    {"type":"header","content":"Utilidades"},
    {"type":"checkbox","id":"show_search","label":"Mostrar Buscar","default":true},
    {"type":"url","id":"budget_link","label":"Enlace Presupuesto general"},
    {"type":"text","id":"budget_label","label":"Texto Presupuesto general","default":"Pedir presupuesto"},
    {"type":"checkbox","id":"show_account","label":"Mostrar Cuenta","default":false},
    {"type":"checkbox","id":"show_cart","label":"Mostrar Carrito","default":false},
    {"type":"header","content":"Espaciado"},
    {"type":"range","id":"padding_top","min":32,"max":96,"step":8,"unit":"px","label":"Padding superior","default":40},
    {"type":"range","id":"padding_bottom","min":16,"max":64,"step":8,"unit":"px","label":"Padding inferior","default":24}
  ],
  "presets": [{"name":"IE Footer optimizado"}]
}
{% endschema %}
