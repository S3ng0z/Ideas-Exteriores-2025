<section class="ie-services ie-services--confidence" aria-labelledby="ie-services-confidence-title-{{ section.id }}">
  <div class="ie-services__inner">
    <div class="ie-services__confidence">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="ie-services__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 id="ie-services-confidence-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>

      <div class="ie-services__confidence-grid">
        {% for block in section.blocks %}
          <article {{ block.shopify_attributes }}>
            <h3>{{ block.settings.heading }}</h3>
            <p>{{ block.settings.text }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Servicios · Criterios",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"Criterio de servicio"},
    {"type":"text","id":"heading","label":"Título","default":"Claridad antes, durante y después de la obra"}
  ],
  "blocks":[
    {
      "type":"principle",
      "name":"Criterio",
      "settings":[
        {"type":"text","id":"heading","label":"Título","default":"Alcance definido"},
        {"type":"textarea","id":"text","label":"Texto","default":"Qué incluye cada servicio, qué queda fuera y qué información necesitamos para presupuestar con criterio."}
      ]
    }
  ],
  "max_blocks": 4,
  "presets":[{"name":"Servicios · Criterios"}]
}
{% endschema %}
