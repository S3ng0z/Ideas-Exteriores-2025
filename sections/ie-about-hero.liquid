{{ 'ie-about-page.css' | asset_url | stylesheet_tag }}
{% comment %}IE breadcrumb renderer synced{% endcomment %}

<section class="ie-about ie-about--hero" aria-labelledby="ie-about-title-{{ section.id }}">
  <div class="ie-about__inner">
    {% render 'ie-breadcrumb', breadcrumb_object: page, current_title: page.title, class_name: 'ie-about__breadcrumb' %}

    <div class="ie-about__hero">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="ie-about__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h1 id="ie-about-title-{{ section.id }}">{{ section.settings.heading }}</h1>
        {% if section.settings.lead != blank %}
          <div class="ie-about__lead rte">{{ section.settings.lead }}</div>
        {% endif %}
      </div>

      {% if section.blocks.size > 0 %}
        <aside class="ie-about__hero-summary" aria-label="{{ section.settings.summary_title | escape }}">
          {% if section.settings.summary_title != blank %}
            <p class="ie-about__summary-title">{{ section.settings.summary_title }}</p>
          {% endif %}
          <ol class="ie-about__summary-list">
            {% for block in section.blocks %}
              <li {{ block.shopify_attributes }}>
                <span>{{ block.settings.number }}</span>
                <strong>{{ block.settings.label }}</strong>
              </li>
            {% endfor %}
          </ol>
        </aside>
      {% endif %}
    </div>
  </div>
</section>

{%- assign ie_home_url = shop.url | append: routes.root_url -%}
{%- assign ie_current_url = shop.url | append: page.url -%}
{% schema %}
{
  "name":"Nosotros · Hero",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"Ideas Exteriores"},
    {"type":"text","id":"heading","label":"Título","default":"Madera, diseño y ejecución con criterio"},
    {"type":"richtext","id":"lead","label":"Introducción","default":"<p>Desarrollamos soluciones de madera para exterior, estructuras y espacios habitables a partir de modelos y configuraciones definidas. Coordinamos diseño, sistema, suministro y montaje para que cada proyecto avance con un alcance claro.</p>"},
    {"type":"text","id":"summary_title","label":"Título resumen","default":"Nuestra forma de trabajar"}
  ],
  "blocks":[
    {
      "type":"summary",
      "name":"Resumen",
      "settings":[
        {"type":"text","id":"number","label":"Número","default":"01"},
        {"type":"text","id":"label","label":"Texto","default":"Elegir con claridad"}
      ]
    }
  ],
  "max_blocks":4,
  "presets":[{"name":"Nosotros · Hero"}]
}
{% endschema %}
