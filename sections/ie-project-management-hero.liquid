{{ 'ie-project-management-page.css' | asset_url | stylesheet_tag }}
<section class="ie-project ie-project--hero" aria-labelledby="ie-project-title-{{ section.id }}">
  <div class="ie-project__inner">
    {% render 'ie-breadcrumb', breadcrumb_object: page, current_title: page.title, class_name: 'ie-project__breadcrumb' %}
    <div class="ie-project__hero">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="ie-project__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h1 id="ie-project-title-{{ section.id }}">{{ section.settings.heading }}</h1>
        {% if section.settings.lead != blank %}<div class="ie-project__lead rte">{{ section.settings.lead }}</div>{% endif %}
        <div class="ie-project__actions">
          {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}<a class="ie-project__button ie-project__button--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>{% endif %}
          {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}<a class="ie-project__button ie-project__button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>{% endif %}
        </div>
      </div>
      {% if section.blocks.size > 0 %}
        <aside class="ie-project__summary" aria-label="{{ section.settings.summary_title | escape }}">
          <p class="ie-project__summary-title">{{ section.settings.summary_title }}</p>
          <ol class="ie-project__summary-list">
            {% for block in section.blocks %}<li {{ block.shopify_attributes }}><span>{{ block.settings.number }}</span><strong>{{ block.settings.label }}</strong></li>{% endfor %}
          </ol>
        </aside>
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Proyectos y licencias · Hero",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"Gestión integral de proyectos y licencias"},
    {"type":"text","id":"heading","label":"Título","default":"Viabilidad, proyecto técnico y licencia para construir con criterio"},
    {"type":"richtext","id":"lead","label":"Introducción","default":"<p>Coordinamos la viabilidad urbanística, la documentación técnica y la tramitación de proyectos en madera para que sepas qué puede hacerse, qué exige tu municipio y cuál es el siguiente paso antes de ejecutar.</p>"},
    {"type":"text","id":"primary_label","label":"CTA principal","default":"Solicitar revisión de viabilidad"},
    {"type":"url","id":"primary_link","label":"Enlace CTA principal"},
    {"type":"text","id":"secondary_label","label":"CTA secundario","default":"Ver diseño 3D y asesoría técnica"},
    {"type":"url","id":"secondary_link","label":"Enlace CTA secundario"},
    {"type":"text","id":"summary_title","label":"Título resumen","default":"Qué resolvemos"}
  ],
  "blocks":[{"type":"summary","name":"Punto resumen","settings":[{"type":"text","id":"number","label":"Número","default":"01"},{"type":"text","id":"label","label":"Texto","default":"Comprobar el encaje urbanístico"}]}],
  "max_blocks":4,
  "presets":[{"name":"Proyectos y licencias · Hero"}]
}
{% endschema %}