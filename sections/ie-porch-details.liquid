{{ 'ie-porch-page.css' | asset_url | stylesheet_tag }}

<section class="ie-porch ie-porch--details" aria-labelledby="ie-porch-details-title-{{ section.id }}">
  <div class="ie-porch__inner">
    <div class="ie-porch__section-head">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="ie-porch__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2 id="ie-porch-details-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.intro != blank %}<div class="ie-porch__intro rte">{{ section.settings.intro }}</div>{% endif %}
    </div>

    <div class="ie-porch__features">
      {% for block in section.blocks %}
        <article class="ie-porch__feature ie-porch__feature--media-{{ block.settings.media_position }}{% if block.settings.image == blank %} ie-porch__feature--text-only{% endif %}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <div class="ie-porch__feature-media">
              {{
                block.settings.image
                | image_url: width: 1800
                | image_tag:
                  widths: '640, 900, 1200, 1500, 1800',
                  sizes: '(min-width: 990px) 50vw, 100vw',
                  loading: 'lazy',
                  alt: block.settings.image_alt
              }}
            </div>
          {% endif %}

          <div class="ie-porch__feature-copy">
            {% if block.settings.index != blank %}<p class="ie-porch__feature-index">{{ block.settings.index }}</p>{% endif %}
            <h3>{{ block.settings.heading }}</h3>
            {% if block.settings.text != blank %}<div class="ie-porch__feature-text rte">{{ block.settings.text }}</div>{% endif %}

            {% if block.settings.point_1 != blank or block.settings.point_2 != blank or block.settings.point_3 != blank %}
              <ul class="ie-porch__points" role="list">
                {% if block.settings.point_1 != blank %}<li>{{ block.settings.point_1 }}</li>{% endif %}
                {% if block.settings.point_2 != blank %}<li>{{ block.settings.point_2 }}</li>{% endif %}
                {% if block.settings.point_3 != blank %}<li>{{ block.settings.point_3 }}</li>{% endif %}
              </ul>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Porche · Detalles",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"Porches de madera a medida"},
    {"type":"text","id":"heading","label":"Título","default":"Cubierta, estructura y detalles bien resueltos"},
    {"type":"richtext","id":"intro","label":"Introducción","default":"<p>Diseñamos cada porche a partir del espacio real, del nivel de protección que buscas y de cómo quieres utilizarlo.</p>"}
  ],
  "blocks":[
    {
      "type":"feature",
      "name":"Bloque técnico",
      "settings":[
        {"type":"image_picker","id":"image","label":"Imagen"},
        {"type":"text","id":"image_alt","label":"Texto alternativo"},
        {"type":"select","id":"media_position","label":"Posición imagen","options":[{"value":"left","label":"Izquierda"},{"value":"right","label":"Derecha"}],"default":"left"},
        {"type":"text","id":"index","label":"Índice / antetítulo","default":"01 · Diseño"},
        {"type":"text","id":"heading","label":"Título","default":"Diseño adaptado a la vivienda"},
        {"type":"richtext","id":"text","label":"Texto","default":"<p>Definimos geometría, altura útil, relación con fachada y uso antes de cerrar la solución.</p>"},
        {"type":"text","id":"point_1","label":"Punto 1"},
        {"type":"text","id":"point_2","label":"Punto 2"},
        {"type":"text","id":"point_3","label":"Punto 3"}
      ]
    }
  ],
  "max_blocks":6,
  "presets":[{"name":"Porche · Detalles"}]
}
{% endschema %}
