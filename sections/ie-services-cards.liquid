<section class="ie-services ie-services--cards" aria-labelledby="ie-services-cards-title-{{ section.id }}">
  <div class="ie-services__inner">
    <div class="ie-services__section-head">
      {% if section.settings.eyebrow != blank %}
        <p class="ie-services__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 id="ie-services-cards-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      {% if section.settings.intro != blank %}
        <div class="ie-services__section-intro rte">{{ section.settings.intro }}</div>
      {% endif %}
    </div>

    <div class="ie-services__cards">
      {% for block in section.blocks %}
        <article class="ie-services__card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <div class="ie-services__card-media">
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  widths: '480, 720, 960, 1200',
                  sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                  loading: 'lazy',
                  alt: block.settings.image_alt
              }}
            </div>
          {% endif %}

          <div class="ie-services__card-body">
            {% if block.settings.index != blank %}
              <p class="ie-services__card-index">{{ block.settings.index }}</p>
            {% endif %}
            <h3>{{ block.settings.heading }}</h3>
            {% if block.settings.text != blank %}
              <div class="ie-services__card-text rte">{{ block.settings.text }}</div>
            {% endif %}

            <ul class="ie-services__links" role="list">
              {% if block.settings.link_1_label != blank and block.settings.link_1 != blank %}
                <li><a href="{{ block.settings.link_1 }}">{{ block.settings.link_1_label }} <span aria-hidden="true">→</span></a></li>
              {% endif %}
              {% if block.settings.link_2_label != blank and block.settings.link_2 != blank %}
                <li><a href="{{ block.settings.link_2 }}">{{ block.settings.link_2_label }} <span aria-hidden="true">→</span></a></li>
              {% endif %}
              {% if block.settings.link_3_label != blank and block.settings.link_3 != blank %}
                <li><a href="{{ block.settings.link_3 }}">{{ block.settings.link_3_label }} <span aria-hidden="true">→</span></a></li>
              {% endif %}
            </ul>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Servicios · Fases",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Antetítulo","default":"Servicios principales"},
    {"type":"text","id":"heading","label":"Título","default":"El soporte adecuado en cada fase"},
    {"type":"richtext","id":"intro","label":"Introducción","default":"<p>No todos los proyectos necesitan lo mismo. Puedes contratar servicios concretos o coordinarlos dentro de un mismo alcance, según el punto en el que se encuentre tu proyecto.</p>"}
  ],
  "blocks":[
    {
      "type":"service",
      "name":"Servicio",
      "settings":[
        {"type":"image_picker","id":"image","label":"Imagen"},
        {"type":"text","id":"image_alt","label":"Texto alternativo"},
        {"type":"text","id":"index","label":"Índice","default":"01 · Definir"},
        {"type":"text","id":"heading","label":"Título","default":"Diseño y definición técnica"},
        {"type":"richtext","id":"text","label":"Texto","default":"<p>Convertimos la necesidad en decisiones concretas: uso, medidas, sistema, documentación y viabilidad cuando el proyecto lo requiere.</p>"},
        {"type":"text","id":"link_1_label","label":"Enlace 1 · texto"},
        {"type":"url","id":"link_1","label":"Enlace 1 · URL"},
        {"type":"text","id":"link_2_label","label":"Enlace 2 · texto"},
        {"type":"url","id":"link_2","label":"Enlace 2 · URL"},
        {"type":"text","id":"link_3_label","label":"Enlace 3 · texto"},
        {"type":"url","id":"link_3","label":"Enlace 3 · URL"}
      ]
    }
  ],
  "max_blocks": 6,
  "presets":[{"name":"Servicios · Fases"}]
}
{% endschema %}
