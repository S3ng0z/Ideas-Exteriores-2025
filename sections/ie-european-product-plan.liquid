{% comment %}
  IE · Sistema Europeo · planta y distribución de referencia.
  custom.eu_rooms (json): {"rooms":[{"n":"1","name":"Salón-comedor","area":"15,8"}],"total":"46,3","exterior":[{"n":"1","name":"Terraza cubierta (exterior)","area":"9,5"}]}
  custom.eu_plan_image / custom.eu_layout_image (file_reference, imagen). custom.eu_plan_caption / custom.eu_plan_note sustituyen al pie y la nota comunes; si los recintos no llevan "n", se oculta la columna Nº. Si faltan, se buscan en las imágenes del producto por texto alternativo («plano» / «amueblad»).
{% endcomment %}
{% liquid
  assign rooms = product.metafields.custom.eu_rooms.value
  assign plan_img = product.metafields.custom.eu_plan_image.value
  assign layout_img = product.metafields.custom.eu_layout_image.value
  assign plan_caption = product.metafields.custom.eu_plan_caption.value | default: section.settings.plan_caption
  assign plan_note = product.metafields.custom.eu_plan_note.value | default: section.settings.note
  assign show_idx = false
  if rooms.rooms.first.n != blank
    assign show_idx = true
  endif
  for image in product.images
    assign alt = image.alt | downcase
    if plan_img == blank and alt contains 'plano'
      assign plan_img = image
    endif
    if layout_img == blank and alt contains 'amueblad'
      assign layout_img = image
    endif
  endfor
%}
{% if rooms != blank or plan_img != blank %}
{{ 'ie-eu-model.css' | asset_url | stylesheet_tag }}
<section class="ie-eu ie-eu__section" id="planta" aria-labelledby="ie-eu-plan-{{ section.id }}">
  <div class="ie-eu__wrap">
    <header class="ie-eu__head">
      <div>
        <p class="ie-eu__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 id="ie-eu-plan-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.intro != blank %}<p class="ie-eu__lead">{{ section.settings.intro }}</p>{% endif %}
    </header>

    <div class="ie-eu-plan__grid">
      {% if plan_img != blank or layout_img != blank %}
        <figure class="ie-eu-plan__figure" data-eu-plan>
          {% if plan_img != blank and layout_img != blank %}
            <div class="ie-eu-plan__switch" role="group" aria-label="Tipo de plano">
              <button type="button" aria-pressed="true" data-eu-view="plan">Plano acotado</button>
              <button type="button" aria-pressed="false" data-eu-view="layout">Distribución amueblada</button>
            </div>
          {% endif %}
          <div class="ie-eu-plan__media">
            {% if plan_img != blank %}
              {{ plan_img | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '700, 1000, 1300, 1600', sizes: '(min-width: 990px) 56vw, 100vw', alt: section.settings.plan_alt, data-eu-panel: 'plan' }}
            {% endif %}
            {% if layout_img != blank %}
              {%- capture layout_class -%}{% if plan_img != blank %}is-hidden{% endif %}{%- endcapture -%}
              {{ layout_img | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '700, 1000, 1300, 1600', sizes: '(min-width: 990px) 56vw, 100vw', alt: section.settings.layout_alt, data-eu-panel: 'layout', class: layout_class }}
            {% endif %}
          </div>
          <figcaption data-eu-caption data-plan="{{ plan_caption | escape }}" data-layout="{{ section.settings.layout_caption | escape }}">
            {% if plan_img != blank %}{{ plan_caption | escape }}{% else %}{{ section.settings.layout_caption }}{% endif %}
          </figcaption>
        </figure>
      {% endif %}

      {% if rooms != blank %}
        <div>
          <table class="ie-eu-table">
            <caption>Recintos de {{ product.title | escape }}</caption>
            <thead>
              <tr>{% if show_idx %}<th scope="col" class="is-idx">Nº</th>{% endif %}<th scope="col">Recinto</th><th scope="col" class="is-num">m²</th></tr>
            </thead>
            <tbody>
              {% for room in rooms.rooms %}
                <tr>{% if show_idx %}<td class="is-idx">{{ room.n }}</td>{% endif %}<th scope="row">{{ room.name }}</th><td class="is-num">{{ room.area }}</td></tr>
              {% endfor %}
            </tbody>
            {% if rooms.total != blank %}
              <tfoot>
                <tr>{% if show_idx %}<td></td>{% endif %}<th scope="row">Suma de recintos interiores</th><td class="is-num">{{ rooms.total }}</td></tr>
              </tfoot>
            {% endif %}
          </table>
          {% if rooms.exterior.size > 0 %}
            <table class="ie-eu-table ie-eu-table--follow">
              <tbody>
                {% for room in rooms.exterior %}
                  <tr class="is-exterior">{% if show_idx %}<td class="is-idx">{{ room.n }}</td>{% endif %}<th scope="row">{{ room.name }}</th><td class="is-num">{{ room.area }}</td></tr>
                {% endfor %}
              </tbody>
            </table>
          {% endif %}
          {% if plan_note != blank %}<p class="ie-eu__note">{{ plan_note | escape }}</p>{% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<script>
  (() => {
    const fig = document.querySelector('#shopify-section-{{ section.id }} [data-eu-plan]');
    if (!fig) return;
    const buttons = fig.querySelectorAll('[data-eu-view]');
    const caption = fig.querySelector('[data-eu-caption]');
    buttons.forEach((btn) => btn.addEventListener('click', () => {
      const view = btn.dataset.euView;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      fig.querySelectorAll('[data-eu-panel]').forEach((img) => { img.classList.toggle('is-hidden', img.dataset.euPanel !== view); });
      if (caption) caption.textContent = caption.dataset[view];
    }));
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "Europeo · planta",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Planta y distribución" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Planta y distribución del modelo" },
    { "type": "textarea", "id": "intro", "label": "Introducción", "default": "El plano muestra cómo se organizan los espacios de este modelo. Las posibles modificaciones se estudian antes de fabricar y deben respetar los elementos estructurales." },
    { "type": "text", "id": "plan_alt", "label": "Texto alternativo del plano acotado", "default": "Plano de planta acotado con recintos numerados y superficies" },
    { "type": "text", "id": "layout_alt", "label": "Texto alternativo de la distribución amueblada", "default": "Vista cenital de la distribución amueblada" },
    { "type": "text", "id": "plan_caption", "label": "Pie del plano acotado", "default": "Plano de planta. Cotas en milímetros, sin escala gráfica." },
    { "type": "text", "id": "layout_caption", "label": "Pie de la distribución amueblada", "default": "Representación ilustrativa: mobiliario y equipamiento no incluidos." },
    { "type": "textarea", "id": "note", "label": "Nota de superficies", "default": "Superficies de recintos según plano, medidas a ejes de muro: no equivalen a la superficie útil ni a la construida. Los usos de cada recinto son de referencia; el equipamiento de cocina y baño no forma parte del modelo." }
  ],
  "presets": [{ "name": "Europeo · planta" }]
}
{% endschema %}
