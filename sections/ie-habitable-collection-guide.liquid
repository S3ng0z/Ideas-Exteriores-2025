<section class="ie-hc ie-hc--guide" aria-labelledby="ie-hc-guide-title-{{ section.id }}">
  <div class="ie-hc__inner">
    <div class="ie-hc__guide-head">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="ie-hc__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 id="ie-hc-guide-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>

      <div class="ie-hc__guide-copy">
        {% if section.settings.intro != blank %}
          <div class="rte">{{ section.settings.intro }}</div>
        {% endif %}
        {% if section.settings.link_label != blank and section.settings.link != blank %}
          <p class="ie-hc__guide-link">
            <a href="{{ section.settings.link }}">{{ section.settings.link_label }} <span aria-hidden="true">→</span></a>
          </p>
        {% endif %}
      </div>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="ie-hc__guide-grid">
        {% for block in section.blocks %}
          <article {{ block.shopify_attributes }}>
            <p class="ie-hc__index">{{ block.settings.number }}</p>
            <h3>{{ block.settings.heading }}</h3>
            <p>{{ block.settings.text }}</p>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "IE · Habitable · Guía",
  "enabled_on": {"templates": ["collection"]},
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Elegir con criterio"},
    {"type": "text", "id": "heading", "label": "Título", "default": "Del modelo al estudio de tu vivienda"},
    {"type": "richtext", "id": "intro", "label": "Introducción", "default": "<p>Compara primero los modelos y valida después el alcance real del proyecto.</p>"},
    {"type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Entender el sistema constructivo"},
    {"type": "url", "id": "link", "label": "Enlace técnico"}
  ],
  "blocks": [
    {
      "type": "criterion",
      "name": "Criterio",
      "settings": [
        {"type": "text", "id": "number", "label": "Índice", "default": "01 · MODELO"},
        {"type": "text", "id": "heading", "label": "Título", "default": "Empieza por superficie y distribución"},
        {"type": "textarea", "id": "text", "label": "Texto", "default": "Compara tamaños y organización interior antes de entrar en el detalle técnico."}
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{"name": "IE · Habitable · Guía"}]
}
{% endschema %}
