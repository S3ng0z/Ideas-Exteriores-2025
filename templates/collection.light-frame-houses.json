        "step_1",
        "step_2",
        "step_3"
      ],
      "settings": {
        "breadcrumb_label": "Migas de pan",
        "home_label": "Inicio",
        "parent_label": "Productos",
        "parent_link": "/pages/timber-products",
        "eyebrow": "Viviendas en madera · Entramado ligero",
        "heading": "Casas de entramado ligero",
        "lead": "<p>Compara modelos de vivienda en madera por superficie, distribución y precio de partida. Elige un modelo base y revisa su alcance antes de validar parcela, acabados, logística y montaje.</p>",
        "models_prefix": "Ver",
        "models_suffix": "modelos",
        "secondary_label": "Cómo trabajamos",
        "secondary_link": "/pages/services",
        "summary_title": "Antes de pedir presupuesto",
        "summary_aria_label": "Pasos antes de pedir presupuesto"
      }
    },
    "guide": {
      "type": "ie-habitable-collection-guide",
      "blocks": {
        "criterion_1": {
          "type": "criterion",
          "settings": {
            "number": "01 · MODELO",
            "heading": "Empieza por superficie y distribución",
            "text": "Compara tamaños y organización interior para reducir opciones antes de entrar en el detalle técnico del sistema."
          }
        },
        "criterion_2": {
          "type": "criterion",
          "settings": {
            "number": "02 · ALCANCE",
            "heading": "Interpreta correctamente el “desde”",
            "text": "El precio mostrado es una referencia inicial del modelo. La ficha debe concretar qué incluye y qué necesita validación para el proyecto."
          }
        },
        "criterion_3": {
          "type": "criterion",
          "settings": {
            "number": "03 · PROYECTO",
            "heading": "Confirma las condiciones antes de cerrar",
            "text": "Parcela, accesos, base o solera, logística, montaje, acabados y requisitos técnicos se revisan antes de preparar una propuesta definitiva."
          }
        }
      },
      "block_order": [
        "criterion_1",
        "criterion_2",
        "criterion_3"
      ],
      "settings": {
        "eyebrow": "Elegir con criterio",
        "heading": "Del modelo al presupuesto: qué comparar",
        "intro": "<p>Esta colección sirve para comparar viviendas reales. El entramado ligero explica cómo se construyen; el precio final y las prestaciones dependen del modelo, la configuración, la parcela y la justificación técnica del proyecto.</p>",
        "link_label": "Entender el sistema de entramado ligero",
        "link": "/pages/what-is-light-timber-frame-construction"
      }
    },
