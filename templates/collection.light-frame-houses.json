          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "number": "02",
            "label": "Revisa el precio “desde” y el alcance indicado en la ficha"
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "number": "03",
            "label": "Valida parcela, accesos, base, acabados y montaje"
          }
        }
      },
