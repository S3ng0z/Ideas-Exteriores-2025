{
  "sections": {
    "custom_liquid_chGEnT": {
      "type": "custom-liquid",
      "name": "IE · Breadcrumb global",
      "settings": {
        "custom_liquid": "{% render 'ie-breadcrumb', breadcrumb_object: page, current_title: page.title, class_name: 'lux-breadcrumb' %}\n<h1 class=\"lux-title\">{{ page.title }}</h1>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "main": {
      "type": "main-page",
      "blocks": {
        "text_KMwtTr": {
          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "{{ closest.page.content }}",
            "width": "100%",
            "max_width": "none",
            "alignment": "left",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "color": "var(--color-foreground)",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        }
      },
      "block_order": [
        "text_KMwtTr"
      ],
      "custom_css": [
        ".page-width-content {--page-content-width: 100% !important;}"
      ],
      "settings": {
        "content_direction": "column",
        "gap": 32,
        "color_scheme": "",
        "padding-block-start": 40,
        "padding-block-end": 80
      }
    }
  },
  "order": [
    "custom_liquid_chGEnT",
    "main"
  ]
}
