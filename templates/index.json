              "settings": {
                "custom_liquid": "<!-- POPUP VACACIONES · IDEAS EXTERIORES -->\n<div\n  id=\"vacation-popup\"\n  class=\"ie-vacation-popup\"\n  role=\"dialog\"\n  aria-modal=\"true\"\n  aria-labelledby=\"vacation-popup-title\"\n  aria-describedby=\"vacation-popup-text\"\n  hidden\n>\n  <div class=\"ie-vacation-popup__overlay\"></div>\n\n  <div class=\"ie-vacation-popup__box\">\n    <button\n      type=\"button\"\n      class=\"ie-vacation-popup__close\"\n      aria-label=\"Cerrar aviso\"\n    >\n      <span aria-hidden=\"true\">&times;</span>\n    </button>\n\n    <span class=\"ie-vacation-popup__label\">\n      AVISO IMPORTANTE\n    </span>\n\n    <h2 id=\"vacation-popup-title\">\n      CERRAMOS POR VACACIONES\n    </h2>\n\n    <div class=\"ie-vacation-popup__line\"></div>\n\n    <p id=\"vacation-popup-text\">\n      Nuestro equipo estará de vacaciones hasta el\n      <strong>31 de agosto</strong>.\n    </p>\n\n    <p class=\"ie-vacation-popup__secondary\">\n      Puedes seguir visitando nuestra web y descubriendo todos nuestros\n      productos y soluciones en madera.\n    </p>\n\n    <button\n      type=\"button\"\n      class=\"ie-vacation-popup__continue\"\n    >\n      SEGUIR NAVEGANDO\n    </button>\n  </div>\n</div>\n\n<style>\n  .ie-vacation-popup {\n    position: fixed;\n    inset: 0;\n    z-index: 2147483647;\n    isolation: isolate;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 24px;\n    font-family: inherit;\n  }\n\n  .ie-vacation-popup[hidden] {\n    display: none !important;\n  }\n\n  .ie-vacation-popup__overlay {\n    position: absolute;\n    inset: 0;\n    z-index: 1;\n    background: rgba(18, 21, 16, 0.76);\n    backdrop-filter: blur(5px);\n    -webkit-backdrop-filter: blur(5px);\n    cursor: pointer;\n  }\n\n  .ie-vacation-popup__box {\n    position: relative;\n    z-index: 2;\n    width: min(100%, 720px);\n    padding: 58px 65px 50px;\n    background: #ffffff;\n    color: #252822;\n    text-align: center;\n    box-sizing: border-box;\n    box-shadow: 0 28px 90px rgba(0, 0, 0, 0.38);\n    animation: ie-popup-enter 0.4s ease-out;\n  }\n\n  .ie-vacation-popup__close {\n    position: absolute;\n    top: 14px;\n    right: 17px;\n    width: 38px;\n    height: 38px;\n    padding: 0;\n    border: 0;\n    border-radius: 0;\n    background: transparent;\n    color: #252822;\n    font-family: Arial, sans-serif;\n    font-size: 30px;\n    font-weight: 300;\n    line-height: 38px;\n    cursor: pointer;\n    transition:\n      color 0.2s ease,\n      transform 0.2s ease;\n  }\n\n  .ie-vacation-popup__close:hover {\n    color: #8a9a5b;\n    transform: rotate(90deg);\n  }\n\n  .ie-vacation-popup__label {\n    display: block;\n    margin-bottom: 14px;\n    color: #8a9a5b;\n    font-size: 12px;\n    font-weight: 600;\n    line-height: 1.4;\n    letter-spacing: 0.18em;\n  }\n\n  .ie-vacation-popup h2 {\n    max-width: 590px;\n    margin: 0 auto;\n    color: #252822;\n    font-family: inherit;\n    font-size: clamp(29px, 4vw, 40px);\n    font-weight: 500;\n    line-height: 1.15;\n    letter-spacing: -0.02em;\n  }\n\n  .ie-vacation-popup__line {\n    width: 46px;\n    height: 2px;\n    margin: 24px auto;\n    background: #8a9a5b;\n  }\n\n  .ie-vacation-popup p {\n    max-width: 540px;\n    margin: 0 auto;\n    color: #45483f;\n    font-size: 16px;\n    line-height: 1.65;\n  }\n\n  .ie-vacation-popup__secondary {\n    margin-top: 10px !important;\n    color: #6c6f66 !important;\n    font-size: 14px !important;\n  }\n\n  .ie-vacation-popup__continue {\n    min-width: 220px;\n    margin-top: 30px;\n    padding: 15px 28px;\n    border: 1px solid #8a9a5b;\n    border-radius: 0;\n    background: #8a9a5b;\n    color: #ffffff;\n    font-family: inherit;\n    font-size: 13px;\n    font-weight: 600;\n    line-height: 1.2;\n    letter-spacing: 0.09em;\n    cursor: pointer;\n    transition:\n      background 0.2s ease,\n      color 0.2s ease;\n  }\n\n  .ie-vacation-popup__continue:hover {\n    background: transparent;\n    color: #657143;\n  }\n\n  .ie-vacation-popup__continue:focus-visible,\n  .ie-vacation-popup__close:focus-visible {\n    outline: 2px solid #252822;\n    outline-offset: 3px;\n  }\n\n  @keyframes ie-popup-enter {\n    from {\n      opacity: 0;\n      transform: translateY(18px) scale(0.98);\n    }\n\n    to {\n      opacity: 1;\n      transform: translateY(0) scale(1);\n    }\n  }\n\n  @media screen and (max-width: 600px) {\n    .ie-vacation-popup {\n      padding: 16px;\n    }\n\n    .ie-vacation-popup__box {\n      width: 100%;\n      padding: 48px 25px 36px;\n    }\n\n    .ie-vacation-popup h2 {\n      font-size: 28px;\n    }\n\n    .ie-vacation-popup p {\n      font-size: 15px;\n    }\n\n    .ie-vacation-popup__continue {\n      width: 100%;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .ie-vacation-popup__box {\n      animation: none;\n    }\n\n    .ie-vacation-popup__close,\n    .ie-vacation-popup__continue {\n      transition: none;\n    }\n  }\n</style>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    const popup = document.getElementById('vacation-popup');\n\n    if (!popup) return;\n\n    /*\n     * Coloca el popup directamente dentro de <body>.\n     * Así queda por encima del aviso de cookies, WhatsApp\n     * y los demás elementos flotantes del tema.\n     */\n    document.body.appendChild(popup);\n\n    const closeButton = popup.querySelector(\n      '.ie-vacation-popup__close'\n    );\n\n    const continueButton = popup.querySelector(\n      '.ie-vacation-popup__continue'\n    );\n\n    const overlay = popup.querySelector(\n      '.ie-vacation-popup__overlay'\n    );\n\n    const storageKey = 'ideas_exteriores_vacaciones_2026';\n\n    /*\n     * El popup dejará de mostrarse automáticamente\n     * el 1 de septiembre de 2026.\n     */\n    const endDate = new Date('2026-09-01T00:00:00+02:00');\n\n    let alreadyClosed = false;\n    let previousActiveElement = null;\n\n    try {\n      alreadyClosed =\n        sessionStorage.getItem(storageKey) === 'closed';\n    } catch (error) {\n      alreadyClosed = false;\n    }\n\n    function openPopup() {\n      previousActiveElement = document.activeElement;\n      popup.hidden = false;\n      document.body.style.overflow = 'hidden';\n\n      window.setTimeout(function () {\n        continueButton.focus();\n      }, 100);\n    }\n\n    function closePopup() {\n      popup.hidden = true;\n      document.body.style.overflow = '';\n\n      try {\n        sessionStorage.setItem(storageKey, 'closed');\n      } catch (error) {\n        /* El popup se cierra aunque se bloquee el almacenamiento. */\n      }\n\n      if (\n        previousActiveElement &&\n        typeof previousActiveElement.focus === 'function'\n      ) {\n        previousActiveElement.focus();\n      }\n    }\n\n    if (new Date() < endDate && !alreadyClosed) {\n      openPopup();\n    }\n\n    closeButton.addEventListener('click', closePopup);\n    continueButton.addEventListener('click', closePopup);\n    overlay.addEventListener('click', closePopup);\n\n    document.addEventListener('keydown', function (event) {\n      if (popup.hidden) return;\n\n      if (event.key === 'Escape') {\n        closePopup();\n      }\n\n      /*\n       * Mantiene el foco del teclado dentro del popup\n       * mientras permanece abierto.\n       */\n      if (event.key === 'Tab') {\n        const focusableElements = [\n          closeButton,\n          continueButton\n        ];\n\n        const firstElement = focusableElements[0];\n        const lastElement =\n          focusableElements[focusableElements.length - 1];\n\n        if (\n          event.shiftKey &&\n          document.activeElement === firstElement\n        ) {\n          event.preventDefault();\n          lastElement.focus();\n        } else if (\n          !event.shiftKey &&\n          document.activeElement === lastElement\n        ) {\n          event.preventDefault();\n          firstElement.focus();\n        }\n      }\n    });\n  });\n</script>"
