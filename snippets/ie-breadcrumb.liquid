{% comment %}IE global breadcrumb v2{% endcomment %}
{% liquid
  assign ie_object = breadcrumb_object
  if ie_object == blank
    if product
      assign ie_object = product
    elsif collection
      assign ie_object = collection
    elsif page
      assign ie_object = page
    endif
  endif

  assign ie_title = current_title
  if ie_title == blank and ie_object != blank
    assign ie_title = ie_object.title
  endif

  assign ie_home_label = home_label | default: 'Inicio'

  assign ie_n1 = blank
  assign ie_n2 = blank
  assign ie_n3 = blank
  assign ie_n1_url = blank
  assign ie_n2_url = blank
  assign ie_n3_url = blank

  if ie_object != blank
    assign ie_n1 = ie_object.metafields.custom.n1.value | default: ie_object.metafields.custom.N1.value
    assign ie_n2 = ie_object.metafields.custom.n2.value | default: ie_object.metafields.custom.N2.value
    assign ie_n3 = ie_object.metafields.custom.n3.value | default: ie_object.metafields.custom.N3.value
    assign ie_n1_url = ie_object.metafields.custom.n1_url.value | default: ie_object.metafields.custom.N1_URL.value
    assign ie_n2_url = ie_object.metafields.custom.n2_url.value | default: ie_object.metafields.custom.N2_URL.value
    assign ie_n3_url = ie_object.metafields.custom.n3_url.value | default: ie_object.metafields.custom.N3_URL.value
  endif

  assign ie_n1 = ie_n1 | default: fallback_1_label
  assign ie_n2 = ie_n2 | default: fallback_2_label
  assign ie_n3 = ie_n3 | default: fallback_3_label
  assign ie_n1_url = ie_n1_url | default: fallback_1_link
  assign ie_n2_url = ie_n2_url | default: fallback_2_link
  assign ie_n3_url = ie_n3_url | default: fallback_3_link

  assign ie_n1_href = ie_n1_url | replace: 'https://www.ideas-exteriores.com', '' | replace: 'http://www.ideas-exteriores.com', ''
  assign ie_n2_href = ie_n2_url | replace: 'https://www.ideas-exteriores.com', '' | replace: 'http://www.ideas-exteriores.com', ''
  assign ie_n3_href = ie_n3_url | replace: 'https://www.ideas-exteriores.com', '' | replace: 'http://www.ideas-exteriores.com', ''

  assign ie_class = class_name | default: 'ie-breadcrumb'
%}

<nav class="{{ ie_class }} ie-breadcrumb" aria-label="{{ aria_label | default: 'Migas de pan' | escape }}">
  <a href="{{ routes.root_url }}">{{ ie_home_label }}</a>

  {% if ie_n1 != blank %}
    <span class="ie-breadcrumb__separator" aria-hidden="true">/</span>
    {% if ie_n1_href != blank %}<a href="{{ ie_n1_href }}">{{ ie_n1 }}</a>{% else %}<span>{{ ie_n1 }}</span>{% endif %}
  {% endif %}
  {% if ie_n2 != blank %}
    <span class="ie-breadcrumb__separator" aria-hidden="true">/</span>
    {% if ie_n2_href != blank %}<a href="{{ ie_n2_href }}">{{ ie_n2 }}</a>{% else %}<span>{{ ie_n2 }}</span>{% endif %}
  {% endif %}
  {% if ie_n3 != blank %}
    <span class="ie-breadcrumb__separator" aria-hidden="true">/</span>
    {% if ie_n3_href != blank %}<a href="{{ ie_n3_href }}">{{ ie_n3 }}</a>{% else %}<span>{{ ie_n3 }}</span>{% endif %}
  {% endif %}
  {% if ie_title != blank %}
    <span class="ie-breadcrumb__separator" aria-hidden="true">/</span>
    <span class="ie-breadcrumb__current" aria-current="page">{{ ie_title }}</span>
  {% endif %}
</nav>


{% if ie_title != blank %}
  {% liquid
    assign ie_position = 1
    assign ie_home_url = shop.url | append: routes.root_url
  %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": {{ ie_position }},
        "name": {{ ie_home_label | json }},
        "item": {{ ie_home_url | json }}
      }
      {% if ie_n1 != blank and ie_n1_href != blank %}
        {% assign ie_position = ie_position | plus: 1 %}
        ,{
          "@type": "ListItem",
          "position": {{ ie_position }},
          "name": {{ ie_n1 | json }},
          "item": {{ shop.url | append: ie_n1_href | json }}
        }
      {% endif %}
      {% if ie_n2 != blank and ie_n2_href != blank %}
        {% assign ie_position = ie_position | plus: 1 %}
        ,{
          "@type": "ListItem",
          "position": {{ ie_position }},
          "name": {{ ie_n2 | json }},
          "item": {{ shop.url | append: ie_n2_href | json }}
        }
      {% endif %}
      {% if ie_n3 != blank and ie_n3_href != blank %}
        {% assign ie_position = ie_position | plus: 1 %}
        ,{
          "@type": "ListItem",
          "position": {{ ie_position }},
          "name": {{ ie_n3 | json }},
          "item": {{ shop.url | append: ie_n3_href | json }}
        }
      {% endif %}
      {% assign ie_position = ie_position | plus: 1 %}
      ,{
        "@type": "ListItem",
        "position": {{ ie_position }},
        "name": {{ ie_title | json }},
        "item": {{ canonical_url | json }}
      }
    ]
  }
  </script>
{% endif %}
