{% if ie_model != blank %}
  <div class="ie-frame-summary" data-ie-component="light-frame-summary-v1" aria-label="Datos principales de {{ ie_model | escape }}">
    <p class="ie-frame-summary__eyebrow">Ficha rápida · Entramado ligero de madera</p>
    <dl class="ie-frame-summary__facts">
      <div><dt>{{ ie_surface_label | escape }}</dt><dd>{{ ie_surface | escape }}</dd></div>
      <div><dt>Dormitorios</dt><dd>{{ ie_bedrooms | escape }}</dd></div>
      <div><dt>Baños</dt><dd>{{ ie_bathrooms | escape }}</dd></div>
      {% if ie_extra_value != blank %}
        <div><dt>{{ ie_extra_label | escape }}</dt><dd>{{ ie_extra_value | escape }}</dd></div>
      {% endif %}
    </dl>
    <p class="ie-frame-summary__note">Superficies y distribución según ficha comercial. Confirma planos, alcance del suministro, cimentación, montaje e instalaciones antes de comparar presupuestos.</p>
    <a class="ie-frame-summary__link" href="#ie-habitable-packages">Comparar configuraciones y alcance <span aria-hidden="true">→</span></a>
  </div>
  <style>
    .ie-frame-summary{margin-block:1.25rem;padding:clamp(1rem,2.5vw,1.4rem);background:#f7faf7;border:1px solid #dce4dc;border-radius:12px;color:#26362d}
    .ie-frame-summary__eyebrow{margin:0 0 .9rem;font-size:.79rem;line-height:1.4;font-weight:700;letter-spacing:.045em}
    .ie-frame-summary__facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(115px,1fr));gap:.9rem;margin:0 0 .9rem;padding:0}
    .ie-frame-summary__facts>div{display:flex;flex-direction:column-reverse;gap:.2rem;min-width:0}
    .ie-frame-summary__facts dd{margin:0;font-size:1.3rem;line-height:1.2;font-weight:700;overflow-wrap:anywhere}
    .ie-frame-summary__facts dt{font-size:.82rem;line-height:1.4}
    .ie-frame-summary__note{font-size:.88rem;line-height:1.55;margin:0 0 .7rem}
    .ie-frame-summary__link{font-size:.9rem;line-height:1.4;font-weight:700;color:#284c3a;text-underline-offset:3px}
    .ie-frame-summary__link:focus-visible{outline:2px solid currentColor;outline-offset:4px}
  </style>
{% endif %}
