{% doc %}
Resumen comercial compartido de las nueve casas HOME-SIP. Superficies sujetas a planos.
@param {product} product - Producto del modelo SIP.
{% enddoc %}
{% liquid
  case product.handle
  when 'home-sip-alice-117-m-terraza'
    assign ie_model = 'ALICE'
    assign ie_area = '117 m²'
    assign ie_exterior = '60 m² de terraza, fuera del cómputo nominal'
    assign ie_bedrooms = '3'
    assign ie_bathrooms = '2'
    assign ie_floors = 'planta baja y altillo'
    assign ie_breakdown = '103 m² de planta baja y 14 m² de altillo'
  when 'home-sip-valeria-97-m-terraza'
    assign ie_model = 'VALERIA'
    assign ie_area = '97 m²'
    assign ie_exterior = '39 m² de terraza y 3 m² de balcón, declarados por separado'
    assign ie_bedrooms = '3'
    assign ie_bathrooms = '2'
    assign ie_floors = 'dos plantas'
    assign ie_breakdown = '74 m² de planta baja y 23 m² de planta alta'
  when 'home-sip-nora-89m-terraza'
    assign ie_model = 'NORA'
    assign ie_area = '89 m²'
    assign ie_exterior = '42,9 m² de terraza, declarada por separado'
    assign ie_bedrooms = '2'
    assign ie_bathrooms = '1'
    assign ie_floors = 'planta baja y altillo'
    assign ie_breakdown = '62,6 m² de planta baja y 25,9 m² de altillo; total 88,5 m², redondeado'
  when 'home-sip-naiara-56-m-terraza'
    assign ie_model = 'NAIARA'
    assign ie_area = '56 m²'
    assign ie_exterior = '35 m² de terraza, declarada por separado'
    assign ie_bedrooms = '1'
    assign ie_bathrooms = '1'
    assign ie_floors = 'una planta'
    assign ie_breakdown = '56 m² de planta principal'
  when 'home-sip-elisa-77-m-terraza'
    assign ie_model = 'ELISA'
    assign ie_area = '77 m²'
    assign ie_exterior = '34 m² de terraza cubierta, declarada por separado'
    assign ie_bedrooms = '3'
    assign ie_bathrooms = '1'
    assign ie_floors = 'una planta'
    assign ie_breakdown = '77 m² de planta principal'
  when 'home-sip-arlet-187-m-terraza'
    assign ie_model = 'ARLET'
    assign ie_area = '187 m²'
    assign ie_exterior = '31 m² de terraza y 10 m² de balcón cubierto, declarados por separado'
    assign ie_bedrooms = '3'
    assign ie_bathrooms = '3'
    assign ie_floors = 'dos plantas'
    assign ie_breakdown = '127 m² de planta baja y 60 m² de planta alta'
  when 'home-sip-laia-106-m-terraza'
    assign ie_model = 'LAIA'
    assign ie_area = '106 m²'
    assign ie_exterior = '41 m² de terraza; confirmar su cómputo en los planos'
    assign ie_bedrooms = '3'
    assign ie_bathrooms = '2'
    assign ie_floors = 'una planta'
    assign ie_breakdown = '106 m² nominales, sujeto a comprobación de terrazas'
  when 'home-sip-camelia-163-m-terraza'
    assign ie_model = 'CAMELIA'
    assign ie_area = '163 m²'
    assign ie_exterior = '61 m² de terraza; confirmar su cómputo en los planos'
    assign ie_bedrooms = '3'
    assign ie_bathrooms = '2'
    assign ie_floors = 'una planta'
    assign ie_breakdown = '163 m² nominales, sujeto a comprobación de terrazas'
  when 'home-sip-luna-129-m-terraza'
    assign ie_model = 'LUNA'
    assign ie_area = '129 m²'
    assign ie_exterior = '31 m² de terraza y 41 m² de porche, declarados por separado'
    assign ie_bedrooms = '4'
    assign ie_bathrooms = '3'
    assign ie_floors = 'dos plantas'
    assign ie_breakdown = '52 m² de planta baja y 77 m² de planta alta'
  endcase
%}
{% if ie_model != blank %}
  <div class="ie-sip-model-brief" aria-label="Resumen comercial de {{ product.title | escape }}">
    <p class="ie-sip-model-brief__eyebrow">{{ ie_model }} · Paneles SIP</p>
    <dl class="ie-sip-model-brief__facts">
      <div><dt>Superficie nominal</dt><dd>{{ ie_area }}</dd></div>
      <div><dt>Dormitorios</dt><dd>{{ ie_bedrooms }}</dd></div>
      <div><dt>Baños</dt><dd>{{ ie_bathrooms }}</dd></div>
      <div><dt>Distribución</dt><dd>{{ ie_floors }}</dd></div>
    </dl>
    <p class="ie-sip-model-brief__detail"><strong>Desglose comercial:</strong> {{ ie_breakdown }}.</p>
    <p class="ie-sip-model-brief__detail"><strong>Espacios exteriores:</strong> {{ ie_exterior }}.</p>
    <p class="ie-sip-model-brief__note">Los m² son orientativos: confirmar superficie útil y construida, planos y alcance contractual. BASIC, STANDARD y PASSIVE son denominaciones comerciales, no certificaciones de eficiencia ni equivalentes a Passivhaus.</p>
  </div>
{% endif %}
