{% comment %}
  Temporary compatibility layer for the Home hero.
  The live Shopify theme is not currently applying templates/index.json from GitHub,
  while Liquid/snippet files do sync. Keep this override aligned with templates/index.json.
{% endcomment %}

<style>
  #shopify-section-hero_irjTFL .section-content-wrapper {
    width: 100%;
    max-width: 780px !important;
  }

  #shopify-section-hero_irjTFL .text-block.ie-home-hero__message {
    background: rgba(31, 35, 30, 0.70) !important;
    border-radius: 12px !important;
    padding: 28px 30px !important;
  }

  #shopify-section-hero_irjTFL .ie-home-hero__message > * {
    width: 100%;
    max-width: none;
  }

  #shopify-section-hero_irjTFL .ie-home-hero__eyebrow {
    margin: 0 0 10px !important;
    padding: 0 !important;
    font-family: var(--font-body--family) !important;
    font-size: clamp(.72rem, .8vw, .8rem) !important;
    font-weight: 600 !important;
    line-height: 1.3 !important;
    letter-spacing: .08em !important;
    text-transform: uppercase !important;
    text-align: left !important;
    opacity: .92;
  }

  #shopify-section-hero_irjTFL .ie-home-hero__message h1 {
    max-width: 22ch !important;
    margin: 0 0 16px !important;
    padding: 0 !important;
    font-size: clamp(1.7rem, 2.35vw, 2.45rem) !important;
    font-weight: 500 !important;
    line-height: 1.08 !important;
    text-align: left !important;
    text-transform: none !important;
    text-wrap: balance;
  }

  #shopify-section-hero_irjTFL .ie-home-hero__lead {
    max-width: 65ch !important;
    margin: 0 !important;
    padding: 0 !important;
    font-family: var(--font-body--family) !important;
    font-size: clamp(1rem, 1.05vw, 1.12rem) !important;
    font-weight: 400 !important;
    line-height: 1.55 !important;
    text-align: left !important;
    text-transform: none !important;
    text-wrap: pretty;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-hero_irjTFL .section-content-wrapper {
      max-width: 100% !important;
    }

    #shopify-section-hero_irjTFL .text-block.ie-home-hero__message {
      padding: 22px 20px !important;
      border-radius: 10px !important;
    }

    #shopify-section-hero_irjTFL .ie-home-hero__message h1 {
      font-size: clamp(1.6rem, 7vw, 2rem) !important;
    }

    #shopify-section-hero_irjTFL .ie-home-hero__lead {
      font-size: 1rem !important;
      line-height: 1.5 !important;
    }
  }
</style>

<script>
  (function () {
    function applyHomeHeroPresentation(root) {
      var scope = root || document;
      var section = scope.querySelector
        ? scope.querySelector('#shopify-section-hero_irjTFL')
        : null;

      if (!section && scope !== document) {
        section = document.getElementById('shopify-section-hero_irjTFL');
      }

      if (!section) return;

      var textBlock = section.querySelector('.text-block');
      if (!textBlock) return;

      textBlock.classList.add('ie-home-hero__message');
      textBlock.innerHTML =
        '<p class="ie-home-hero__eyebrow"><strong>Sistemas constructivos en madera</strong></p>' +
        '<h1>Casas y casetas de madera prefabricadas con entramado ligero y panel SIP</h1>' +
        '<p class="ie-home-hero__lead">Soluciones para vivienda, estudio, oficina o espacio exterior, con modelos definidos, opciones compatibles y distintos niveles de acabado. Te ayudamos a elegir el sistema adecuado y coordinamos suministro y montaje según el alcance de cada proyecto.</p>';
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        applyHomeHeroPresentation(document);
      }, { once: true });
    } else {
      applyHomeHeroPresentation(document);
    }

    document.addEventListener('shopify:section:load', function (event) {
      applyHomeHeroPresentation(event.target);
    });
  })();
</script>
