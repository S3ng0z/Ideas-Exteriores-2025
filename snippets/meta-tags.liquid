<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="view-transition"
  content="same-origin"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  assign seo_title = page_title | default: shop.name
  assign seo_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'index'
    assign seo_title = 'Ideas Exteriores | Soluciones de madera para exterior'
    assign seo_description = 'Diseñamos soluciones de madera para exterior y espacios habitables: casetas, pérgolas, tarimas, estudios y estructuras, con asesoramiento técnico y montaje.'
  endif

  if request.page_type == 'collection' and collection.handle == 'wooden-gazebos'
    assign seo_title = 'Cenadores de madera para jardín y gazebos'
    assign seo_description = 'Compara cenadores y gazebos de madera para jardín por tamaño y precio de partida. Revisa estructura, cubierta, base, anclaje, transporte y montaje.'
  endif

  if request.page_type == 'page' and page.handle == 'wood-treatment-protection'
    assign seo_title = 'Tratamiento y protección de la madera exterior'
    assign seo_description = 'Protección técnica de madera según uso, humedad y exposición: tratamiento preventivo, lasures, aceites, sellado de puntos críticos y mantenimiento.'
  endif

  if request.page_type == 'page' and page.handle == 'wood-3d-design-consulting'
    assign seo_title = 'Diseño 3D en madera y asesoría técnica'
    assign seo_description = 'Diseño 3D y asesoría técnica para definir medidas, distribución, sistema constructivo y alcance antes de presupuestar, fabricar o tramitar el proyecto.'
  endif

  if request.page_type == 'page' and page.handle == 'timber-structure-installation'
    assign seo_title = 'Montaje profesional de estructuras de madera'
    assign seo_description = 'Montaje profesional de estructuras de madera con base, accesos, logística, medios auxiliares, secuencia de ejecución e incluidos definidos antes de obra.'
  endif

  if request.page_type == 'page' and page.handle == 'timber-bases-and-foundations'
    assign seo_title = 'Bases y soleras para estructuras de madera'
    assign seo_description = 'Soluciones de base para estructuras de madera según terreno, uso y cargas: losas, zapatas, pilotes, drenaje, barreras antihumedad y anclajes.'
  endif

  if request.page_type == 'page' and page.handle == 'project-management-permits'
    assign seo_title = 'Gestión de proyectos y licencias para construcciones de madera'
    assign seo_description = 'Viabilidad urbanística, proyecto técnico y apoyo en licencias para construcciones de madera, con alcance y documentación adaptados al municipio y al proyecto.'
  endif

  if request.page_type == 'page' and page.handle == 'warranty-delivery-payment-options'
    assign seo_title = 'Garantía, entrega y formas de pago | Ideas Exteriores'
    assign seo_description = 'Consulta cómo definimos garantía, entrega, recepción, incidencias y pagos en proyectos de madera, con condiciones específicas reflejadas por escrito.'
  endif

  assign og_title = seo_title
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_description

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ seo_title }}
  {%- if request.page_type != 'index' -%}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless seo_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  {%- endif -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if seo_description %}
  <meta
    name="description"
    content="{{ seo_description | escape }}"
  >
{% endif %}
