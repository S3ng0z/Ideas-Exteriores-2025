<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="view-transition"
  content="same-origin"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  assign seo_title = page_title | default: shop.name
  assign seo_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'index'
    assign seo_title = 'Soluciones de madera para exterior y casas | Ideas Exteriores'
    assign seo_description = 'Casas y casetas de madera con entramado ligero, panel SIP y sistema europeo. Pérgolas, porches y cenadores. Compara modelos y solicita presupuesto.'
  endif

  if request.page_type == 'collection' and collection.handle == 'wooden-gazebos'
    assign seo_title = 'Cenadores de madera para jardín y gazebos'
    assign seo_description = 'Compara cenadores y gazebos de madera para jardín por tamaño y precio de partida. Revisa estructura, cubierta, base, anclaje, transporte y montaje.'
  endif

  if request.page_type == 'collection' and collection.handle == 'light-frame-houses'
    assign seo_title = 'Casas de entramado ligero: modelos y precios | Ideas Exteriores'
    assign seo_description = 'Compara casas de entramado ligero de madera por superficie, distribución y precio de partida. Revisa sistema, montaje y alcance antes de pedir presupuesto.'
  endif

  if request.page_type == 'collection' and collection.handle == 'sip-panel-houses'
    assign seo_title = 'Casas con panel SIP: modelos y precios | Ideas Exteriores'
    assign seo_description = 'Compara casas con panel SIP por superficie, distribución y precio de partida. Revisa alcance, montaje y parcela antes de solicitar un presupuesto.'
  endif

  if request.page_type == 'page' and page.handle == 'timber-products'
    assign seo_title = 'Productos de madera: casas, casetas y estructuras'
    assign seo_description = 'Explora casas, casetas, estudios, pérgolas, porches, cenadores y tarimas. Compara familias de producto, sistemas, alcance, montaje y precio de partida.'
  endif

  if request.page_type == 'page' and page.handle == 'european-timber-construction-system'
    assign seo_title = 'Sistema europeo de madera: guía de construcción y montaje'
    assign seo_description = 'Guía del sistema europeo de madera: funcionamiento, componentes, uniones, aislamiento, montaje, acabados y aplicaciones con criterios técnicos para España.'
  endif

  if request.page_type == 'page' and page.handle == 'european-timber-system-how-it-works'
    assign seo_title = 'Sistema europeo de madera: qué es y cómo funciona'
    assign seo_description = 'Guía del sistema europeo de madera: muro exterior perfilado, capa técnica interior, aislamiento, uniones, humedad y criterios de proyecto en España.'
  endif

  if request.page_type == 'page' and page.handle == 'european-timber-system-assembly-finishes'
    assign seo_title = 'Sistema europeo: montaje, durabilidad y acabados'
    assign seo_description = 'Montaje del sistema europeo de madera: base, juntas, movimientos, humedad, capa técnica, acabados, mantenimiento y sostenibilidad verificable.'
  endif

  if request.page_type == 'page' and page.handle == 'european-timber-system-components-joints-materials'
    assign seo_title = 'Sistema europeo: componentes, uniones y materiales'
    assign seo_description = 'Madera perfilada, uniones, anclajes, aislamiento y capas de control: cómo especificar y documentar la sección real del sistema europeo.'
  endif

  if request.page_type == 'page' and page.handle == 'european-timber-system-applications-models'
    assign seo_title = 'Sistema europeo: aplicaciones y modelos compatibles'
    assign seo_description = 'Usos del sistema europeo de madera en viviendas y anexos, criterios de compatibilidad, alcance, proyecto y validación técnica de cada modelo.'
  endif

  if request.page_type == 'page' and page.handle == 'light-frame-construction-system'
    assign seo_title = 'Entramado ligero de madera: sistema, capas y montaje'
    assign seo_description = 'Guía del entramado ligero de madera: funcionamiento, estructura, aislamiento, montaje, durabilidad, aplicaciones y modelos compatibles para proyectos en España.'
  endif

  if request.page_type == 'page' and page.handle == 'what-is-light-timber-frame-construction'
    assign seo_title = 'Entramado ligero de madera: qué es y cómo funciona'
    assign seo_description = 'Guía del entramado ligero de madera: bastidores, tableros, uniones, aislamiento, montaje y criterios de proyecto para viviendas y anexos.'
  endif

  if request.page_type == 'page' and page.handle == 'timber-frame-structure-layers-insulation'
    assign seo_title = 'Entramado ligero: estructura, capas y aislamiento'
    assign seo_description = 'Cómo se compone un cerramiento timber frame: estructura, rigidización, aislamiento, hermeticidad, vapor, agua, puentes térmicos y criterios CTE.'
  endif

  if request.page_type == 'page' and page.handle == 'timber-frame-assembly-durability-sustainability'
    assign seo_title = 'Entramado ligero: montaje, durabilidad y sostenibilidad'
    assign seo_description = 'Montaje timber frame, control de humedad, mantenimiento, vida útil, origen de la madera, carbono biogénico y ciclo de vida sin claims absolutos.'
  endif

  if request.page_type == 'page' and page.handle == 'timber-frame-applications-compatible-models'
    assign seo_title = 'Entramado ligero: aplicaciones y modelos compatibles'
    assign seo_description = 'Aplicaciones del timber frame en viviendas, ampliaciones, oficinas y anexos. Cómo comprobar compatibilidad técnica y pasar del sistema al modelo.'
  endif
  if request.page_type == 'page' and page.handle == 'sip-panels-system'
    assign seo_title = 'Paneles SIP: construcción, aislamiento y montaje'
    assign seo_description = 'Guía de paneles SIP para construcción en madera: funcionamiento, aislamiento, montaje, durabilidad, aplicaciones, modelos y criterios de presupuesto.'
  endif

  if request.page_type == 'page' and page.handle == 'what-are-sip-panels-how-they-work'
    assign seo_title = 'Paneles SIP: qué son y cómo funciona el sistema'
    assign seo_description = 'Guía sobre paneles SIP: composición, funcionamiento estructural, prefabricación, aplicaciones y criterios técnicos para proyectos de madera en España.'
  endif

  if request.page_type == 'page' and page.handle == 'sip-panel-structure-layers-insulation'
    assign seo_title = 'Paneles SIP: estructura, capas y aislamiento'
    assign seo_description = 'Caras, núcleos, espesores, valor U, juntas, hermeticidad, humedad, fuego y acústica: cómo especificar correctamente una envolvente SIP.'
  endif

  if request.page_type == 'page' and page.handle == 'sip-panel-assembly-durability-sustainability'
    assign seo_title = 'Paneles SIP: montaje, durabilidad y sostenibilidad'
    assign seo_description = 'Planificación, fabricación, montaje, control de humedad, mantenimiento y sostenibilidad de sistemas SIP con criterios técnicos y de proyecto.'
  endif

  if request.page_type == 'page' and page.handle == 'sip-panel-applications-compatible-models'
    assign seo_title = 'Paneles SIP: aplicaciones y modelos compatibles'
    assign seo_description = 'Aplicaciones de paneles SIP en viviendas, estudios, oficinas y casetas. Compara modelos, alcance de suministro, prestaciones y criterios de presupuesto.'
  endif


  if request.page_type == 'page' and page.handle == 'timber-construction-systems-comparison'
    assign seo_title = 'Sistemas constructivos de madera: comparativa | IDEAS EXTERIORES'
    assign seo_description = 'Compara sistema europeo, entramado ligero y paneles SIP. Descubre sus diferencias, ventajas y aplicaciones para elegir tu proyecto de madera.'
  endif

  if request.page_type == 'page' and page.handle == 'choose-timber-construction-system'
    assign seo_title = '¿Qué sistema constructivo elegir? | Ideas Exteriores'
    assign seo_description = 'Descubre qué sistema de madera elegir para tu vivienda, caseta, oficina o ampliación. Compara opciones y encuentra modelos para tu proyecto.'
  endif

  if request.page_type == 'page' and page.handle == 'how-to-choose-timber-construction-system'
    assign seo_title = 'Cómo elegir un sistema constructivo de madera | Ideas Exteriores'
    assign seo_description = 'Conoce los criterios para elegir un sistema de construcción en madera: presupuesto, aislamiento, durabilidad, montaje, normativa y mantenimiento.'
  endif

  if request.page_type == 'page' and page.handle == 'light-frame-vs-sip-comparison'
    assign seo_title = 'Comparar y elegir sistemas constructivos | Ideas Exteriores'
    assign seo_description = 'Compara sistema europeo, entramado ligero y paneles SIP. Descubre sus diferencias, qué sistema elegir según tu proyecto y cómo solicitar presupuesto.'
  endif

  if request.page_type == 'page' and page.handle == 'compare-and-choose-timber-systems'
    assign seo_title = 'Comparar y elegir sistemas de madera | Ideas Exteriores'
    assign seo_description = 'Compara sistema europeo, entramado ligero y paneles SIP. Descubre qué sistema estudiar según tu proyecto y las claves antes de solicitar presupuesto.'
  endif

  if request.page_type == 'page' and page.handle == 'wood-maintenance-repair'
    assign seo_title = 'Mantenimiento y reparación de madera exterior'
    assign seo_description = 'Mantenimiento y reparación de madera exterior con diagnóstico previo, saneado, reparación localizada, renovación de protección y plan de mantenimiento.'
  endif

  if request.page_type == 'page' and page.handle == 'wood-treatment-protection'
    assign seo_title = 'Tratamiento y protección de la madera exterior'
    assign seo_description = 'Protección técnica de madera según uso, humedad y exposición: tratamiento preventivo, lasures, aceites, sellado de puntos críticos y mantenimiento.'
  endif

  if request.page_type == 'page' and page.handle == 'wood-3d-design-consulting'
    assign seo_title = 'Diseño 3D en madera y asesoría técnica'
    assign seo_description = 'Diseño 3D y asesoría técnica para definir medidas, distribución, sistema constructivo y alcance antes de presupuestar, fabricar o tramitar el proyecto.'
  endif

  if request.page_type == 'page' and page.handle == 'timber-structure-installation'
    assign seo_title = 'Montaje profesional de estructuras de madera'
    assign seo_description = 'Montaje profesional de estructuras de madera con base, accesos, logística, medios auxiliares, secuencia de ejecución e incluidos definidos antes de obra.'
  endif

  if request.page_type == 'page' and page.handle == 'timber-bases-and-foundations'
    assign seo_title = 'Bases y cimentaciones para estructuras de madera'
    assign seo_description = 'Compara losas, zapatas, cimentaciones prefabricadas, pilotes y bases de poste para casas, casetas y estructuras de madera según terreno y cargas.'
  endif

  if request.page_type == 'page' and page.handle == 'project-management-permits'
    assign seo_title = 'Gestión de proyectos y licencias para construcciones de madera'
    assign seo_description = 'Viabilidad urbanística, proyecto técnico y apoyo en licencias para construcciones de madera, con alcance y documentación adaptados al municipio y al proyecto.'
  endif

  if request.page_type == 'page' and page.handle == 'warranty-delivery-payment-options'
    assign seo_title = 'Garantía, entrega y formas de pago | Ideas Exteriores'
    assign seo_description = 'Consulta cómo definimos garantía, entrega, recepción, incidencias y pagos en proyectos de madera, con condiciones específicas reflejadas por escrito.'
  endif

  if request.page_type == 'page' and page.handle == 'transporte-entrega-casas-casetas-madera'
    assign seo_title = 'Transporte y entrega de casas y casetas de madera | Ideas Exteriores'
    assign seo_description = 'Transporte de casas, casetas, kits y paneles de madera: logística, accesos y recepción. Descarga, grúa y montaje opcionales con presupuesto previo.'
  endif

  assign og_title = seo_title
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_description

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url | escape }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ seo_title | escape }}
  {%- if request.page_type != 'index' -%}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless seo_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  {%- endif -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url | escape }}"
>

{% if seo_description %}
  <meta
    name="description"
    content="{{ seo_description | escape }}"
  >
{% endif %}
